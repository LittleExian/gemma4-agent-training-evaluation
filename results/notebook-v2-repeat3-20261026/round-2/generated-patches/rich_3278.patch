diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..08b826d7
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,10 @@
+from rich.ansi import AnsiDecoder
+
+decoder = AnsiDecoder()
+text = "Hello\x1b7World\x1b8!"
+decoded = decoder.decode_line(text)
+print(f"Input: {repr(text)}")
+print(f"Decoded: {repr(decoded)}")
+# If \x1b7 and \x1b8 are not stripped, they will appear in the decoded text.
+# But since they are not matched by the regex, they are treated as plain text.
+# So decoded will contain them.
diff --git a/rich/ansi.py b/rich/ansi.py
index 66365e65..d90c1a45 100644
--- a/rich/ansi.py
+++ b/rich/ansi.py
@@ -10,7 +10,7 @@ from .text import Text
 re_ansi = re.compile(
     r"""
 (?:\x1b\](.*?)\x1b\\)|
-(?:\x1b([(@-Z\\-_]|\[[0-?]*[ -/]*[@-~]))
+(?:\x1b([0-?@-Z\\-_]|\[[0-?]*[ -/]*[@-~]))
 """,
     re.VERBOSE,
 )

new file mode 100644
index 00000000..af7835af
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,28 @@
+from rich.text import Text, Span
+import time
+
+def test_infinite_loop():
+    t = Text("a", spans=[Span(0, 1, "red")])
+    print("Appending t to t...")
+    start = time.time()
+    t.append(t)
+    end = time.time()
+    print(f"Done in {end - start:.4f}s")
+    print(f"t.plain: {t.plain}")
+    print(f"t._spans: {t._spans}")
+    print(f"t._length: {t._length}")
+
+def test_infinite_loop_with_style():
+    t = Text("a", style="red", spans=[Span(0, 1, "blue")])
+    print("Appending t to t with style...")
+    start = time.time()
+    t.append(t)
+    end = time.time()
+    print(f"Done in {end - start:.4f}s")
+    print(f"t.plain: {t.plain}")
+    print(f"t._spans: {t._spans}")
+    print(f"t._length: {t._length}")
+
+if __name__ == "__main__":
+    test_infinite_loop()
+    test_infinite_loop_with_style()

+def merge_security_definitions(
+    existing: Dict[str, Any], new: Dict[str, Any]
+) -> None:
+    for name, definition in new.items():
+        if name in existing:
+            existing_definition = existing[name]
+            if (
+                existing_definition.get("type") == "oauth2"
+                and definition.get("type") == "oauth2"
+            ):
+                existing_flows = existing_definition.get("flows", {})
+                new_flows = definition.get("flows", {})
+                for flow_type, flow_details in new_flows.items():
+                    if flow_type in existing_flows:
+                        existing_flow = existing_flows[flow_type]
+                        if "scopes" in existing_flow and "scopes" in flow_details:
+                            existing_flow["scopes"].update(flow_details["scopes"])
+                    else:
+                        existing_flows[flow_type] = flow_details
+            else:
+                existing[name] = definition
+        else:
+            existing[name] = definition
+

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..e48d8221
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,24 @@
+from rich.console import Console
+
+def test_record_capture():
+    console = Console(record=True)
+    with console.capture() as capture:
+        console.print("Hello World")
+    
+    captured = capture.get()
+    recorded = console.export_text()
+    
+    print(f"Captured: {repr(captured)}")
+    print(f"Recorded: {repr(recorded)}")
+    
+    assert captured.strip() == "Hello World"
+    assert recorded.strip() == "Hello World"
+
+if __name__ == "__main__":
+    try:
+        test_record_capture()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
diff --git a/repro_nested.py b/repro_nested.py
new file mode 100644
index 00000000..42fff8e7
--- /dev/null
+++ b/repro_nested.py
@@ -0,0 +1,22 @@
+from rich.console import Console
+
+def test_nested_record():
+    console = Console(record=True)
+    with console:
+        with console:
+            console.print("hello")
+    
+    recorded = console.export_text()
+    print(f"Recorded: {repr(recorded)}")
+    
+    # Should be "hello\n", but might be "hello\nhello\nhello\n"
+    assert recorded == "hello\n"
+
+if __name__ == "__main__":
+    try:
+        test_nested_record()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")

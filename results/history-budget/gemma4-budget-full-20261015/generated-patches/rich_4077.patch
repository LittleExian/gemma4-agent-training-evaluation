@@ -0,0 +1,40 @@
+
+import io
+from rich.console import Console
+from rich.file_proxy import FileProxy
+
+class MockFile:
+    def write(self, text):
+        pass
+    def flush(self):
+        pass
+
+def test_isatty_proxy():
+    # Case 1: File has isatty
+    class FileWithIsatty:
+        def isatty(self):
+            return True
+        def write(self, text):
+            pass
+        def flush(self):
+            pass
+
+    file_with_isatty = FileWithIsatty()
+    console = Console(file=file_with_isatty)
+    print(f"Direct is_terminal: {console.is_terminal}") # Should be True
+
+    proxy = FileProxy(console, file_with_isatty)
+    console.file = proxy
+    print(f"Proxied is_terminal (with isatty): {console.is_terminal}") # Should be True
+
+    # Case 2: File does NOT have isatty
+    file_without_isatty = MockFile()
+    console = Console(file=file_without_isatty)
+    print(f"Direct is_terminal: {console.is_terminal}") # Should be False
+
+    proxy = FileProxy(console, file_without_isatty)
+    console.file = proxy
+    print(f"Proxied is_terminal (without isatty): {console.is_terminal}") # Should be False
+
+if __name__ == '__main__':
+    test_isatty_proxy()

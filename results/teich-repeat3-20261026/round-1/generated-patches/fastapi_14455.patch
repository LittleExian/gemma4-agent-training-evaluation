+def merge_security_definitions(
+    existing_definitions: Dict[str, Any],
+    new_definitions: Dict[str, Any],
+) -> None:
+    for security_name, security_definition in new_definitions.items():
+        if security_name in existing_definitions:
+            existing_definition = existing_definitions[security_name]
+            if (
+                existing_definition.get("type") == "oauth2"
+                and security_definition.get("type") == "oauth2"
+            ):
+                existing_flows = existing_definition.get("flows", {})
+                new_flows = security_definition.get("flows", {})
+                for flow_name, flow_data in new_flows.items():
+                    if flow_name in existing_flows:
+                        existing_scopes = existing_flows[flow_name].get("scopes", {})
+                        new_scopes = flow_data.get("scopes", {})
+                        existing_flows[flow_name]["scopes"] = {**existing_scopes, **new_scopes}
+                    else:
+                        existing_flows[flow_name] = flow_data
+                existing_definition["flows"] = existing_flows
+            else:
+                existing_definitions[security_name] = security_definition
+        else:
+            existing_definitions[security_name] = security_definition
+

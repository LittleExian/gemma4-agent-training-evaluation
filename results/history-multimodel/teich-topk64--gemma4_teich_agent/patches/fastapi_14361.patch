--- /dev/null
+++ b/repro.py
@@ -0,0 +1,47 @@
+from fastapi._compat.v2 import _remap_definitions_and_field_mappings, ModelField
+from pydantic.fields import FieldInfo
+from typing import Any, Dict, Tuple, Literal
+from pydantic import BaseModel
+
+class MyModel(BaseModel):
+    x: int
+
+# Mock ModelField
+class MockModelField:
+    def __init__(self, type_, name):
+        self.type_ = type_
+        self.name = name
+        self.mode = "validation"
+
+# We need to match the signature of ModelField if it's used for type checking, 
+# but _remap_definitions_and_field_mappings uses field_key[0].type_
+
+# Let's use the real ModelField if possible, but it requires FieldInfo
+# ModelField is a dataclass in fastapi/_compat/v2.py
+
+# Let's just use a dummy object that has .type_
+class DummyField:
+    def __init__(self, type_):
+        self.type_ = type_
+
+# Mock field_mapping
+# field_mapping: Dict[Tuple[ModelField, Literal["validation", "serialization"]], JsonSchemaValue]
+field_mapping = {
+    (DummyField(MyModel), "validation"): {"type": "object", "properties": {}}, # No $ref
+}
+
+model_name_map = {
+    MyModel: "MyModelNewName"
+}
+
+try:
+    _remap_definitions_and_field_mappings(
+        model_name_map=model_name_map,
+        definitions={},
+        field_mapping=field_mapping,
+    )
+    print("Success")
+except KeyError as e:
+    print(f"Caught expected KeyError: {e}")
+except Exception as e:
+    print(f"Caught unexpected exception: {type(e).__name__}: {e}")

@@ -0,0 +1,38 @@
+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import List
+from pydantic.fields import FieldInfo
+from fastapi._compat.v2 import is_sequence_field
+from fastapi._compat.shared import field_annotation_is_sequence
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Json[List[str]] = Form()):
+    return data
+
+# Let's find the field info for 'data'
+# We can get it from the endpoint's dependencies
+endpoint = app.router.routes[0].endpoint
+# The dependencies are in endpoint.dependencies
+# But wait, the parameters are in endpoint.__defaults__ or something.
+# Actually, FastAPI stores them in the endpoint's function signature.
+
+import inspect
+sig = inspect.signature(endpoint)
+# But FastAPI's dependency injection happens at runtime.
+
+# Let's just use a dummy FieldInfo and see what happens.
+# In Pydantic v2, when we have `data: Json[List[str]] = Form()`,
+# the annotation is `Json[List[str]]`.
+
+annotation = Json[List[str]]
+print(f"Annotation: {annotation}")
+print(f"field_annotation_is_sequence(annotation): {field_annotation_is_sequence(annotation)}")
+
+# Let's see what Pydantic v2 does with it.
+from pydantic import create_model
+Model = create_model("Model", data=(Json[List[str]], ...))
+field = Model.model_fields["data"]
+print(f"Field annotation: {field.annotation}")
+print(f"is_sequence_field(field): {is_sequence_field(field)}")

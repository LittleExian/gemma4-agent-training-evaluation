@@ -0,0 +1,13 @@
+from rich._wrap import divide_line
+from rich.text import Text
+
+text = "abcde"
+width = 3
+start = 0
+divides = divide_line(text, width, fold=True, start=start)
+print(f"Text: {text}, Width: {width}, Divides: {divides}")
+
+t = Text(text)
+lines = t.divide(divides)
+for i, line in enumerate(lines):
+    print(f"Line {i}: {line.plain}")

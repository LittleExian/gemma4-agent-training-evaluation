diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..6f05a085
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Query
+from pydantic import BaseModel, Field
+from pydantic.fields import FieldInfo
+from fastapi.params import Query as FastAPIQuery
+
+def test_alias_override():
+    # Case 1: Only alias is provided
+    # In Pydantic v2, if validation_alias is None, it might override alias.
+    # If validation_alias is Undefined, it should not.
+    
+    # We can test this by creating a FieldInfo directly or using FastAPI's Query.
+    
+    # Let's use FastAPI's Query.
+    q = FastAPIQuery(alias="my_alias")
+    
+    # The FieldInfo is created when the model is built or when we use it in a model.
+    # But we can check the attributes of the Query object.
+    
+    print(f"Query alias: {q.alias}")
+    print(f"Query validation_alias: {q.validation_alias}")
+    print(f"Query serialization_alias: {q.serialization_alias}")
+    
+    # Now let's see how Pydantic handles it.
+    class Model(BaseModel):
+        q: str = Field(alias="my_alias", validation_alias=q.validation_alias, serialization_alias=q.serialization_alias)
+    
+    # If validation_alias was None, Pydantic might use it instead of alias.
+    # Let's check the FieldInfo of the model.
+    field_info = Model.model_fields['q']
+    print(f"Model field validation_alias: {field_info.validation_alias}")
+    print(f"Model field serialization_alias: {field_info.serialization_alias}")
+    print(f"Model field alias: {field_info.alias}")
+    
+    # Test validation
+    try:
+        m = Model.model_validate({"my_alias": "value"})
+        print("Validation with alias succeeded")
+    except Exception as e:
+        print(f"Validation with alias failed: {e}")
+        
+    # Test serialization
+    m = Model(q="value")
+    dump = m.model_dump(by_alias=True)
+    print(f"Serialization dump: {dump}")
+    if dump.get("my_alias") == "value":
+        print("Serialization with alias succeeded")
+    else:
+        print(f"Serialization with alias failed: {dump}")
+
+if __name__ == "__main__":
+    test_alias_override()

+
+def test_graphemes():
+    # Family emoji: 👨‍👩‍👧‍👦 (Man + ZWJ + Woman + ZWJ + Girl + ZWJ + Boy)
+    # This is 7 codepoints but 1 grapheme cluster.
+    # Width is 2.
+    text = "👨‍👩‍👧‍👦"
+    print(f"Text: {text}")
+    print(f"Len (codepoints): {len(text)}")
+    

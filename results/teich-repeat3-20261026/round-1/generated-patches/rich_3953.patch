new file mode 100644
index 00000000..75441767
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,18 @@
+from rich.cells import cell_len
+
+def test_cell_len(text, expected):
+    actual = cell_len(text)
+    print(f"text={text!r}, expected={expected}, actual={actual}, {'OK' if actual == expected else 'FAIL'}")
+
+# ZWJ is \u200d
+# A character with width 0: \u0300 (Combining Grave Accent)
+# A character with width 1: A
+# A character with width 2: 👨 (U+1F468)
+
+print("Testing ZWJ sequences:")
+test_cell_len("A\u200dB", 1) # A (1) + ZWJ + B (1) -> 1
+test_cell_len("👨\u200d👩", 2) # 👨 (2) + ZWJ + 👩 (2) -> 2
+test_cell_len("\u0300\u200dB", 1) # \u0300 (0) + ZWJ + B (1) -> 1?
+test_cell_len("A\u200d\u0300", 1) # A (1) + ZWJ + \u0300 (0) -> 1
+test_cell_len("A\u200d\u200dB", 2) # A (1) + ZWJ + ZWJ + B (1) -> 2?
+test_cell_len("A\u200dB\u200dC", 1) # A (1) + ZWJ + B (1) + ZWJ + C (1) -> 1

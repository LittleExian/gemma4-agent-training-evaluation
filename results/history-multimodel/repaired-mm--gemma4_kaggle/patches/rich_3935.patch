+++ b/repro_fix_debug.py
@@ -0,0 +1,9 @@
+from rich.console import Console
+from rich.padding import Padding
+
+console = Console(width=10, force_terminal=False)
+padding = Padding("H", (0, 6, 0, 6), expand=True)
+
+# Use render to get the segments
+segments = console.render(padding)
+print(list(segments))

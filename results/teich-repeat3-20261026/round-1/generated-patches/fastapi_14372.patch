@@ -0,0 +1,23 @@
+from fastapi.params import Depends, Security
+
+def test_depends_hashable():
+    d1 = Depends(dependency=lambda x: x)
+    d2 = Depends(dependency=lambda x: x)
+    # Note: lambda functions are not equal, but we just want to see if they are hashable
+    try:
+        hash(d1)
+        print("Depends is hashable")
+    except TypeError as e:
+        print(f"Depends is not hashable: {e}")
+
+def test_security_hashable():
+    s1 = Security(scopes=["admin"])
+    try:
+        hash(s1)
+        print("Security is hashable")
+    except TypeError as e:
+        print(f"Security is not hashable: {e}")
+
+if __name__ == "__main__":
+    test_depends_hashable()
+    test_security_hashable()

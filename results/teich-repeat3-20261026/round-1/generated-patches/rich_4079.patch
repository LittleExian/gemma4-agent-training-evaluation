+++ b/repro_spans.py
@@ -0,0 +1,25 @@
+from rich.markdown import Markdown
+from rich.console import Console
+from rich.text import Text
+
+md = Markdown("`print(\"hello\")`")
+console = Console(record=True)
+console.print(md)
+
+# Find the Text object that was rendered
+for renderable in console._record_buffer:
+    # This is not quite right, record_buffer contains segments.
+    pass
+
+# Let's just use Markdown.render
+# Wait, Markdown is a renderable, it has __rich_console__
+# Let's just call it.
+from rich.console import ConsoleOptions
+options = console.options
+results = list(md.__rich_console__(console, options))
+for res in results:
+    if isinstance(res, Text):
+        print(f"Text spans: {res._spans}")
+        print(f"Text style: {res.style}")
+    else:
+        print(f"Other: {type(res)}, Text: {res.text}, Style: {res.style}")
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..5304c12c
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,11 @@
+from rich.console import Console
+from rich.markdown import Markdown
+
+console = Console(record=True, width=100)
+markdown_text = "`print(\"hello\")`"
+markdown = Markdown(markdown_text)
+console.print(markdown)
+
+for segment in console._record_buffer:
+    if "print" in segment.text or "hello" in segment.text:
+        print(f"Text: {segment.text}, Style: {segment.style}")

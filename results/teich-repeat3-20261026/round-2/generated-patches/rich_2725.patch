@@ -0,0 +1,66 @@
+from rich.console import Console
+from rich.table import Table
+from rich.box import Box
+
+class CustomBox(Box):
+    def __init__(self):
+        # top
+        # head
+        # head_row
+        # mid
+        # row
+        # foot_row
+        # foot
+        # bottom
+        box = (
+            "TTTT\n"
+            "H H\n"
+            "HHH\n"
+            "M M\n"
+            "RRR\n"
+            "FFF\n"
+            "F F\n"
+            "BBBB"
+        )
+        # Wait, I need 4 characters per line.
+        box = (
+            "TTTT\n"
+            "H H \n"
+            "HHH \n"
+            "M M \n"
+            "RRR \n"
+            "FFF \n"
+            "F F \n"
+            "BBBB"
+        )
+        # Actually, let's just use 4 characters.
+        box = (
+            "1111\n"
+            "2 22\n"
+            "3333\n"
+            "4 44\n"
+            "5555\n"
+            "6666\n"
+            "7 77\n"
+            "8888"
+        )
+        # 1: top
+        # 2: head
+        # 3: head_row
+        # 4: mid
+        # 5: row
+        # 6: foot_row
+        # 7: foot
+        # 8: bottom
+        super().__init__(box)
+
+console = Console(record=True)
+table = Table(box=CustomBox())
+table.add_column("A")
+table.add_row("Body")
+table.footer = "Footer"
+table.show_footer = True
+
+console.print(table)
+output = console.export_text()
+print(output)

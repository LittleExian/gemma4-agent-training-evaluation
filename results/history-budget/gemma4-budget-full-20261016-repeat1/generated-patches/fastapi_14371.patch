diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..531717ae
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,26 @@
+from pydantic import BaseModel, Field
+from pydantic import AliasPriority
+from pydantic_core import PydanticUndefined
+from typing import Optional
+
+def test_alias_priority():
+    # Case 1: alias and validation_alias, default priority
+    class Model1(BaseModel):
+        x: int = Field(alias="my_alias", validation_alias="val_alias")
+    print(f"Case 1 (val_alias): {Model1.model_validate({'val_alias': 1})}")
+    try:
+        print(f"Case 1 (my_alias): {Model1.model_validate({'my_alias': 1})}")
+    except Exception as e:
+        print(f"Case 1 (my_alias) Error: {e}")
+
+    # Case 2: alias and validation_alias, prefer_alias priority
+    class Model2(BaseModel):
+        x: int = Field(alias="my_alias", validation_alias="val_alias", alias_priority=AliasPriority.prefer_alias)
+    print(f"Case 2 (my_alias): {Model2.model_validate({'my_alias': 1})}")
+    try:
+        print(f"Case 2 (val_alias): {Model2.model_validate({'val_alias': 1})}")
+    except Exception as e:
+        print(f"Case 2 (val_alias) Error: {e}")
+
+if __name__ == "__main__":
+    test_alias_priority()

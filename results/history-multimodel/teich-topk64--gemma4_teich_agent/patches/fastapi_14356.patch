@@ -0,0 +1,42 @@
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+
+class Model(BaseModel):
+    param: str
+
+    model_config = {"extra": "allow"}
+
+
+@app.get("/")
+async def model_with_extra(data: Model = Query()):
+    return data
+
+
+def test_pass_extra_list():
+    client = TestClient(app)
+    resp = client.get(
+        "/",
+        params={
+            "param": "123",
+            "param2": ["456", "789"],  # Pass a list of values as extra parameter
+        },
+    )
+    print(f"Response JSON: {resp.json()}")
+    assert resp.status_code == 200
+    assert resp.json() == {
+        "param": "123",
+        "param2": ["456", "789"],
+    }
+
+if __name__ == "__main__":
+    try:
+        test_pass_extra_list()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
diff --git a/reproduction_script.py b/reproduction_script.py
new file mode 100644
index 00000000..07c4deff
--- /dev/null
+++ b/reproduction_script.py
@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Query, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, ConfigDict
+
+app = FastAPI()
+
+class ExtraModel(BaseModel):
+    model_config = ConfigDict(extra="allow")
+    name: str
+
+from httpx import Headers
+
+@app.get("/test")
+async def test_endpoint(params: ExtraModel = Query()):
+    return params
+
+@app.get("/test-header")
+async def test_header_endpoint(params: ExtraModel = Header()):
+    return params
+
+client = TestClient(app)
+
+def test_extra_params_multiple_values():
+    # param2 is an extra parameter, provided twice
+    response = client.get("/test?name=foo&param2=1&param2=2")
+    data = response.json()
+    assert data["param2"] == ["1", "2"], f"Expected ['1', '2'], got {data.get('param2')}"
+    print("Test extra params passed!")
+
+def test_extra_headers_multiple_values():
+    # Use httpx.Headers to allow multiple headers with the same name
+    headers = Headers([("name", "foo"), ("param2", "1"), ("param2", "2")])
+    response = client.get("/test-header", headers=headers)
+    data = response.json()
+    print(f"Headers data: {data}")
+    assert data["param2"] == ["1", "2"], f"Expected ['1', '2'], got {data.get('param2')}"
+    print("Test extra headers passed!")
+
+if __name__ == "__main__":
+    try:
+        test_extra_params_multiple_values()
+        test_extra_headers_multiple_values()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An unexpected error occurred: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

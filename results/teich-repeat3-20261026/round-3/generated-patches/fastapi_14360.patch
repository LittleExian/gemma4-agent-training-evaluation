@@ -0,0 +1,29 @@
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field, ConfigDict
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    q_alias: str = Field(..., alias="q")
+
+@app.get("/")
+async def root(q_model: QueryModel = Query(...)):
+    return q_model
+
+client = TestClient(app)
+
+def test_extra_params():
+    # Pass both alias 'q' and field name 'q_alias'
+    # 'q' should be used for validation, 'q_alias' should be an extra param
+    # Since extra='forbid', this should fail with 422
+    response = client.get("/?q=value&q_alias=extra")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 422
+    # Check that 'q_alias' is reported as an extra parameter
+    errors = response.json()["detail"]
+    assert any(err["type"] == "extra_forbidden" and err["loc"] == ["q_model", "q_alias"] for err in errors)
+
+if __name__ == "__main__":
+    test_extra_params()

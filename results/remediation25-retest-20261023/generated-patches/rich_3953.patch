@@ -0,0 +1,13 @@
+from rich.cells import _cell_len
+
+# ZWJ is \u200d
+# Test 1: Simple characters with ZWJ
+# 'A' (1) + ZWJ (0) + 'B' (1) = 2
+text1 = "A\u200dB"
+print(f"Text 1: {text1!r}, Expected: 2, Got: {_cell_len(text1, 'auto')}")
+
+# Test 2: Emoji with ZWJ
+# 👨 (2) + ZWJ (0) + 👩 (2) = 4 (usually, depending on terminal)
+# But rich should at least not skip the second emoji.
+text2 = "\U0001F468\u200d\U0001F469"
+print(f"Text 2: {text2!r}, Expected: 4, Got: {_cell_len(text2, 'auto')}")

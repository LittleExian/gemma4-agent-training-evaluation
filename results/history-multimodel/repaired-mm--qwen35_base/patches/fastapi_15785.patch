+    def iter_route_contexts(self) -> Iterator[_EffectiveRouteContext | None]:
+        """
+        Iterate over the route contexts of all routes in this router.
+
+        This method provides access to the route context information for each
+        route, which is useful for advanced use cases like generating custom
+        documentation or introspecting the router's structure.
+
+        Yields:
+            _EffectiveRouteContext | None: The route context for each route,
+                or None for routes that don't have a context.
+
+        Example:
+            ```python
+            from fastapi import APIRouter, FastAPI
+
+            app = FastAPI()
+            router = APIRouter()
+
+            @router.get("/items/")
+            def read_items():
+                return []
+
+            app.include_router(router)
+
+            for route_context in router.iter_route_contexts():
+                if route_context is not None:
+                    print(f"Route: {route_context.path}, Name: {route_context.name}")
+            ```
+        """
+        for route, route_context in _iter_routes_with_context(self.routes):
+            yield route_context

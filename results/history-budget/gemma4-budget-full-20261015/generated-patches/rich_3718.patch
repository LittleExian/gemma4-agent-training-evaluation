@@ -0,0 +1,9 @@
+from rich.console import Console
+from rich.panel import Panel
+from rich.segment import Segment
+
+console = Console()
+panel = Panel("Hello", style="on blue", title="Title")
+segments = console.render(panel)
+for segment in segments:
+    print(f"Text: {segment.text}, Style: {segment.style}")

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..53f19980
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+call_count = 0
+
+def dep_d():
+    global call_count
+    call_count += 1
+    return "d"
+
+def dep_a(d = Depends(dep_d, scope="function")):
+    return d
+
+def dep_b(d = Depends(dep_d, scope="function")):
+    return d
+
+@app.get("/", dependencies=[Depends(dep_a), Depends(dep_b)])
+def root():
+    return {"message": "Hello World"}
+
+client = TestClient(app)
+call_count = 0
+client.get("/")
+print(f"Call count: {call_count}")
+assert call_count == 2

--- /dev/null
+++ b/repro.py
@@ -0,0 +1,46 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+def create_app(scope):
+    app = FastAPI()
+    call_count = 0
+
+    def dep1():
+        nonlocal call_count
+        call_count += 1
+        return 1
+
+    @app.get("/", dependencies=[Depends(dep1, scope=scope), Depends(dep1, scope=scope)])
+    async def root():
+        return {"message": "Hello World"}
+
+    return app, lambda: call_count
+
+def test_scope_function():
+    app, get_count = create_app("function")
+    client = TestClient(app)
+    client.get("/")
+    count = get_count()
+    print(f"scope='function': count={count}")
+    assert count == 2
+
+def test_scope_request():
+    app, get_count = create_app("request")
+    client = TestClient(app)
+    client.get("/")
+    count = get_count()
+    print(f"scope='request': count={count}")
+    assert count == 1
+
+if __name__ == "__main__":
+    try:
+        test_scope_function()
+        print("test_scope_function passed")
+    except Exception as e:
+        print(f"test_scope_function failed: {e}")
+
+    try:
+        test_scope_request()
+        print("test_scope_request passed")
+    except Exception as e:
+        print(f"test_scope_request failed: {e}")

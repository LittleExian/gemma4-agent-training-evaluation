+def split_graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    graphemes = []
+    if not text:
+        return graphemes
+
+    current_grapheme = [text[0]]
+    for char in text[1:]:
+        if (
+            unicodedata.category(char).startswith("M")
+            or char == "\u200d"
+            or (
+                "\u1f1e6" <= char <= "\u1f1ff"
+                and len(current_grapheme) == 1
+                and "\u1f1e6" <= current_grapheme[0] <= "\u1f1ff"
+            )
+        ):
+            current_grapheme.append(char)
+        else:
+            graphemes.append("".join(current_grapheme))
+            current_grapheme = [char]
+    graphemes.append("".join(current_grapheme))
+    return graphemes
+

diff --git a/verify_styles.py b/verify_styles.py
new file mode 100644
index 00000000..0a1def3b
--- /dev/null
+++ b/verify_styles.py
@@ -0,0 +1,18 @@
+from rich.markdown import Markdown
+from rich.console import Console
+
+markdown_text = """
+| Header 1 | Header 2 |
+| --- | --- |
+| **Bold** and normal | Normal and **bold** |
+"""
+
+console = Console(record=True)
+console.print(Markdown(markdown_text))
+
+html_output = console.export_html()
+print(f"HTML Output:\n{html_output}")
+
+assert "<strong>Bold</strong>" in html_output
+assert "<strong>bold</strong>" in html_output
+print("Verification successful!")

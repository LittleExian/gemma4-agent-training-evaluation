--- /dev/null
+++ b/repro.py
@@ -0,0 +1,33 @@
+from fastapi.encoders import jsonable_encoder
+from fastapi._compat import _model_dump
+from pydantic import BaseModel, ConfigDict
+
+class ArbitraryType:
+    __slots__ = ("name",)
+    def __init__(self, name):
+        self.name = name
+
+class Model(BaseModel):
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+    foo: ArbitraryType
+
+arb = ArbitraryType("test")
+model = Model(foo=arb)
+
+print("Testing _model_dump(mode='json'):")
+try:
+    print(_model_dump(model, mode="json"))
+except Exception as e:
+    print(f"Caught exception: {e}")
+
+print("\nTesting _model_dump(mode='python'):")
+try:
+    print(_model_dump(model, mode="python"))
+except Exception as e:
+    print(f"Caught exception: {e}")
+
+print("\nTesting jsonable_encoder(model):")
+try:
+    print(jsonable_encoder(model))
+except Exception as e:
+    print(f"Caught exception: {e}")

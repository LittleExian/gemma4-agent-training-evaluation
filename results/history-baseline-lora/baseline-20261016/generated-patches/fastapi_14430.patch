@@ -0,0 +1,40 @@
+from typing import List, Optional, Sequence, Union, Annotated
+from fastapi._compat import shared
+import sys
+
+def test():
+    test_cases = [
+        (List[int], True),
+        (list, True),
+        (Optional[List[int]], True),
+        (Union[List[int], None], True),
+        (list[int] if sys.version_info >= (3, 9) else List[int], True),
+        (list[int] | None if sys.version_info >= (3, 10) else Optional[List[int]], True),
+        (list[int] | list[str] if sys.version_info >= (3, 10) else Union[List[int], List[str]], True),
+        (Annotated[List[int], "foo"], True),
+        (Annotated[list[int] | None, "foo"] if sys.version_info >= (3, 10) else Annotated[Optional[List[int]], "foo"], True),
+    ]
+
+    for annotation, expected in test_cases:
+        result = shared.field_annotation_is_sequence(annotation)
+        print(f"field_annotation_is_sequence({annotation}): {result} (expected {expected})")
+        if result != expected:
+            print("FAILED")
+
+    test_cases_scalar = [
+        (List[int], True),
+        (Optional[List[int]], True),
+        (list[int] | None if sys.version_info >= (3, 10) else Optional[List[int]], True),
+        (List[int] | List[str] if sys.version_info >= (3, 10) else Union[List[int], List[str]], True),
+        (Annotated[List[int], "foo"], True),
+        (Annotated[list[int] | None, "foo"] if sys.version_info >= (3, 10) else Annotated[Optional[List[int]], "foo"], True),
+    ]
+
+    for annotation, expected in test_cases_scalar:
+        result = shared.field_annotation_is_scalar_sequence(annotation)
+        print(f"field_annotation_is_scalar_sequence({annotation}): {result} (expected {expected})")
+        if result != expected:
+            print("FAILED")
+
+if __name__ == '__main__':
+    test()

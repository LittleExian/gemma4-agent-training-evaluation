diff --git a/scripts/release.py b/scripts/release.py
new file mode 100644
index 000000000..cad82a15f
--- /dev/null
+++ b/scripts/release.py
@@ -0,0 +1,43 @@
+import argparse
+import re
+from pathlib import Path
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("version", help="The new version to set")
+    args = parser.parse_args()
+    version = args.version
+
+    # Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated {init_file} to version {version}")
+
+    # Update docs/en/docs/release-notes.md
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    if not release_notes_file.exists():
+        print(f"Warning: {release_notes_file} not found, skipping.")
+        return
+
+    content = release_notes_file.read_text()
+    
+    # Find the first version header (e.g., ## 0.136.3)
+    match = re.search(r'## \d+\.\d+\.\d+', content)
+    if match:
+        start = match.start()
+        # Insert the new version header before the first version header.
+        # We add a newline before it to ensure it's on its own line.
+        new_header = f"\n## {version}\n"
+        content = content[:start] + new_header + content[start:]
+        release_notes_file.write_text(content)
+        print(f"Added version {version} to {release_notes_file}")
+    else:
+        # If no version header is found, just append it to the end.
+        content += f"\n\n## {version}\n"
+        release_notes_file.write_text(content)
+        print(f"Added version {version} to the end of {release_notes_file}")
+
+if __name__ == "__main__":
+    main()

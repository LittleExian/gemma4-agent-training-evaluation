diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..fc56c2c0
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,56 @@
+import asyncio
+from fastapi import FastAPI, Body, HTTPException
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+
+@app.post("/strict")
+async def strict_endpoint(item: Item = Body(..., strict_content_type=True)):
+    return {"item": item}
+
+@app.post("/non-strict")
+async def non_strict_endpoint(item: Item = Body(..., strict_content_type=False)):
+    return {"item": item}
+
+client = TestClient(app)
+
+def test_strict_no_content_type():
+    response = client.post("/strict", content='{"name": "test"}', headers={})
+    assert response.status_code == 415
+    print("test_strict_no_content_type passed")
+
+def test_strict_wrong_content_type():
+    response = client.post("/strict", content='{"name": "test"}', headers={"content-type": "text/plain"})
+    assert response.status_code == 415
+    print("test_strict_wrong_content_type passed")
+
+def test_strict_correct_content_type():
+    response = client.post("/strict", content='{"name": "test"}', headers={"content-type": "application/json"})
+    assert response.status_code == 200
+    print("test_strict_correct_content_type passed")
+
+def test_non_strict_no_content_type():
+    response = client.post("/non-strict", content='{"name": "test"}', headers={})
+    assert response.status_code == 200
+    print("test_non_strict_no_content_type passed")
+
+def test_non_strict_wrong_content_type():
+    response = client.post("/non-strict", content='{"name": "test"}', headers={"content-type": "text/plain"})
+    assert response.status_code == 200
+    print("test_non_strict_wrong_content_type passed")
+
+if __name__ == "__main__":
+    try:
+        test_strict_no_content_type()
+        test_strict_wrong_content_type()
+        test_strict_correct_content_type()
+        test_non_strict_no_content_type()
+        test_non_strict_wrong_content_type()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

new file mode 100644
index 00000000..bbf69f80
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,17 @@
+from fastapi import FastAPI
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+
+async def test_startup():
+    app = FastAPI(on_startup=[s_start])
+    
+    # We need to trigger the lifespan
+    # In a real app, this happens when the server starts.
+    # We can manually trigger it using the lifespan context manager.
+    async with app.lifespan_context:
+        pass
+
+if __name__ == "__main__":
+    asyncio.run(test_startup())

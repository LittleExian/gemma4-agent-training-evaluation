@@ -0,0 +1,21 @@
+from rich.cells import split_graphemes
+
+def test_infinite_loop():
+    print("Testing with \\ufe0f")
+    try:
+        split_graphemes("\ufe0f")
+        print("Success")
+    except Exception as e:
+        print(f"Failed: {e}")
+
+def test_zwj():
+    print("Testing with \\u200d")
+    try:
+        split_graphemes("\u200d")
+        print("Success")
+    except Exception as e:
+        print(f"Failed: {e}")
+
+if __name__ == "__main__":
+    test_infinite_loop()
+    test_zwj()

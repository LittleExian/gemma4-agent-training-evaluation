+from fastapi import FastAPI, Query
+from typing import List, Optional, Sequence, Union
+from fastapi.testclient import TestClient
+import typing
+
+app = FastAPI()
+
+@app.get("/test1")
+def test1(q: List[int] | None = Query(None)):
+    return q
+
+@app.get("/test2")
+def test2(q: Sequence[int] | None = Query(None)):
+    return q
+
+@app.get("/test3")
+def test3(q: list[int] | None = Query(None)):
+    return q
+
+@app.get("/test4")
+def test4(q: list[int] | list[str] = Query(None)):
+    return q
+
+@app.get("/test5")
+def test5(q: list[int] | str = Query(None)):
+    return q
+
+client = TestClient(app)
+
+def check_openapi():
+    openapi = app.openapi()
+    for path in ["/test1", "/test2", "/test3", "/test4", "/test5"]:
+        params = openapi["paths"][path]["get"]["parameters"]
+        q_param = next(p for p in params if p["name"] == "q")
+        print(f"Path {path}: {q_param['schema']}")
+
+if __name__ == "__main__":
+    check_openapi()

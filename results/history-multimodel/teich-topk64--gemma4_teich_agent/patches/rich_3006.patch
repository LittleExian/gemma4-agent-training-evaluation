diff --git a/reproduce_bug.py b/reproduce_bug.py
new file mode 100644
index 00000000..b1f9423c
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,18 @@
+from rich.repr import rich_repr
+
+class BadEq:
+    def __eq__(self, other):
+        return True
+
+@rich_repr
+class A:
+    def __init__(self, x=BadEq()):
+        self.x = x
+
+a = A()
+print(f"repr(a): {repr(a)}")
+expected = f"A(x={repr(a.x)})"
+if repr(a) == expected:
+    print("SUCCESS")
+else:
+    print(f"FAILURE: expected {expected}, got {repr(a)}")

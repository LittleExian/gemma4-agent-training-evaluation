+from rich.text import Text
+
+def reproduce():
+    t = Text("Hello")
+    t.stylize("red", 0, 2) # "He" is red
+    print(f"Initial text: {t.plain}, length: {len(t)}")
+    print("Appending t to itself...")
+    t.append(t)
+    print(f"Final text: {t.plain}, length: {len(t)}")
+
+if __name__ == "__main__":
+    reproduce()

@@ -0,0 +1,22 @@
+from rich.cells import cell_len
+
+# ZWJ is \u200d
+# 👩 (U+1F469) - width 2
+# 🔧 (U+1F527) - width 2
+# 👩\u200d🔧 (Female Mechanic) - should be width 4 (or maybe 2 depending on terminal, but rich usually sums them)
+
+text = "👩\u200d🔧"
+print(f"Text: {text}")
+print(f"Length: {len(text)}")
+print(f"Cell length: {cell_len(text)}")
+
+# Expected: 
+# 👩 is 2
+# \u200d is 0
+# 🔧 is 2
+# Total: 4
+
+# But with current code:
+# 👩 is 2
+# \u200d is encountered, next() is called, 🔧 is skipped.
+# Total: 2

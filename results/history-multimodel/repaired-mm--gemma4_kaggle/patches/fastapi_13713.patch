diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..d97b7ed8
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,19 @@
+from fastapi import FastAPI
+import json
+
+app = FastAPI(
+    title="Test App",
+    version="0.1.0",
+    external_docs={
+        "description": "External docs",
+        "url": "https://fastapi.tiangolo.com/",
+    }
+)
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
+
+assert "externalDocs" in openapi_schema
+assert openapi_schema["externalDocs"]["description"] == "External docs"
+assert openapi_schema["externalDocs"]["url"] == "https://fastapi.tiangolo.com/"
+print("Test passed!")

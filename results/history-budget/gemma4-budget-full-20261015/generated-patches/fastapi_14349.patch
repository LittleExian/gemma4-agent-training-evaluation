@@ -0,0 +1,22 @@
+from fastapi import FastAPI
+from pydantic import BaseModel, Field
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+class ModelWithRefV2(BaseModel):
+    ref_field: str = Field(alias="$ref")
+
+@app.get("/test", response_model=ModelWithRefV2)
+def read_test():
+    return {"ref_field": "test"}
+
+client = TestClient(app)
+
+try:
+    app.openapi()
+    print("OpenAPI generated successfully")
+except Exception as e:
+    print(f"Error generating OpenAPI: {e}")
+    import traceback
+    traceback.print_exc()

+from rich.traceback import install, Traceback
+from rich.console import Console
+import rich.traceback
+
+install()
+
+class BadTraceback(Traceback):
+    def __rich_console__(self, console, options=None):
+        raise RuntimeError("Recursion!")
+
+original_from_exception = rich.traceback.Traceback.from_exception
+def bad_from_exception(*args, **kwargs):
+    tb = original_from_exception(*args, **kwargs)
+    tb.__class__ = BadTraceback
+    return tb
+rich.traceback.Traceback.from_exception = bad_from_exception
+
+raise RuntimeError("Trigger")

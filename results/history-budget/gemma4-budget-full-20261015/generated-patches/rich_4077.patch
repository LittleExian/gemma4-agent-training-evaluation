diff --git a/repro_progress.py b/repro_progress.py
new file mode 100644
index 00000000..47bde88b
--- /dev/null
+++ b/repro_progress.py
@@ -0,0 +1,42 @@
+
+import io
+from rich.progress import Progress
+from rich.file_proxy import FileProxy
+
+class MockFile:
+    def write(self, text):
+        pass
+    def flush(self):
+        pass
+
+def test_progress_isatty_proxy():
+    file = MockFile()
+    # We need a console to create a progress
+    from rich.console import Console
+    console = Console(file=file)
+    
+    # Create a FileProxy
+    proxy = FileProxy(console, file)
+    
+    # Create a Progress instance. 
+    # Progress takes a console, and it uses console.file as handle.
+    # But Progress.handle is actually the console.file.
+    
+    # Let's see how Progress is initialized.
+    # Progress(console=console)
+    # self.console = console
+    # self.handle = console.file
+    
+    progress = Progress(console=console)
+    console.file = proxy
+    progress.handle = proxy # Force the proxy as handle
+    
+    try:
+        print(f"Progress isatty: {progress.isatty()}")
+    except AttributeError as e:
+        print(f"Caught expected AttributeError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == '__main__':
+    test_progress_isatty_proxy()

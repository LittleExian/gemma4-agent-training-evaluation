--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,48 @@
+import rich.cells
+
+def test_case(text, expected_width, expected_graphemes_count):
+    width = rich.cells._cell_len(text, "auto")
+    spans, total_width = rich.cells.split_graphemes(text, "auto")
+    graphemes_count = len(spans)
+    
+    print(f"Text: {repr(text)}")
+    print(f"  Width: {width} (expected {expected_width}) - {'OK' if width == expected_width else 'FAIL'}")
+    print(f"  Total Width from split_graphemes: {total_width} (expected {expected_width}) - {'OK' if total_width == expected_width else 'FAIL'}")
+    print(f"  Graphemes Count: {graphemes_count} (expected {expected_graphemes_count}) - {'OK' if graphemes_count == expected_graphemes_count else 'FAIL'}")
+    print("-" * 20)
+    
+    if width != expected_width or total_width != expected_width or graphemes_count != expected_graphemes_count:
+        return False
+    return True
+
+test_cases = [
+    # Case 1: ZWJ at the start
+    ("\u200dB", 1, 1),
+    # Case 2: Width-0 character followed by ZWJ
+    ("\u0300\u200dB", 1, 1),
+    # Case 3: Multiple ZWJs
+    ("A\u200d\u200dB", 2, 2),
+    # Case 4: ZWJ followed by width-0 character
+    ("A\u200d\u0300B", 2, 2),
+    # Case 5: ZWJ followed by width-0 character, then width-1 character
+    ("A\u200d\u0300\u200dB", 2, 2),
+    # Case 6: ZWJ followed by width-1 character, then width-0 character
+    ("A\u200dB\u0300", 2, 2),
+    # Case 7: ZWJ followed by width-1 character, then ZWJ, then width-1 character
+    ("A\u200dB\u200dC", 3, 3),
+    # Case 8: ZWJ followed by width-1 character, then ZWJ, then width-0 character
+    ("A\u200dB\u200d\u0300", 2, 2),
+    # Case 9: ZWJ followed by width-1 character, then ZWJ, then width-0 character, then width-1 character
+    ("A\u200dB\u200d\u0300C", 3, 3),
+]
+
+all_passed = True
+for text, expected_width, expected_graphemes_count in test_cases:
+    if not test_case(text, expected_width, expected_graphemes_count):
+        all_passed = False
+
+if all_passed:
+    print("All test cases passed!")
+else:
+    print("Some test cases failed.")
+    exit(1)

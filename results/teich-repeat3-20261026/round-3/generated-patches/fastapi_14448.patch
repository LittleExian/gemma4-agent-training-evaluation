@@ -0,0 +1,43 @@
+import functools
+import inspect
+import asyncio
+from starlette._utils import is_async_callable
+
+def wrapper_sync(f):
+    @functools.wraps(f)
+    def wrapped(*args, **kwargs):
+        return f(*args, **kwargs)
+    return wrapped
+
+def wrapper_async(f):
+    @functools.wraps(f)
+    async def wrapped(*args, **kwargs):
+        return await f(*args, **kwargs)
+    return wrapped
+
+def func_sync():
+    return 1
+
+async def func_async():
+    return 1
+
+# Case 1: sync wrapper, async func
+wrapped_1 = wrapper_sync(func_async)
+partial_1 = functools.partial(wrapped_1)
+
+# Case 2: async wrapper, sync func
+wrapped_2 = wrapper_async(func_sync)
+partial_2 = functools.partial(wrapped_2)
+
+# Case 3: async wrapper, async func
+wrapped_3 = wrapper_async(func_async)
+partial_3 = functools.partial(wrapped_3)
+
+# Case 4: sync wrapper, sync func
+wrapped_4 = wrapper_sync(func_sync)
+partial_4 = functools.partial(wrapped_4)
+
+print(f"Case 1 (sync wrapper, async func): is_async_callable(partial_1) = {is_async_callable(partial_1)}")
+print(f"Case 2 (async wrapper, sync func): is_async_callable(partial_2) = {is_async_callable(partial_2)}")
+print(f"Case 3 (async wrapper, async func): is_async_callable(partial_3) = {is_async_callable(partial_3)}")
+print(f"Case 4 (sync wrapper, sync func): is_async_callable(partial_4) = {is_async_callable(partial_4)}")

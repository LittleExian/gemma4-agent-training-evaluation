@@ -0,0 +1,73 @@
+import argparse
+import re
+import sys
+import subprocess
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def update_version(new_version: str):
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+def prepare_release_notes(new_version: str):
+    content = RELEASE_NOTES_FILE.read_text()
+    
+    # Find the "Latest Changes" section
+    latest_changes_start = content.find("## Latest Changes")
+    if latest_changes_start == -1:
+        print("Error: Could not find '## Latest Changes' section in release notes.")
+        sys.exit(1)
+
+    # Find the first version header (e.g., ## 0.136.3)
+    version_header_match = re.search(r"## \d+\.\d+\.\d+", content)
+    if version_header_match:
+        version_header_start = version_header_match.start()
+    else:
+        version_header_start = len(content)
+    
+    # Find the end of the "## Latest Changes" header line
+    header_end = content.find("\n", latest_changes_start) + 1
+    
+    # Extract the content of "Latest Changes"
+    latest_changes_content = content[header_end:version_header_start].strip()
+    
+    if not latest_changes_content:
+        print("Warning: No changes found in 'Latest Changes' section.")
+    
+    # Create the new version section
+    new_version_section = f"\n## {new_version}\n\n{latest_changes_content}\n\n"
+    
+    # Construct the new content:
+    # 1. Everything up to the end of "## Latest Changes" header
+    # 2. The new version section
+    # 3. Everything from the first version header onwards
+    new_content = content[:header_end] + "\n" + new_version_section + content[version_header_start:]
+    
+    # Clean up multiple newlines to keep it tidy
+    new_content = re.sub(r'\n{3,}', '\n\n', new_content)
+    
+    RELEASE_NOTES_FILE.write_text(new_content)
+    print(f"Moved Latest Changes to {new_version} in {RELEASE_NOTES_FILE}")
+
+def main():
+    parser = argparse.ArgumentParser(description="Prepare FastAPI for release.")
+    parser.add_argument("version", help="The new version to set (e.g., 0.136.4)")
+    args = parser.parse_args()
+    
+    update_version(args.version)
+    prepare_release_notes(args.version)
+    
+    # Run the existing script to add the date to the new version header
+    try:
+        subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+        print("Added release date to release notes.")
+    except subprocess.CalledProcessError as e:
+        print(f"Error running add_latest_release_date.py: {e}")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()

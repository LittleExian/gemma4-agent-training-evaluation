@@ -0,0 +1,20 @@
+from rich.cells import cached_cell_len, split_graphemes
+
+test_cases = [
+    ("\u200dB", 1, [(0, 1, 0), (1, 2, 1)]),
+    ("A\u200d", 1, [(0, 2, 1)]),
+    ("A\u200dB", 1, [(0, 3, 1)]),
+    ("\u200d", 0, [(0, 1, 0)]),
+    ("\u200d\u200dB", 1, [(0, 2, 0), (2, 3, 1)]),
+    ("A\u200d\u200dB", 1, [(0, 5, 1)]),
+]
+
+for text, expected_len, expected_spans in test_cases:
+    actual_len = cached_cell_len(text)
+    actual_spans = split_graphemes(text)
+    print(f"Text: {repr(text)}")
+    print(f"  Length: expected {expected_len}, actual {actual_len}")
+    print(f"  Spans: expected {expected_spans}, actual {actual_spans}")
+    assert actual_len == expected_len
+    assert actual_spans == expected_spans
+print("All tests passed!")

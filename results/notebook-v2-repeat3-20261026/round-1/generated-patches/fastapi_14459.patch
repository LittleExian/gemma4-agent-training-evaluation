@@ -0,0 +1,22 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+import json
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def sub_dep(token: str = Security(oauth2_scheme)):
+    return token
+
+def parent_dep(token: str = Security(sub_dep, scopes=["scope1"])):
+    return token
+
+@app.get("/path2")
+def path2(b=Depends(sub_dep)):
+    return {"message": "path2"}
+
+@app.get("/path1")
+def path1(a=Depends(parent_dep)):
+    return {"message": "path1"}
+
+print(json.dumps(app.openapi(), indent=2))

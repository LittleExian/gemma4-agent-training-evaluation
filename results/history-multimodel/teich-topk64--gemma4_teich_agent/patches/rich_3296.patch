+from rich.console import Console
+from rich.syntax import Syntax
+from rich.padding import Padding
+from rich.segment import Segment
+
+def test_syntax_padding_background():
+    console = Console(force_terminal=True, width=40)
+    code = "print('hello')"
+    # Use a specific background color override
+    background_color = "red"
+    padding = 1
+    syntax = Syntax(code, lexer="python", background_color=background_color, padding=padding)
+    
+    # We want to see if the padding segments have the red background
+    # The padding should be around the syntax.
+    # The syntax itself will have the red background.
+    # The padding should also have the red background.
+    
+    # Let's capture the output
+    with console.capture() as capture:
+        console.print(syntax)
+    
+    output = capture.get()
+    # The output should contain the red background color code.
+    # Red background in ANSI is \x1b[41m or \x1b[48;2;255;0;0m etc.
+    # Since we are using rich, it might be \x1b[48;2;...m
+    
+    # Let's just print the segments and check them.
+    # We can't easily get segments from console.print.
+    # But we can use console.render.
+    
+    segments = list(console.render(syntax))
+    # The first segment should be the padding.
+    # Let's check the style of the first segment.
+    
+    first_segment = segments[0]
+    print(f"First segment style: {first_segment.style}")
+    print(f"First segment text: {repr(first_segment.text)}")
+    
+    # The background color should be red.
+    assert first_segment.style.bgcolor == "red"
+
+if __name__ == "__main__":
+    try:
+        test_syntax_padding_background()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")

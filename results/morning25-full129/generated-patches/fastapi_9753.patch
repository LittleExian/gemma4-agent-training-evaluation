diff --git a/repro_fix.py b/repro_fix.py
new file mode 100644
index 00000000..27601e5a
--- /dev/null
+++ b/repro_fix.py
@@ -0,0 +1,48 @@
+
+import functools
+import inspect
+from typing import ForwardRef
+from fastapi.dependencies.utils import get_typed_signature, get_typed_return_annotation
+
+class MyModel:
+    pass
+
+def my_func(a: "MyModel"):
+    return "MyModel"
+
+partial_func = functools.partial(my_func)
+
+def test_get_typed_signature():
+    sig = get_typed_signature(partial_func)
+    param = list(sig.parameters.values())[0]
+    print(f"Param annotation: {param.annotation}")
+    assert param.annotation == MyModel
+
+def test_get_typed_return_annotation():
+    # For return annotation, we need to make sure it's a string for get_typed_annotation to work
+    # But my_func return annotation is not specified, so it's inspect.Signature.empty
+    # Let's redefine my_func
+    pass
+
+def my_func_ret(a: int) -> "MyModel":
+    return "MyModel"
+
+partial_func_ret = functools.partial(my_func_ret)
+
+def test_get_typed_return_annotation_fixed():
+    ret = get_typed_return_annotation(partial_func_ret)
+    print(f"Return annotation: {ret}")
+    assert ret == MyModel
+
+if __name__ == "__main__":
+    try:
+        test_get_typed_signature()
+        print("test_get_typed_signature passed")
+        test_get_typed_return_annotation_fixed()
+        print("test_get_typed_return_annotation passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

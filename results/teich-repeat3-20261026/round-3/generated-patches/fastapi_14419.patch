diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..dae5d346
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,36 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security.oauth2 import SecurityScopes
+from fastapi.testclient import TestClient
+import pytest
+
+# Use a global to count calls
+call_count = 0
+
+def dep_no_scopes():
+    global call_count
+    call_count += 1
+    return "no_scopes"
+
+def dep_with_scopes(d1 = Depends(dep_no_scopes)):
+    return "with_scopes"
+
+app = FastAPI()
+
+@app.get("/")
+def root(
+    d1 = Depends(dep_no_scopes),
+    d2 = Security(dep_with_scopes, scopes=["admin"]),
+):
+    return {"d1": d1, "d2": d2}
+
+client = TestClient(app)
+
+def test_cache_hit():
+    global call_count
+    call_count = 0
+    client.get("/")
+    assert call_count == 1, f"Expected dep_no_scopes to be called once, but it was called {call_count} times"
+
+if __name__ == "__main__":
+    test_cache_hit()
+    print("Test passed!")

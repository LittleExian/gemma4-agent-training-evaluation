diff --git a/verify_regex.py b/verify_regex.py
new file mode 100644
index 00000000..1713d621
--- /dev/null
+++ b/verify_regex.py
@@ -0,0 +1,55 @@
+import re
+from rich.cells import _is_single_cell_widths, cell_len
+
+def test_regex():
+    test_cases = [
+        ("abc", True),
+        ("pqrstuvwxyz", True),
+        ("ABC", True),
+        ("XYZ", True),
+        ("123", True),
+        (" ", True),
+        ("~", True),
+        ("!", True),
+        ("@", True),
+        ("#", True),
+        ("\n", False),
+        ("\u00a0", True),
+        ("\u00ac", True),
+        ("\u00ad", False),
+        ("\u00ae", True),
+        ("\u02ff", True),
+        ("\u0370", True),
+        ("\u0482", True),
+        ("\u0483", False),
+    ]
+
+    for text, expected_is_single in test_cases:
+        is_single = _is_single_cell_widths(text)
+        actual_len = cell_len(text)
+        expected_len = len(text)
+        
+        if is_single:
+            if actual_len != expected_len:
+                print(f"FAIL: {repr(text)}: is_single=True but cell_len({actual_len}) != len({expected_len})")
+                return False
+        
+        if is_single != expected_is_single:
+            # For the purpose of this test, we want to make sure it's True for the ones we expect.
+            # If it's False for something we expect to be True, it's a performance loss.
+            # If it's True for something we expect to be False, it's a correctness bug.
+            if is_single and not expected_is_single:
+                print(f"FAIL: {repr(text)}: is_single=True but expected False (correctness bug!)")
+                return False
+            if not is_single and expected_is_single:
+                print(f"FAIL: {repr(text)}: is_single=False but expected True (performance loss!)")
+                return False
+            
+    print("All tests passed!")
+    return True
+
+if __name__ == "__main__":
+    if test_regex():
+        exit(0)
+    else:
+        exit(1)

+
+from fastapi import FastAPI
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+
+async def s_shutdown():
+    print("ASYNC SHUTDOWN", flush=True)
+
+app = FastAPI(on_startup=[s_start], on_shutdown=[s_shutdown])
+
+@app.get("/health")
+async def health():
+    return {"ok": True}
+
+async def main():
+    # We need to simulate the lifespan of the app
+    # In a real scenario, uvicorn handles this.
+    # We can use the lifespan context manager directly.
+    async with app.lifespan(app):
+        print("App started")
+
+if __name__ == "__main__":
+    asyncio.run(main())

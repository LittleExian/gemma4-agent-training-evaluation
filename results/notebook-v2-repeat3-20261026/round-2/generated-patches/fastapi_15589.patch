@@ -0,0 +1,28 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class MyHeaders(BaseModel):
+    x_my_header: str
+
+@app.get("/")
+async def read_header(headers: MyHeaders = Header()):
+    return {"headers": headers}
+
+client = TestClient(app)
+
+def test_underscore_header():
+    # This should fail (return 422) if convert_underscores=True (default)
+    response = client.get("/", headers={"X_My_Header": "foo"})
+    print(f"Response with X_My_Header: {response.status_code}, {response.json()}")
+
+def test_hyphen_header():
+    # This should succeed
+    response = client.get("/", headers={"X-My-Header": "foo"})
+    print(f"Response with X-My-Header: {response.status_code}, {response.json()}")
+
+if __name__ == "__main__":
+    test_underscore_header()
+    test_hyphen_header()

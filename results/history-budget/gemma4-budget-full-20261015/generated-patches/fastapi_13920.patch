+def is_typealiastype(tp: Any) -> bool:
+    type_alias_types = []
+    try:
+        from typing import TypeAliasType
+        type_alias_types.append(TypeAliasType)
+    except ImportError:
+        pass
+    try:
+        from typing_extensions import TypeAliasType
+        type_alias_types.append(TypeAliasType)
+    except ImportError:
+        pass
+
+    if not type_alias_types:
+        return False
+    return isinstance(tp, tuple(type_alias_types))
+
+
+def unwrap_type_alias(annotation: Any) -> Any:
+    while is_typealiastype(annotation):
+        annotation = annotation.__value__
+    return annotation

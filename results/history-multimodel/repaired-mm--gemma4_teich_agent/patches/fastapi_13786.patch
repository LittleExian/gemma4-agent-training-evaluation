diff --git a/verify_oidc.py b/verify_oidc.py
new file mode 100644
index 00000000..f22550c9
--- /dev/null
+++ b/verify_oidc.py
@@ -0,0 +1,45 @@
+from fastapi import FastAPI, Depends
+from fastapi.security.open_id_connect_url import OpenIdConnect
+from fastapi.testclient import TestClient
+from starlette.status import HTTP_401_UNAUTHORIZED, HTTP_403_FORBIDDEN
+
+def test_oidc_default():
+    app = FastAPI()
+    oidc = OpenIdConnect(openIdConnectUrl="https://example.com/.well-known/openid-configuration")
+    
+    @app.get("/me")
+    async def me(token: str = Depends(oidc)):
+        return {"token": token}
+    
+    client = TestClient(app)
+    response = client.get("/me")
+    assert response.status_code == HTTP_401_UNAUTHORIZED
+    assert response.headers["WWW-Authenticate"] == "Bearer"
+    assert response.json() == {"detail": "Not authenticated"}
+
+def test_oidc_403():
+    app = FastAPI()
+    oidc = OpenIdConnect(openIdConnectUrl="https://example.com/.well-known/openid-configuration", not_authenticated_status_code=HTTP_403_FORBIDDEN)
+    
+    @app.get("/me")
+    async def me(token: str = Depends(oidc)):
+        return {"token": token}
+    
+    client = TestClient(app)
+    response = client.get("/me")
+    assert response.status_code == HTTP_403_FORBIDDEN
+    assert "WWW-Authenticate" not in response.headers
+    assert response.json() == {"detail": "Not authenticated"}
+
+if __name__ == "__main__":
+    try:
+        test_oidc_default()
+        print("test_oidc_default passed")
+        test_oidc_403()
+        print("test_oidc_403 passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

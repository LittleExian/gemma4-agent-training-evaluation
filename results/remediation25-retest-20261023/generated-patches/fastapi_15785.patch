+    def _iter_route_contexts(
+        self, include_context: "_RouterIncludeContext"
+    ) -> Iterator["_EffectiveRouteContext"]:
+        for route in self.routes:
+            if isinstance(route, _IncludedRouter):
+                child_context = include_context.combine(route.include_context)

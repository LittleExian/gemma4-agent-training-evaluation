+from rich.text import Text
+from rich.console import Console
+
+def test_split():
+    print("--- Split Tests ---")
+    for s in ["A\n\nB", "\n", "\n\n"]:
+        t = Text(s)
+        lines = t.split()
+        print(f"Split {s!r}: {[l.plain for l in lines]} (len={len(lines)})")
+
+def test_wrap():
+    print("\n--- Wrap Tests ---")
+    console = Console(width=10)
+    for s in ["A\n\nB", "\n", "\n\n"]:
+        t = Text(s)
+        lines = t.wrap(console, width=10)
+        print(f"Wrap {s!r}: {[l.plain for l in lines]} (len={len(lines)})")
+
+if __name__ == "__main__":
+    test_split()
+    test_wrap()

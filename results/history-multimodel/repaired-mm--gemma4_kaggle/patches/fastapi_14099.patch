+class ResponseStackWrapper:
+    def __init__(
+        self,
+        response: Response,
+        file_stack: AsyncExitStack,
+        async_exit_stack: AsyncExitStack,
+    ) -> None:
+        self.response = response
+        self.file_stack = file_stack
+        self.async_exit_stack = async_exit_stack
+
+    async def __call__(
+        self, scope: Scope, receive: Any, send: Any
+    ) -> None:
+        try:
+            await self.response(scope, receive, send)
+        finally:
+            await self.async_exit_stack.aclose()
+            await self.file_stack.aclose()
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self.response, name)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        if name in ("response", "file_stack", "async_exit_stack"):
+            super().__setattr__(name, value)
+        else:
+            setattr(self.response, name, value)
+
+

@@ -0,0 +1,15 @@
+import warnings
+
+
+class FastAPIDeprecationWarning(DeprecationWarning):
+    """
+    A custom deprecation warning for FastAPI.
+
+    This warning is used to indicate deprecated features or logic in FastAPI,
+    such as Pydantic v1 models.
+
+    Read more about deprecations in the
+    [FastAPI docs for Deprecations](https://fastapi.tiangolo.com/advanced/deprecations/).
+    """
+
+    pass

@@ -0,0 +1,19 @@
+from fastapi import FastAPI, Response
+from pydantic import BaseModel
+import pytest
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+app = FastAPI()
+
+@app.get("/", response_model=Item, response_class=Response)
+async def root():
+    return Item(name="Foo", price=1.2)
+
+def test_response_class_response():
+    from fastapi.testclient import TestClient
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200

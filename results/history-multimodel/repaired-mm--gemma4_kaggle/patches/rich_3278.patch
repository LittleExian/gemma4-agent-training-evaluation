diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..ac120692
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,18 @@
+from rich.ansi import AnsiDecoder
+
+decoder = AnsiDecoder()
+text = "hello\x1b0world"
+decoded = list(decoder.decode(text))
+print(f"Decoded 0: {decoded}")
+
+text2 = "hello\x1b7world"
+decoded2 = list(decoder.decode(text2))
+print(f"Decoded 7: {decoded2}")
+
+text3 = "hello\x1b?world"
+decoded3 = list(decoder.decode(text3))
+print(f"Decoded ?: {decoded3}")
+
+text4 = "hello\x1b(world"
+decoded4 = list(decoder.decode(text4))
+print(f"Decoded (: {decoded4}")

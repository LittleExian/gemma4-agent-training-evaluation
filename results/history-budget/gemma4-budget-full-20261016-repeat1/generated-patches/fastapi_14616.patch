+
+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import Annotated, List
+from fastapi.dependencies.utils import get_cached_model_fields
+import inspect
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    tags: Annotated[Json[List[str]], Form()]
+):
+    return {"tags": tags}
+
+# Find the route
+route = next(r for r in app.routes if r.path == "/upload")
+# The route's endpoint is the 'upload' function
+endpoint = route.endpoint
+
+# Get the signature of the endpoint
+sig = inspect.signature(endpoint)
+# Find the 'tags' parameter
+param = sig.parameters['tags']
+# The default value of the parameter is the Form() object
+# But we want the field info that FastAPI creates.
+
+# FastAPI stores the solved dependencies in the route.
+# Let's look at how FastAPI handles this.
+# Actually, we can just look at the route's endpoint's __fastapi_params__ if it exists.
+# Or we can look at the route's endpoint's dependencies.
+
+print(f"Param default: {param.default}")
+print(f"Param annotation: {param.annotation}")
+
+# Let's try to find where FastAPI stores the ModelField
+# In FastAPI, the route's endpoint is wrapped.
+# Let's just print the annotation and see.
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..52849575
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,32 @@
+
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import Annotated, List
+import pytest
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    tags: Annotated[Json[List[str]], Form()]
+):
+    return {"tags": tags}
+
+client = TestClient(app)
+
+def test_json_form():
+    # Client sends JSON string in form field
+    response = client.post("/upload", data={"tags": '["abc", "def"]'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"tags": ["abc", "def"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()

+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+def update_version(version: str) -> None:
+    file_path = Path("fastapi/__init__.py")
+    content = file_path.read_text()
+    
+    new_content = re.sub(
+        r'^__version__ = ".*"$',
+        f'__version__ = "{version}"',
+        content,
+        flags=re.MULTILINE
+    )
+    
+    if new_content == content:
+        print(f"Version {version} already set in {file_path}")
+    else:
+        file_path.write_text(new_content)
+        print(f"Updated version to {version} in {file_path}")
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Prepare release")
+    parser.add_argument("version", help="New version to set")
+    args = parser.parse_args()
+    
+    update_version(args.version)
+    
+    print("Adding latest release date...")
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Error adding release date")
+        sys.exit(result.returncode)
+
+if __name__ == "__main__":
+    main()

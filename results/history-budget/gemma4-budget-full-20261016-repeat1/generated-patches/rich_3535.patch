+from rich.cells import _is_single_cell_widths
+
+test_cases = [
+    ("pqrstuvwxyz", True),  # Previously excluded (\u0070-\u007e)
+    ("\u00a1", True),        # Previously excluded (\u00a1-\u00ac)
+    ("\u00ae", True),        # Previously excluded (\u00ae-\u02fe)

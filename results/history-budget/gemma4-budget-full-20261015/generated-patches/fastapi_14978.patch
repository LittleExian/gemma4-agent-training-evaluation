diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..855de5a9
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,57 @@
+
+from fastapi import FastAPI, Body, HTTPException
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/strict")
+async def strict_endpoint(item: dict = Body(..., strict_content_type=True)):
+    return item
+
+@app.post("/non-strict")
+async def non_strict_endpoint(item: dict = Body(..., strict_content_type=False)):
+    return item
+
+client = TestClient(app)
+
+def test_strict_content_type():
+    # Valid JSON and content-type
+    response = client.post("/strict", json={"foo": "bar"})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+    # Valid JSON but missing content-type
+    # TestClient.post(json=...) sets content-type. 
+    # To test missing content-type, we use content=...
+    import json
+    response = client.post("/strict", content=json.dumps({"foo": "bar"}), headers={})
+    assert response.status_code == 415
+    assert response.json()["detail"] == "Unsupported Media Type"
+
+    # Invalid content-type
+    response = client.post("/strict", json={"foo": "bar"}, headers={"Content-Type": "text/plain"})
+    assert response.status_code == 415
+    assert response.json()["detail"] == "Unsupported Media Type"
+
+def test_non_strict_content_type():
+    # Valid JSON and content-type
+    response = client.post("/non-strict", json={"foo": "bar"})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+    # Valid JSON but missing content-type
+    import json
+    response = client.post("/non-strict", content=json.dumps({"foo": "bar"}), headers={})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+    # Invalid content-type
+    response = client.post("/non-strict", json={"foo": "bar"}, headers={"Content-Type": "text/plain"})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+if __name__ == "__main__":
+    test_strict_content_type()
+    test_non_strict_content_type()
+    print("All tests passed!")

index 000000000..98cfb4744
--- /dev/null
+++ b/scripts/release.py
@@ -0,0 +1,48 @@
+"""Automate release preparation by bumping the version and updating release notes."""
+
+import re
+import sys
+
+VERSION_FILE = "fastapi/__init__.py"
+RELEASE_NOTES_FILE = "docs/en/docs/release-notes.md"
+RELEASE_HEADER_PATTERN = re.compile(r"^## (\d+\.\d+\.\d+)")
+
+def main() -> None:
+    if len(sys.argv) < 2:
+        print("Usage: python scripts/release.py <new_version>")
+        sys.exit(1)
+
+    new_version = sys.argv[1]
+    
+    # 1. Update fastapi/__init__.py
+    with open(VERSION_FILE, "r") as f:
+        content = f.read()
+    
+    new_content = re.sub(r'__version__ = "[^"]+"', f'__version__ = "{new_version}"', content)
+    
+    with open(VERSION_FILE, "w") as f:
+        f.write(new_content)
+    print(f"Updated {VERSION_FILE} to {new_version}")
+
+    # 2. Update docs/en/docs/release-notes.md
+    with open(RELEASE_NOTES_FILE, "r") as f:
+        lines = f.readlines()
+
+    insert_index = -1
+    for i, line in enumerate(lines):
+        if RELEASE_HEADER_PATTERN.match(line):
+            insert_index = i
+            break
+    
+    if insert_index != -1:
+        lines.insert(insert_index, f"## {new_version}\n")
+    else:
+        # If no version header found, add it at the end
+        lines.append(f"\n## {new_version}\n")
+    
+    with open(RELEASE_NOTES_FILE, "w") as f:
+        f.writelines(lines)
+    print(f"Updated {RELEASE_NOTES_FILE} with header for {new_version}")
+
+if __name__ == "__main__":
+    main()

--- /dev/null
+++ b/repro.py
@@ -0,0 +1,44 @@
+from fastapi import FastAPI
+from fastapi.openapi.utils import get_openapi
+from pydantic import BaseModel, computed_field
+from typing import Any
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    
+    @computed_field
+    @property
+    def description(self) -> str:
+        return f"Description of {self.name}"
+
+@app.get("/item", response_model=Item)
+def read_item():
+    return Item(name="test")
+
+def test_computed_fields_in_openapi():
+    # Test with separate_input_output_schemas=True (default)
+    openapi_schema = get_openapi(
+        title="Test",
+        version="1.0.0",
+        routes=app.routes,
+    )
+    
+    # Find the Item schema in components/schemas
+    item_schema = openapi_schema["components"]["schemas"]["Item"]
+    
+    print("Schema with separate_input_output_schemas=True:")
+    print(item_schema)
+    
+    assert "description" in item_schema["properties"], "Computed field 'description' missing from schema"
+    print("Success: Computed field found in schema!")
+
+if __name__ == "__main__":
+    try:
+        test_computed_fields_in_openapi()
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

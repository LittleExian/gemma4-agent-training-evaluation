diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..decd2855
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,38 @@
+from fastapi import FastAPI
+from fastapi.responses import Response, JSONResponse
+from pydantic import BaseModel
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+class User(BaseModel):
+    name: str
+    age: int
+
+@app.middleware("http")
+async def check_response(request, call_next):
+    response = await call_next(request)
+    if request.url.path == "/custom":
+        print(f"Response type: {type(response)}")
+        assert hasattr(response, "custom"), f"Response should have 'custom' attribute, but it is {type(response)}"
+    return response
+
+class CustomJSONResponse(JSONResponse):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.custom = True
+
+@app.get("/custom", response_model=User, response_class=CustomJSONResponse)
+async def get_custom():
+    return User(name="John", age=30)
+
+client = TestClient(app)
+
+def test_custom():
+    response = client.get("/custom")
+    assert response.status_code == 200
+    assert response.json() == {"name": "John", "age": 30}
+    print("Test custom passed")
+
+if __name__ == "__main__":
+    test_custom()

diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 000000000..4d8ba4cb0
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,24 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_root(user_id: str = Header(convert_underscores=False)):
+    return {"user_id": user_id}
+
+client = TestClient(app)
+
+def test_header_underscores():
+    # convert_underscores=False, should accept user_id
+    response = client.get("/", headers={"user_id": "123"})
+    assert response.status_code == 200
+    assert response.json() == {"user_id": "123"}
+
+    # Should also still accept user-id? No, if convert_underscores=False, it should only accept user_id
+    response = client.get("/", headers={"user-id": "123"})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    test_header_underscores()
+    print("Test passed!")
diff --git a/reproduce_model_issue.py b/reproduce_model_issue.py
new file mode 100644
index 000000000..b488df859
--- /dev/null
+++ b/reproduce_model_issue.py
@@ -0,0 +1,28 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class UserHeaders(BaseModel):
+    user_id: str
+
+@app.get("/")
+async def read_root(headers: UserHeaders = Header()):
+    return {"user_id": headers.user_id}
+
+client = TestClient(app)
+
+def test_model_header_underscores():
+    # Default convert_underscores=True, should accept user-id, not user_id
+    response = client.get("/", headers={"user-id": "123"})
+    assert response.status_code == 200
+    assert response.json() == {"user_id": "123"}
+
+    response = client.get("/", headers={"user_id": "123"})
+    print(f"Response for user_id: {response.status_code}, {response.json()}")
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    test_model_header_underscores()
+    print("Test passed!")

diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..0e7b025e
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+from typing import Union, Annotated
+
+app = FastAPI()
+
+class A(BaseModel):
+    type: str = "A"
+    a: str
+
+class B(BaseModel):
+    type: str = "B"
+    b: str
+
+@app.post("/test")
+async def test_endpoint(
+    data: Annotated[Annotated[Union[A, B], Field(discriminator="type")], Body()]
+):
+    return data
+
+client = TestClient(app)
+
+def test_discriminator():
+    # Test case A
+    response = client.post("/test", json={"type": "A", "a": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"type": "A", "a": "hello"}
+
+    # Test case B
+    response = client.post("/test", json={"type": "B", "b": "world"})
+    assert response.status_code == 200
+    assert response.json() == {"type": "B", "b": "world"}
+
+    # Test case invalid discriminator
+    response = client.post("/test", json={"type": "C", "a": "hello"})
+    assert response.status_code == 422
+
+    # Test case missing discriminator
+    response = client.post("/test", json={"a": "hello"})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_discriminator()
+        print("Tests passed!")
+    except Exception as e:
+        print(f"Tests failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

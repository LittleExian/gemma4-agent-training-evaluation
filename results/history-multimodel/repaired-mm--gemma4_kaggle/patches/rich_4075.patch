@@ -0,0 +1,8 @@
+from rich.console import Console
+import io
+
+stream = io.StringIO()
+console = Console(file=stream, force_terminal=False)
+
+console.print(end="!")
+print(f"Result: {repr(stream.getvalue())}")
diff --git a/reproduce_bug.py b/reproduce_bug.py
new file mode 100644
index 00000000..8e2f123b
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,21 @@
+from rich.console import Console
+from rich.text import Text
+from rich.console import NewLine
+
+console = Console(force_terminal=True)
+
+print("--- Test 1: console.print(end='!') ---")
+console.print(end="!")
+print("--- End Test 1 ---")
+
+print("\n--- Test 2: console.print(NewLine(), end='!') ---")
+console.print(NewLine(), end="!")
+print("--- End Test 2 ---")
+
+print("\n--- Test 3: console.print('Hello', end='!') ---")
+console.print("Hello", end="!")
+print("--- End Test 3 ---")
+
+print("\n--- Test 4: console.print(Text('Hello'), end='!') ---")
+console.print(Text("Hello"), end="!")
+print("--- End Test 4 ---")

diff --git a/verify_typealias.py b/verify_typealias.py
new file mode 100644
index 00000000..6361a1e5
--- /dev/null
+++ b/verify_typealias.py
@@ -0,0 +1,46 @@
+import sys
+from typing import ForwardRef, Any
+from fastapi.dependencies.utils import get_typed_annotation
+from fastapi._compat.shared import is_typealiastype
+
+def test_typealias():
+    try:
+        from types import TypeAliasType
+    except ImportError:
+        print("TypeAliasType not available in this Python version. Skipping test.")
+        return
+
+    # Case 1: Simple TypeAlias
+    # type MyAlias = int
+    MyAlias = TypeAliasType("MyAlias", int)
+    assert get_typed_annotation(MyAlias, {}) == int
+    print("Case 1 passed")
+
+    # Case 2: Nested TypeAlias
+    # type InnerAlias = int
+    # type OuterAlias = InnerAlias
+    InnerAlias = TypeAliasType("InnerAlias", int)
+    OuterAlias = TypeAliasType("OuterAlias", InnerAlias)
+    assert get_typed_annotation(OuterAlias, {}) == int
+    print("Case 2 passed")
+
+    # Case 3: TypeAlias with ForwardRef
+    # type ForwardAlias = "ForwardRefType"
+    # ForwardRefType = int
+    ForwardAlias = TypeAliasType("ForwardAlias", "ForwardRefType")
+    globalns = {"ForwardRefType": int}
+    assert get_typed_annotation(ForwardAlias, globalns) == int
+    print("Case 3 passed")
+
+    # Case 4: TypeAlias with ForwardRef that resolves to another TypeAlias
+    # type InnerAlias = int
+    # type ForwardAlias = "ForwardRefType"
+    # ForwardRefType = InnerAlias
+    InnerAlias = TypeAliasType("InnerAlias", int)
+    ForwardAlias = TypeAliasType("ForwardAlias", "ForwardRefType")
+    globalns = {"ForwardRefType": InnerAlias}
+    assert get_typed_annotation(ForwardAlias, globalns) == int
+    print("Case 4 passed")
+
+if __name__ == "__main__":
+    test_typealias()

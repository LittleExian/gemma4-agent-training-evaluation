+++ b/repro.py
@@ -0,0 +1,12 @@
+from rich.segment import Segment
+
+def test_split_cells_zero_len():
+    text = "\u200b"
+    segment = Segment(text, None, None)
+    before, after = segment.split_cells(0)
+    print(f"before: {repr(before.text)}, after: {repr(after.text)}")
+    assert before.text == ""
+    assert after.text == "\u200b"
+
+if __name__ == "__main__":
+    test_split_cells_zero_len()

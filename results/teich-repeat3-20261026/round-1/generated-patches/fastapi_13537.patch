diff --git a/repro_alias.py b/repro_alias.py
new file mode 100644
index 00000000..6d625869
--- /dev/null
+++ b/repro_alias.py
@@ -0,0 +1,32 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/form")
+async def read_form(q: str = Form(None, alias="query_param")):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_form_alias_empty_string():
+    # When query_param is an empty string and default is None, it should be None
+    response = client.post("/form", data={"query_param": ""})
+    print(f"Response: {response.json()}")
+    assert response.json() == {"q": None}
+
+def test_form_alias_value():
+    # When query_param has a value, it should be returned
+    response = client.post("/form", data={"query_param": "foo"})
+    print(f"Response: {response.json()}")
+    assert response.json() == {"q": "foo"}
+
+if __name__ == "__main__":
+    try:
+        test_form_alias_value()
+        test_form_alias_empty_string()
+        print("Tests passed!")
+    except AssertionError as e:
+        print(f"Tests failed: {e}")
+        exit(1)

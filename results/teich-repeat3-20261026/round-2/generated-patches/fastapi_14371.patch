+from typing import Optional
+from typing_extensions import Annotated
+from fastapi import FastAPI, File
+from pydantic import BaseModel
+import json
+
+app = FastAPI()
+
+@app.post("/optional-bytes-alias", operation_id="optional_bytes_alias")
+async def read_optional_bytes_alias(
+    p: Annotated[Optional[bytes], File(alias="p_alias")] = None,
+):
+    return {"file_size": len(p) if p else None}
+
+openapi = app.openapi()
+body_model_name = "OptionalBytesAlias" # This is just a guess, let's find it
+
+# Find the model name for the path
+path = "/optional-bytes-alias"
+for path_item in openapi["paths"].items():
+    if path in path_item[0]:
+        # It's a POST request
+        request_body = openapi["paths"][path]["post"]["requestBody"]
+        content = request_body["content"]["application/x-www-form-urlencoded"]
+        schema = content["schema"]
+        if schema["$ref"]:
+            body_model_name = schema["$ref"].split("/")[-1]
+        else:
+            # It's an inline schema
+            print("Inline schema found!")
+            print(json.dumps(schema, indent=2))
+            exit(0)
+
+print(f"Body model name: {body_model_name}")
+model_schema = openapi["components"]["schemas"][body_model_name]
+print(f"Model schema: {json.dumps(model_schema, indent=2)}")

@@ -0,0 +1,10 @@
+from rich.console import Console
+from rich.padding import Padding
+
+console = Console(width=None)
+try:
+    console.print(Padding("Hello", expand=True))
+except Exception as e:
+    print(f"Caught exception: {e}")
+    import traceback
+    traceback.print_exc()

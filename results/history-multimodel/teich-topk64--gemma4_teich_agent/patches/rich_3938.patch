+from rich.console import Console
+from rich.text import Text
+import io
+
+console = Console(file=io.StringIO(), width=20, force_terminal=True)
+text = Text()
+text.append("This is a long text with a background style ", style="on blue")
+text.append("that should be soft wrapped.", style="on red")
+console.print(text, soft_wrap=True)
+print(console.file.getvalue())

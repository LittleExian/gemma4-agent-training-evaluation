+++ b/scripts/release.py
@@ -0,0 +1,79 @@
+"""Automate release preparation: update version, migrate release notes, and add date."""
+
+import re
+import sys
+import subprocess
+
+VERSION_FILE = "fastapi/__init__.py"
+RELEASE_NOTES_FILE = "docs/en/docs/release-notes.md"
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/release.py <new_version>")
+        sys.exit(1)
+
+    new_version = sys.argv[1]
+    print(f"Preparing release {new_version}...")
+
+    # 1. Update version in fastapi/__init__.py
+    with open(VERSION_FILE, "r") as f:
+        content = f.read()
+
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    with open(VERSION_FILE, "w") as f:
+        f.write(new_content)
+    print(f"Updated version in {VERSION_FILE}")
+
+    # 2. Update release notes
+    with open(RELEASE_NOTES_FILE, "r") as f:
+        lines = f.readlines()
+
+    # Find ## Latest Changes
+    latest_changes_idx = -1
+    for i, line in enumerate(lines):
+        if line.strip() == "## Latest Changes":
+            latest_changes_idx = i
+            break
+
+    if latest_changes_idx == -1:
+        print("Could not find ## Latest Changes in release notes")
+        sys.exit(1)
+
+    # Extract content under ## Latest Changes until the next ## header
+    content_to_migrate = []
+    next_header_idx = len(lines)
+    for i in range(latest_changes_idx + 1, len(lines)):
+        if lines[i].startswith("## "):
+            next_header_idx = i
+            break
+        content_to_migrate.append(lines[i])
+
+    # Construct new lines
+    new_lines = lines[:latest_changes_idx + 1]
+    
+    # Ensure there's a newline after ## Latest Changes
+    if not lines[latest_changes_idx].endswith("\n"):
+        new_lines[-1] = lines[latest_changes_idx] + "\n"
+    
+    new_lines.append("\n")
+    new_lines.append(f"## {new_version}\n")
+    new_lines.extend(content_to_migrate)
+    
+    # Ensure there's a newline before the next header
+    if content_to_migrate and not content_to_migrate[-1].endswith("\n"):
+        new_lines.append("\n")
+    elif not content_to_migrate:
+        new_lines.append("\n")
+
+    new_lines.extend(lines[next_header_idx:])
+
+    with open(RELEASE_NOTES_FILE, "w") as f:
+        f.writelines(new_lines)
+    print(f"Migrated Latest Changes to {new_version} in {RELEASE_NOTES_FILE}")
+
+    # 3. Add date to the latest release header
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Added date to the latest release header")
+
+if __name__ == "__main__":
+    main()

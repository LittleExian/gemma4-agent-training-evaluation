new file mode 100644
index 00000000..54f9a0f7
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,21 @@
+
+from rich.repr import auto
+from inspect import Parameter
+
+class MyClass:
+    def __init__(self, x):
+        self.x = x
+    def __eq__(self, other):
+        return True
+    def __repr__(self):
+        return f"MyClass({self.x})"
+
+@auto
+class Foo:
+    def __init__(self, x=MyClass(1)):
+        self.x = x
+
+foo = Foo(MyClass(1))
+print(f"Repr of foo: {repr(foo)}")
+# Expected: Foo()
+# If bug exists: Foo(MyClass(1))

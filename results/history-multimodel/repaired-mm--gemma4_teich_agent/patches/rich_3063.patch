+from rich.console import Console
+
+def test_backslashes():
+    console = Console(force_terminal=True)
+    print("Markup: 'hello\\'")
+    console.print("hello\\")
+    print("Markup: 'hello\\\\'")
+    console.print("hello\\\\")
+    print("Markup: 'hello\\\\\\\\'")
+    console.print("hello\\\\\\\\")
+
+if __name__ == "__main__":
+    test_backslashes()

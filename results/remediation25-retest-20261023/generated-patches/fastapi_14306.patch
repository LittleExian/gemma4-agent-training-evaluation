+    @functools.cached_property
+    def endpoint_context(self) -> str:
+        try:
+            # Get the source file and line number of the endpoint function
+            frame = inspect.getframeinfo(inspect.getfile(self.endpoint), self.endpoint.__code__.co_firstlineno)
+            filename = frame.filename
+            lineno = frame.lineno
+            func_name = self.endpoint.__name__
+            methods = ",".join(sorted(self.methods))
+            return f"{filename}:{lineno} ({func_name}, {methods}, {self.path})"
+        except Exception:
+            return "Unknown"

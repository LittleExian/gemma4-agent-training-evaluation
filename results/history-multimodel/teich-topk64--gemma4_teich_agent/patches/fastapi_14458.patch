diff --git a/reproduction.py b/reproduction.py
new file mode 100644
index 00000000..a1f8325a
--- /dev/null
+++ b/reproduction.py
@@ -0,0 +1,38 @@
+import inspect
+from fastapi.dependencies.models import Dependant, _impartial, _unwrapped_call
+from fastapi.dependencies.models import iscoroutinefunction
+
+class MyDependency:
+    async def __call__(self):
+        return "foo"
+
+def test_is_coroutine_callable():
+    dependant = Dependant(call=MyDependency)
+    print(f"is_coroutine_callable: {dependant.is_coroutine_callable}")
+    assert dependant.is_coroutine_callable is False
+
+def test_is_gen_callable():
+    class MyGenDependency:
+        def __call__(self):
+            yield "foo"
+    dependant = Dependant(call=MyGenDependency)
+    print(f"is_gen_callable: {dependant.is_gen_callable}")
+    assert dependant.is_gen_callable is False
+
+def test_is_async_gen_callable():
+    class MyAsyncGenDependency:
+        async def __call__(self):
+            yield "foo"
+    dependant = Dependant(call=MyAsyncGenDependency)
+    print(f"is_async_gen_callable: {dependant.is_async_gen_callable}")
+    assert dependant.is_async_gen_callable is False
+
+if __name__ == "__main__":
+    try:
+        test_is_coroutine_callable()
+        test_is_gen_callable()
+        test_is_async_gen_callable()
+        print("All tests passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        exit(1)

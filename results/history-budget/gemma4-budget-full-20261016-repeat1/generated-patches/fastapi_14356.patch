@@ -0,0 +1,59 @@
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+
+class Model(BaseModel):
+    param: str
+
+    model_config = {"extra": "allow"}
+
+
+@app.get("/")
+async def model_with_extra(data: Model = Query()):
+    return data
+
+
+def test_pass_extra_list():
+    client = TestClient(app)
+    resp = client.get(
+        "/",
+        params={
+            "param": "123",
+            "param2": ["456", "789"],  # Pass a list of values as extra parameter
+        },
+    )
+    print(f"List test response: {resp.json()}")
+    assert resp.status_code == 200
+    assert resp.json() == {
+        "param": "123",
+        "param2": ["456", "789"],
+    }
+
+def test_pass_extra_single():
+    client = TestClient(app)
+    resp = client.get(
+        "/",
+        params={
+            "param": "123",
+            "param2": "456",  # Pass a single value as extra parameter
+        },
+    )
+    print(f"Single test response: {resp.json()}")
+    assert resp.status_code == 200
+    assert resp.json() == {
+        "param": "123",
+        "param2": "456",
+    }
+
+if __name__ == "__main__":
+    try:
+        test_pass_extra_list()
+        test_pass_extra_single()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")

+from __future__ import annotations
+import typing
+import inspect
+from typing import Any
+
+class MyClass:
+    class LocalType:
+        pass
+
+    def my_method(self, x: LocalType) -> Any:
+        return x
+
+def test_get_type_hints():
+    obj = MyClass()
+    hints = typing.get_type_hints(obj.my_method)
+    print(f"Hints: {hints}")
+
+if __name__ == "__main__":
+    test_get_type_hints()

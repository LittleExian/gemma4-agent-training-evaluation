+from typing import Any, Dict, Union
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+from typing_extensions import Annotated, Literal
+import json
+
+app = FastAPI()
+
+class FirstItem(BaseModel):
+    value: Literal["first"]
+    price: int
+
+class OtherItem(BaseModel):
+    value: Literal["other"]
+    price: float
+
+Item = Annotated[
+    Union[FirstItem, OtherItem],
+    Field(discriminator="value"),
+]
+
+@app.post("/items/")
+def save_union_body_discriminator(
+    item: Annotated[Item, Body()], q: Annotated[str, Field(description="Query string")]
+) -> Dict[str, Any]:
+    return {"item": item}
+
+client = TestClient(app)
+
+def test_openapi():
+    response = client.get("/openapi.json")
+    assert response.status_code == 200
+    schema = response.json()
+    
+    # Check if discriminator is present in the request body schema
+    request_body = schema["paths"]["/items/"]["post"]["requestBody"]
+    content = request_body["content"]["application/json"]["schema"]
+    
+    # It should have a discriminator
+    assert "discriminator" in content, "Discriminator missing from OpenAPI schema"
+    assert content["discriminator"]["propertyName"] == "value"
+
+if __name__ == "__main__":
+    try:
+        test_openapi()
+        print("OpenAPI test passed!")
+    except Exception as e:
+        print(f"OpenAPI test failed: {e}")
+        import traceback
+        traceback.print_exc()

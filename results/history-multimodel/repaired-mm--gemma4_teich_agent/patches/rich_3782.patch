diff --git a/repro_segments.py b/repro_segments.py
new file mode 100644
index 00000000..e69e35ae
--- /dev/null
+++ b/repro_segments.py
@@ -0,0 +1,17 @@
+from rich.console import Console
+from rich.segment import Segment, Segments
+from rich.padding import Padding
+import io
+
+console = Console(width=40, force_terminal=False)
+style_red = console.get_style("bold red")
+style_blue = console.get_style("bold blue")
+segments = Segments([Segment("Hello", style=style_red), Segment(" World", style=style_blue)])
+padding = Padding(segments, (1, 1, 1, 1), expand=False)
+
+with console.capture() as capture:
+    console.print(padding)
+
+output = capture.get()
+for i, line in enumerate(output.splitlines()):
+    print(f"Line {i}: {len(line)} chars")
diff --git a/repro_syntax_padding.py b/repro_syntax_padding.py
new file mode 100644
index 00000000..d2e81c10
--- /dev/null
+++ b/repro_syntax_padding.py
@@ -0,0 +1,22 @@
+from rich.console import Console
+from rich.syntax import Syntax
+
+code = "print('hello')"
+console = Console(width=40)
+
+print("No padding:")
+syntax_no_pad = Syntax(code, lexer="python")
+with console.capture() as capture:
+    console.print(syntax_no_pad)
+output_no_pad = capture.get()
+print(f"'{output_no_pad}'")
+for i, line in enumerate(output_no_pad.splitlines()):
+    print(f"Line {i}: {len(line)} chars")
+
+print("\nWith padding=1:")
+syntax_pad = Syntax(code, lexer="python", padding=1)
+with console.capture() as capture:
+    console.print(syntax_pad)
+output_pad = capture.get()
+for i, line in enumerate(output_pad.splitlines()):
+    print(f"Line {i}: {len(line)} chars")

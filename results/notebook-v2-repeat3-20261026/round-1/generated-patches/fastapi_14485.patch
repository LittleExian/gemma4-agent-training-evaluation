@@ -0,0 +1,26 @@
+from __future__ import annotations
+from typing import TYPE_CHECKING, ForwardRef
+import inspect
+from fastapi.dependencies.utils import get_typed_annotation
+
+if TYPE_CHECKING:
+    class MyModel:
+        pass
+
+def my_endpoint(param: MyModel):
+    pass
+
+# Simulate Python 3.10+ eval_str=True
+try:
+    signature = inspect.signature(my_endpoint, eval_str=True)
+except TypeError:
+    signature = inspect.signature(my_endpoint)
+
+annotation = signature.parameters['param'].annotation
+print(f"Annotation type: {type(annotation)}")
+print(f"Annotation value: {annotation}")
+
+globalns = getattr(my_endpoint, "__globals__", {})
+resolved = get_typed_annotation(annotation, globalns)
+print(f"Resolved type: {type(resolved)}")
+print(f"Resolved value: {resolved}")

+from fastapi import FastAPI
+from fastapi.openapi.utils import get_openapi
+from pydantic import BaseModel, Field
+from typing import List
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    description: str = Field(..., exclude=True)
+
+class ItemList(BaseModel):
+    items: List[Item]
+
+@app.get("/items", response_model=ItemList)
+def read_items():
+    return {"items": [{"name": "item1", "description": "desc1"}]}
+
+openapi_schema = get_openapi(
+    title="Test API",
+    version="1.0.0",
+    routes=[app.routes[0]],
+    separate_input_output_schemas=True,
+)
+
+# Check if Item has both validation and serialization schemas
+schemas = openapi_schema["components"]["schemas"]
+item_validation = schemas.get("Item")
+# In FastAPI, separate_input_output_schemas=True should create separate names
+# Let's see what the names are.
+print("Schemas:", list(schemas.keys()))
+
+# If separate_input_output_schemas=True, we expect something like Item and ItemOut
+# or Item and Item_serialization.
+# Let's check the actual generated names.
+# Based on the current implementation of get_compat_model_name_map, it might be different.
+# But we expect at least two schemas for Item if it has different validation/serialization.
+
+# Let's check if the response schema for /items refers to the serialization schema.
+response_schema_ref = openapi_schema["paths"]["/items"]["get"]["responses"]["200"]["content"]["application/json"]["schema"]["$ref"]
+print("Response schema ref:", response_schema_ref)
+
+# The response schema should be the serialization one.
+# Let's check if the serialization schema excludes 'description'.
+# We need to find which schema is the serialization one.
+for name, schema in schemas.items():
+    if "Item" in name:
+        print(f"Schema {name}: {schema}")
+
+# If the fix works, the serialization schema should not have 'description'.
+# The validation schema should have 'description'.

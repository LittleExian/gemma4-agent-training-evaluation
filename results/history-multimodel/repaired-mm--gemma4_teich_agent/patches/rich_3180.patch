+from rich.console import Console
+from rich.text import Text
+
+def test_wrap_cjk():
+    console = Console(width=4)
+    # "你好你好你好" - 6 chars, width 12.
+    # width=4, so it should be 3 lines of "你好"
+    text = Text("你好你好你好")
+    wrapped = text.wrap(console, width=4)
+    
+    print(f"Original: {text}")
+    print(f"Wrapped: {wrapped}")
+    
+    # Check if any characters are missing
+    original_len = len(text)
+    wrapped_len = sum(len(line) for line in wrapped)
+    print(f"Original len: {original_len}, Wrapped len: {wrapped_len}")
+    
+    if original_len != wrapped_len:
+        print("Characters disappeared!")
+    else:
+        print("No characters disappeared.")
+
+if __name__ == "__main__":
+    test_wrap_cjk()

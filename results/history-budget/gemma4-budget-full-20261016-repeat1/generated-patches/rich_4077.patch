new file mode 100644
index 00000000..57c413ec
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,22 @@
+
+import sys
+from rich.console import Console
+from rich.file_proxy import FileProxy
+from unittest.mock import MagicMock
+
+def test_file_proxy_isatty():
+    mock_file = MagicMock()
+    mock_file.isatty.return_value = True
+    
+    console = Console()
+    proxy = FileProxy(console, mock_file)
+    
+    # Create a new console using the proxy as the file
+    console_with_proxy = Console(file=proxy)
+    
+    print(f"Is terminal: {console_with_proxy.is_terminal}")
+    assert console_with_proxy.is_terminal is True
+    print("Test passed!")
+
+if __name__ == '__main__':
+    test_file_proxy_isatty()
diff --git a/repro_v2.py b/repro_v2.py
new file mode 100644
index 00000000..7a3dec7e
--- /dev/null
+++ b/repro_v2.py
@@ -0,0 +1,31 @@
+
+import sys
+from rich.console import Console
+from rich.file_proxy import FileProxy
+from unittest.mock import MagicMock
+
+def test_file_proxy_isatty_behavior():
+    # Mock a non-terminal file
+    mock_file = MagicMock()
+    mock_file.isatty.return_value = False
+    
+    # Console 1 is a terminal (we can force it)
+    console1 = Console(force_terminal=True)
+    
+    # Proxy redirects to console1, but wraps mock_file
+    proxy = FileProxy(console1, mock_file)
+    
+    # Console 2 uses the proxy
+    console2 = Console(file=proxy)
+    
+    print(f"Console 1 is terminal: {console1.is_terminal}")
+    print(f"Proxy isatty: {proxy.isatty()}")
+    print(f"Console 2 is terminal: {console2.is_terminal}")
+    
+    # If the proxy just delegates to mock_file, this will be False
+    # But it should be True because it's proxying to console1
+    assert console2.is_terminal is True
+    print("Test passed!")
+
+if __name__ == '__main__':
+    test_file_proxy_isatty_behavior()

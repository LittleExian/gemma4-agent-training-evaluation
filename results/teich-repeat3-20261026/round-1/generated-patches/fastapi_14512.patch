diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..d0a3bb01
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,34 @@
+from fastapi import FastAPI, Body
+from pydantic import BaseModel, Field
+from typing import Union, Annotated
+import json
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    type: str = "cat"
+    meow: str
+
+class Dog(BaseModel):
+    type: str = "dog"
+    bark: str
+
+class Pet(BaseModel):
+    pet: Union[Cat, Dog]
+
+@app.post("/pets")
+def create_pet(pet: Annotated[Union[Cat, Dog], Field(discriminator="type"), Body()]):
+    return pet
+
+if __name__ == "__main__":
+    schema = app.openapi()
+    # Find the /pets post request
+    paths = schema["paths"]["/pets"]["post"]
+    request_body = paths["requestBody"]["content"]["application/json"]["schema"]
+    print(json.dumps(request_body, indent=2))
+    
+    if "discriminator" in request_body:
+        print("SUCCESS: Discriminator found!")
+    else:
+        print("FAILURE: Discriminator NOT found!")
+        exit(1)

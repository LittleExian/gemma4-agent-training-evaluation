diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..10b16985
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,28 @@
+
+from fastapi import FastAPI
+from fastapi.encoders import jsonable_encoder
+from pydantic import BaseModel, ConfigDict
+import pytest
+
+class ArbitraryType:
+    def __init__(self, value):
+        self.value = value
+    def __repr__(self):
+        return f"ArbitraryType({self.value})"
+
+class MyModel(BaseModel):
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+    name: str
+    custom: ArbitraryType
+
+def test_arbitrary_type_serialization():
+    model = MyModel(name="test", custom=ArbitraryType("value"))
+    try:
+        encoded = jsonable_encoder(model)
+        print("Encoded successfully:", encoded)
+    except Exception as e:
+        print("Encoding failed:", e)
+        raise e
+
+if __name__ == "__main__":
+    test_arbitrary_type_serialization()
diff --git a/reproduce_issue_dep.py b/reproduce_issue_dep.py
new file mode 100644
index 00000000..a5e6d81f
--- /dev/null
+++ b/reproduce_issue_dep.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Depends
+from pydantic import BaseModel, ConfigDict
+from fastapi.testclient import TestClient
+
+class ArbitraryType:
+    def __init__(self, value: str):
+        self.value = value
+    def __repr__(self):
+        return f"ArbitraryType({self.value})"
+
+def get_arbitrary_type():
+    return ArbitraryType("test")
+
+app = FastAPI()
+
+@app.get("/test")
+async def test_endpoint(item: ArbitraryType = Depends(get_arbitrary_type)):
+    return {"item": str(item)}
+
+client = TestClient(app)
+
+def test_arbitrary_type_dependency():
+    response = client.get("/test")
+    print(f"Response: {response.status_code}, {response.json()}")
+
+if __name__ == "__main__":
+    test_arbitrary_type_dependency()

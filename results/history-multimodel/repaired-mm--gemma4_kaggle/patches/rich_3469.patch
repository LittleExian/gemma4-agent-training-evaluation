@@ -0,0 +1,10 @@
+from rich.console import Console
+from rich.panel import Panel
+
+console = Console(force_terminal=True, width=20)
+# Title is 10 chars, Content is 5 chars.
+# With pad(1), _title is 12 chars.
+# width = 12 + 2 = 14.
+# width - 4 = 10.
+# " Long Title ".truncate(10) -> " Long Titl"
+console.print(Panel("Short", title="Long Title", expand=False))

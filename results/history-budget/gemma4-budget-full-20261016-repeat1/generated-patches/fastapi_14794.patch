@@ -0,0 +1,46 @@
+
+from fastapi import FastAPI, Depends, Response
+from fastapi.testclient import TestClient
+from typing import Annotated
+
+def modify_response(response: Response):
+    response.headers["X-Custom-Header"] = "CustomValue"
+    return response
+
+app = FastAPI()
+
+@app.get("/test-annotated")
+def endpoint_annotated(response: Annotated[Response, Depends(modify_response)]):
+    return {"message": "Hello World"}
+
+@app.get("/test-default")
+def endpoint_default(response: Response = Depends(modify_response)):
+    return {"message": "Hello World"}
+
+@app.get("/test-regular")
+def endpoint_regular(response: Response):
+    return {"message": "Hello World"}
+
+client = TestClient(app)
+
+def test_annotated():
+    response = client.get("/test-annotated")
+    assert response.status_code == 200
+    assert response.headers["X-Custom-Header"] == "CustomValue"
+
+def test_default():
+    response = client.get("/test-default")
+    assert response.status_code == 200
+    assert response.headers["X-Custom-Header"] == "CustomValue"
+
+def test_regular():
+    response = client.get("/test-regular")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    import pytest
+    # This is a bit hacky, but let's just run the functions
+    test_annotated()
+    test_default()
+    test_regular()
+    print("All tests passed!")

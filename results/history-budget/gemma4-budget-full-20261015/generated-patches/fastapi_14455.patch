diff --git a/fastapi/openapi/utils.py b/fastapi/openapi/utils.py
index dbc93d28..c7ff57de 100644
--- a/fastapi/openapi/utils.py
+++ b/fastapi/openapi/utils.py
@@ -81,13 +81,27 @@ def get_openapi_security_definitions(
     security_definitions = {}
     operation_security = []
     for security_requirement in flat_dependant.security_requirements:
+        security_name = security_requirement.security_scheme.scheme_name
         security_definition = jsonable_encoder(
             security_requirement.security_scheme.model,
             by_alias=True,
             exclude_none=True,
         )
-        security_name = security_requirement.security_scheme.scheme_name
-        security_definitions[security_name] = security_definition
+        if security_name in security_definitions:
+            existing_definition = security_definitions[security_name]
+            if existing_definition.get("type") == "oauth2":
+                # Merge scopes for all flows
+                for flow_name, flow_def in security_definition.get("flows", {}).items():
+                    if flow_name in existing_definition.get("flows", {}):
+                        existing_scopes = existing_definition["flows"][flow_name].get("scopes", {})
+                        new_scopes = flow_def.get("scopes", {})
+                        existing_scopes.update(new_scopes)
+                        existing_definition["flows"][flow_name]["scopes"] = existing_scopes
+                    else:
+                        # If the flow didn't exist in the existing definition, add it
+                        existing_definition.setdefault("flows", {})[flow_name] = flow_def
+        else:
+            security_definitions[security_name] = security_definition
         operation_security.append({security_name: security_requirement.scopes})
     return security_definitions, operation_security
 

+class NestedModel(BaseModel):
+    foo: str
+
+class InputModel(BaseModel):
+    nested: NestedModel
+
+class OutputModel(BaseModel):
+    nested: NestedModel
+
+app = FastAPI()
+
+@app.post("/test", response_model=OutputModel)
+def test(input: InputModel):
+    return input
+
+openapi_schema = get_openapi(

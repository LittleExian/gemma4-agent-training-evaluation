+from rich.console import Console, ConsoleOptions, ConsoleDimensions
+from rich.padding import Padding
+from rich.segment import Segment
+
+def test_padding_width_overflow():
+    console = Console(width=10)
+    # max_width = 10, left = 6, right = 6. Total padding = 12 > 10.
+    padding = Padding("Hello", (0, 6, 0, 6))
+    
+    options = ConsoleOptions(
+        ConsoleDimensions(10, 10),
+        max_height=10,
+        legacy_windows=False,
+        min_width=10,
+        max_width=10,
+        is_terminal=False,
+        encoding="utf-8",
+    )
+    
+    output = list(padding.__rich_console__(console, options))
+    
+    print("Output segments (overflow):")
+    for i, segment in enumerate(output):
+        print(f"{i}: {repr(segment)}")
+    
+    current_line_width = 0
+    for segment in output:
+        if segment.text == "\n":
+            assert current_line_width <= 10
+            current_line_width = 0
+        else:
+            current_line_width += len(segment.text)
+    assert current_line_width <= 10
+    assert len(output) > 0
+
+def test_padding_width_exact():
+    console = Console(width=10)
+    # max_width = 10, left = 2, right = 2. Renderable = "Hello" (5). Total = 9.
+    padding = Padding("Hello", (0, 2, 0, 2))
+    
+    options = ConsoleOptions(
+        ConsoleDimensions(10, 10),
+        max_height=10,
+        legacy_windows=False,
+        min_width=10,
+        max_width=10,
+        is_terminal=False,
+        encoding="utf-8",
+    )
+    
+    output = list(padding.__rich_console__(console, options))
+    
+    print("Output segments (exact):")
+    for i, segment in enumerate(output):
+        print(f"{i}: {repr(segment)}")
+    
+    current_line_width = 0
+    for segment in output:
+        if segment.text == "\n":
+            assert current_line_width <= 10
+            current_line_width = 0
+        else:
+            current_line_width += len(segment.text)
+    assert current_line_width <= 10
+    assert len(output) > 0
+
+def test_padding_width_clamped():
+    console = Console(width=10)
+    # max_width = 10, left = 2, right = 2. Renderable = "Hello World" (11).
+    # render_options.max_width = 10 - 2 - 2 = 6.
+    # Renderable will be rendered with width 6.
+    padding = Padding("Hello World", (0, 2, 0, 2))
+    
+    options = ConsoleOptions(
+        ConsoleDimensions(10, 10),
+        max_height=10,
+        legacy_windows=False,
+        min_width=10,
+        max_width=10,
+        is_terminal=False,
+        encoding="utf-8",
+    )
+    
+    output = list(padding.__rich_console__(console, options))
+    
+    print("Output segments (clamped):")
+    for i, segment in enumerate(output):
+        print(f"{i}: {repr(segment)}")
+    
+    current_line_width = 0
+    for segment in output:
+        if segment.text == "\n":
+            assert current_line_width <= 10
+            current_line_width = 0
+        else:
+            current_line_width += len(segment.text)
+    assert current_line_width <= 10
+    assert len(output) > 0
+
+if __name__ == "__main__":
+    try:
+        test_padding_width_overflow()
+        test_padding_width_exact()
+        test_padding_width_clamped()
+        print("All tests passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        raise e

+from typing import Annotated, Literal, Union
+
+from fastapi import Body, FastAPI
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+
+class Cat(BaseModel):
+    pet_type: Literal["cat"]
+    meows: bool
+
+
+class Dog(BaseModel):
+    pet_type: Literal["dog"]
+    barks: float
+
+
+app = FastAPI()
+
+
+@app.post("/things/")
+def create_things(
+    things: Annotated[Union[Cat, Dog], Body(discriminator="pet_type")],
+):
+    return things
+
+
+client = TestClient(app)
+r = client.post("/things/", json={"pet_type": "cat", "meows": True})
+print("status:", r.status_code)
+print("body:", r.json())
+
+schema = app.openapi()
+import json
+
+print(json.dumps(schema["components"]["schemas"], indent=2))

@@ -0,0 +1,58 @@
+from typing import Annotated, Literal, Optional, Union
+
+from fastapi import Body, FastAPI
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+
+class Cat(BaseModel):
+    pet_type: Literal["cat"]
+    meows: bool
+
+
+class Dog(BaseModel):
+    pet_type: Literal["dog"]
+    barks: float
+
+
+app = FastAPI()
+
+
+@app.post("/multi/")
+def multi(
+    a: Annotated[Union[Cat, Dog], Body(discriminator="pet_type")],
+    b: int,
+):
+    return {"a": a, "b": b}
+
+
+@app.post("/embed/")
+def embed(
+    a: Annotated[Union[Cat, Dog], Body(discriminator="pet_type", embed=True)],
+):
+    return a
+
+
+@app.post("/opt/")
+def opt(
+    a: Annotated[Optional[Union[Cat, Dog]], Body(discriminator="pet_type")],
+):
+    return a
+
+
+client = TestClient(app)
+
+for path, payload in [
+    ("/multi/", {"a": {"pet_type": "cat", "meows": True}, "b": 1}),
+    ("/embed/", {"a": {"pet_type": "cat", "meows": True}}),
+    ("/opt/", {"pet_type": "cat", "meows": True}),
+]:
+    r = client.post(path, json=payload)
+    print(path, "->", r.status_code, r.json())
+
+import json
+
+schema = app.openapi()
+for p in ["/multi/", "/embed/", "/opt/"]:
+    print("=====", p)
+    print(json.dumps(schema["paths"][p]["post"]["requestBody"], indent=2))

@@ -0,0 +1,56 @@
+
+from fastapi import FastAPI
+from pydantic import BaseModel, computed_field
+from fastapi.testclient import TestClient
+import json
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+    @computed_field
+    @property
+    def total(self) -> float:
+        return self.price * 1.2
+
+@app.get("/item", response_model=Item)
+def get_item():
+    return Item(name="test", price=10.0)
+
+client = TestClient(app)
+
+def test_openapi_with_separate_input_output_schemas_true():
+    app.separate_input_output_schemas = True
+    app.openapi_schema = None
+    openapi_schema = app.openapi()
+    # In this case, Item should be in the schemas.
+    # Since it's a response model, it should use serialization mode.
+    # Computed fields should be present.
+    item_schema = openapi_schema["components"]["schemas"]["Item"]
+    assert "total" in item_schema["properties"], "Computed field 'total' should be present when separate_input_output_schemas=True"
+    print("Test separate_input_output_schemas=True passed")
+
+def test_openapi_with_separate_input_output_schemas_false():
+    app.separate_input_output_schemas = False
+    app.openapi_schema = None
+    openapi_schema = app.openapi()
+    # In this case, Item should be in the schemas.
+    # It should use validation mode (currently).
+    # Computed fields should be present (this is what we want to fix).
+    item_schema = openapi_schema["components"]["schemas"]["Item"]
+    assert "total" in item_schema["properties"], "Computed field 'total' should be present when separate_input_output_schemas=False"
+    print("Test separate_input_output_schemas=False passed")
+
+if __name__ == "__main__":
+    try:
+        test_openapi_with_separate_input_output_schemas_true()
+        test_openapi_with_separate_input_output_schemas_false()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

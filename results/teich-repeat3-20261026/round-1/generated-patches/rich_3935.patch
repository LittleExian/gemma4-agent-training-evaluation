diff --git a/repro_expand.py b/repro_expand.py
new file mode 100644
index 00000000..5f14a88e
--- /dev/null
+++ b/repro_expand.py
@@ -0,0 +1,28 @@
+from rich.console import Console
+from rich.padding import Padding
+
+def test_padding_expand():
+    console = Console(width=20)
+    renderable = "Hello"
+    # expand=True
+    padding = Padding(renderable, (1, 2, 1, 2), style="on blue", expand=True)
+    
+    # We use a custom console to capture the output
+    with console.capture() as capture:
+        console.print(padding)
+    
+    output = capture.get()
+    print(f"Output:\n{output!r}")
+    
+    # The output should have lines of width 20.
+    # The first line (top padding) should be 20 spaces.
+    # The second line (content) should be 20 spaces.
+    # The third line (bottom padding) should be 20 spaces.
+    
+    # Let's check the length of each line.
+    lines = output.splitlines()
+    for i, line in enumerate(lines):
+        print(f"Line {i}: length {len(line)}")
+
+if __name__ == "__main__":
+    test_padding_expand()

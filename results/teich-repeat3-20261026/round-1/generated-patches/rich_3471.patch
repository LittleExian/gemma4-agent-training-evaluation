--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,12 @@
+from rich.text import Text
+
+def test_append_tokens_content_none():
+    t = Text()
+    try:
+        t.append_tokens([(None, "bold")])
+        print("Success: append_tokens handled None content")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_append_tokens_content_none()

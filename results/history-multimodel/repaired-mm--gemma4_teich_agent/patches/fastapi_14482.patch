diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..fba2aef9
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,22 @@
+from fastapi.encoders import jsonable_encoder
+from pydantic import BaseModel, ConfigDict
+
+class ArbitraryType:
+    def __init__(self, value):
+        self.value = value
+    def __repr__(self):
+        return f"ArbitraryType({self.value})"
+
+class Model(BaseModel):
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+    item: ArbitraryType
+
+arbitrary_item = ArbitraryType(123)
+model = Model(item=arbitrary_item)
+
+try:
+    print(jsonable_encoder(model))
+except Exception as e:
+    print(f"Caught exception: {type(e).__name__}: {e}")
+    import traceback
+    traceback.print_exc()
diff --git a/search_string.py b/search_string.py
new file mode 100644
index 00000000..cb0844c4
--- /dev/null
+++ b/search_string.py
@@ -0,0 +1,20 @@
+import os
+
+search_string = "Unable to serialize unknown type"
+found = False
+
+for root, dirs, files in os.walk("fastapi"):
+    for file in files:
+        if file.endswith(".py"):
+            filepath = os.path.join(root, file)
+            try:
+                with open(filepath, "r", encoding="utf-8") as f:
+                    for i, line in enumerate(f, 1):
+                        if search_string in line:
+                            print(f"{filepath}:{i}: {line.strip()}")
+                            found = True
+            except Exception as e:
+                pass
+
+if not found:
+    print("Not found")

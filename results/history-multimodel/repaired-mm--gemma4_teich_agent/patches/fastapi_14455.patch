diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..f16582ba
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,39 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+import json
+
+app = FastAPI()
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def get_current_user_1(token: str = Security(oauth2_scheme, scopes=["scope1"])):
+    return token
+
+def get_current_user_2(token: str = Security(oauth2_scheme, scopes=["scope2"])):
+    return token
+
+@app.get("/route1", dependencies=[Depends(get_current_user_1)])
+def route1():
+    return {"message": "route1"}
+
+@app.get("/route2", dependencies=[Depends(get_current_user_2)])
+def route2():
+    return {"message": "route2"}
+
+if __name__ == "__main__":
+    schema = app.openapi()
+    security_schemes = schema.get("components", {}).get("securitySchemes", {})
+    
+    if not security_schemes:
+        print("No security schemes found!")
+        exit(1)
+        
+    scheme_name = list(security_schemes.keys())[0]
+    # OAuth2PasswordBearer uses 'password' flow
+    scopes = security_schemes[scheme_name]["flows"]["password"]["scopes"]
+    
+    print(f"Scheme name: {scheme_name}")
+    print(f"Scopes: {scopes}")
+    
+    assert "scope1" in scopes and "scope2" in scopes, f"Expected scope1 and scope2, got {scopes}"
+    print("Success!")

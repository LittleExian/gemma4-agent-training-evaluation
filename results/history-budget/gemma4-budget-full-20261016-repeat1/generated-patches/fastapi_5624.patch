@@ -0,0 +1,40 @@
+from fastapi import FastAPI, Security
+from fastapi.routing import APIRoute
+
+app = FastAPI()
+
+def dep_a():
+    pass
+
+def dep_b():
+    pass
+
+def dep_c():
+    pass
+
+def dep_root(
+    a = Security(dep_a, scopes=["a"]),
+):
+    return "root"
+
+# We need to make dep_a depend on dep_b and dep_c
+# Since we can't easily do that with the decorator, we'll use a function
+def dep_a_with_deps(
+    b = Security(dep_b, scopes=["b"]),
+    c = Security(dep_c, scopes=["c"]),
+):
+    return "a"
+
+@app.get("/")
+async def root(
+    a = Security(dep_a_with_deps, scopes=["a"]),
+):
+    return "root"
+
+for route in app.routes:
+    if isinstance(route, APIRoute):
+        dependant = route.dependant
+        for sub in dependant.dependencies:
+            print(f"Dependency {sub.call.__name__} scopes: {sub.security_scopes}")
+            for sub_sub in sub.dependencies:
+                print(f"  Sub-dependency {sub_sub.call.__name__} scopes: {sub_sub.security_scopes}")

--- /dev/null
+++ b/repro.py
@@ -0,0 +1,22 @@
+
+from rich.console import Console
+from rich.table import Table
+from rich.text import Text
+
+def test_highlight_add_row():
+    table = Table(highlight=True)
+    table.add_column("Col1")
+    table.add_row("Val1")
+    table.add_row("Val2", "Val3") # This should add a second column
+    
+    assert table.columns[0].highlight is True
+    assert table.columns[1].highlight is True
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_highlight_add_row()
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")

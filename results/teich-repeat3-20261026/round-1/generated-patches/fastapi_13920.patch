diff --git a/repro_get_model_fields.py b/repro_get_model_fields.py
new file mode 100644
index 00000000..0b010b78
--- /dev/null
+++ b/repro_get_model_fields.py
@@ -0,0 +1,52 @@
+import sys
+from typing import Annotated
+from pydantic import BaseModel
+from fastapi._compat import v2, shared
+
+# Mock TypeAliasType for Python < 3.12 if necessary, but we are on 3.12+
+if sys.version_info >= (3, 12):
+    from typing import TypeAliasType
+else:
+    # This is just for compatibility in case we run on < 3.12, 
+    # but the fix is specifically for 3.12+
+    class TypeAliasType:
+        def __init__(self, name, value):
+            self.name = name
+            self.__value__ = value
+        def __repr__(self):
+            return f"TypeAliasType({self.name}, {self.__value__})"
+
+class MyModel(BaseModel):
+    x: int
+
+# Create a type alias for MyModel
+# In Python 3.12: type MyModelAlias = MyModel
+# Using TypeAliasType directly for compatibility with the test script
+MyModelAlias = TypeAliasType("MyModelAlias", MyModel)
+
+class ContainerModel(BaseModel):
+    field: MyModelAlias
+
+def test_get_model_fields():
+    fields = v2.get_model_fields(ContainerModel)
+    # The field 'field' should have its type resolved to MyModel
+    # and therefore it should have model_config = None (since it's a BaseModel)
+    # Wait, let's check the logic in get_model_fields:
+    # if lenient_issubclass(type_, (BaseModel, dict)) or is_dataclass(type_):
+    #     model_config = None
+    # else:
+    #     model_config = model.model_config
+    
+    # Let's see what we get
+    for f in fields:
+        print(f"Field {f.name}: config={f.config}")
+        if f.name == "field":
+            assert f.config is None, f"Field 'field' should have config None, got {f.config}"
+
+if __name__ == "__main__":
+    try:
+        test_get_model_fields()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        sys.exit(1)
diff --git a/reproduction.py b/reproduction.py
new file mode 100644
index 00000000..5ff1eb54
--- /dev/null
+++ b/reproduction.py
@@ -0,0 +1,44 @@
+import sys
+from typing import Union, get_origin, get_args
+from fastapi._compat import shared
+from fastapi._compat import v2
+from pydantic import BaseModel
+from pydantic.fields import FieldInfo
+
+# For Python 3.12+
+if sys.version_info >= (3, 12):
+    type MyAlias = list[int]
+    type MyModelAlias = BaseModel
+    
+    print(f"MyAlias: {MyAlias}, origin: {get_origin(MyAlias)}")
+    print(f"Resolved MyAlias: {shared.resolve_type_alias(MyAlias)}, origin: {get_origin(shared.resolve_type_alias(MyAlias))}")
+    
+    # Test get_flat_models_from_field
+    from fastapi._compat.v2 import get_flat_models_from_field, ModelField
+    
+    # Create a ModelField with MyModelAlias
+    field_info = FieldInfo(annotation=MyModelAlias)
+    field = ModelField(field_info=field_info, name="test_field")
+    
+    known_models = set()
+    get_flat_models_from_field(field, known_models)
+    print(f"Known models: {known_models}")
+    assert BaseModel in known_models
+    
+    # Test with MyAlias
+    field_info_alias = FieldInfo(annotation=MyAlias)
+    field_alias = ModelField(field_info=field_info_alias, name="test_alias_field")
+    known_models_alias = set()
+    get_flat_models_from_field(field_alias, known_models_alias)
+    print(f"Known models alias: {known_models_alias}")
+    
+    # Test with a model alias in a list
+    type MyModelListAlias = list[MyModelAlias]
+    field_info_list = FieldInfo(annotation=MyModelListAlias)
+    field_list = ModelField(field_info=field_info_list, name="test_list_field")
+    known_models_list = set()
+    get_flat_models_from_field(field_list, known_models_list)
+    print(f"Known models list: {known_models_list}")
+    assert BaseModel in known_models_list
+else:
+    print("Not running on Python 3.12+")

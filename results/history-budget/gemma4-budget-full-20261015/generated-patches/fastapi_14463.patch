+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+from fastapi.openapi.utils import get_openapi
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+openapi_schema = get_openapi(title=app.title, version=app.version, description=app.description, routes=app.routes)
+responses_500 = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]
+any_of = responses_500["content"]["application/json"]["schema"]["anyOf"]
+
+print(f"Number of refs in anyOf: {len(any_of)}")
+print(json.dumps(any_of, indent=2))
+
+assert len(any_of) == 2, f"Expected 2 refs, got {len(any_of)}"

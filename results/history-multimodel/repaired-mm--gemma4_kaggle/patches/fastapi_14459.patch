@@ -0,0 +1,28 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+import json
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def parent_with_scopes(token: str = Security(oauth2_scheme, scopes=["scope1"])):
+    return token
+
+app = FastAPI()
+
+@app.get("/")
+def root(
+    token: str = Security(oauth2_scheme, scopes=["scope1"]),
+    parent: str = Depends(parent_with_scopes),
+):
+    return {"token": token, "parent": parent}
+
+@app.get("/reversed")
+def root_reversed(
+    token: str = Depends(oauth2_scheme),
+    parent: str = Depends(parent_with_scopes),
+):
+    return {"token": token, "parent": parent}
+
+if __name__ == "__main__":
+    openapi_schema = app.openapi()
+    print(json.dumps(openapi_schema, indent=2))

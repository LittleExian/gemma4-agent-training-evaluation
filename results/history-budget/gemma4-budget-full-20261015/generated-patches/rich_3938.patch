@@ -0,0 +1,13 @@
+import io
+from rich.console import Console
+from rich.text import Text
+
+def test_soft_wrap_background():
+    console = Console(file=io.StringIO(), width=10, soft_wrap=True, force_terminal=True)
+    text = Text("This is a long line with background", style="on blue")
+    console.print(text)
+    output = console.file.getvalue()
+    print(f"Output: {repr(output)}")
+
+if __name__ == "__main__":
+    test_soft_wrap_background()

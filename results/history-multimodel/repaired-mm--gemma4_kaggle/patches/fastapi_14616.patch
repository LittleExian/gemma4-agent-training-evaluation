diff --git a/reproduce_fastapi.py b/reproduce_fastapi.py
new file mode 100644
index 00000000..b8f167b8
--- /dev/null
+++ b/reproduce_fastapi.py
@@ -0,0 +1,30 @@
+from fastapi import FastAPI, Form, UploadFile, File
+from fastapi.testclient import TestClient
+from typing import Annotated, List
+from pydantic import Json
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    file: UploadFile = File(...),
+    tags: Annotated[Json[List[str]], Form()]
+):
+    return {"file": file.filename, "tags": tags}
+
+client = TestClient(app)
+
+def test_upload():
+    # We send tags as a JSON string in a form field
+    files = {"file": ("test.txt", b"content")}
+    data = {"tags": '["abc", "def"]'}
+    
+    response = client.post("/upload", data=data, files=files)
+    print(f"Status Code: {response.status_code}")
+    print(f"Response Body: {response.json()}")
+
+if __name__ == "__main__":
+    try:
+        test_upload()
+    except Exception as e:
+        print(f"Error: {e}")
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..7233a8c3
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,13 @@
+from typing import List, Annotated
+from pydantic import Json, Field
+from pydantic.fields import FieldInfo
+from fastapi._compat.v2 import ModelField, is_sequence_field
+from fastapi import params
+
+# Pydantic v2 FieldInfo with Annotated
+# In FastAPI, the annotation passed to ModelField is often the one from the function signature
+annotation = Annotated[Json[List[str]], params.Form()]
+field_info = FieldInfo(annotation=annotation)
+model_field = ModelField(field_info=field_info, name="items")
+
+print(f"Is Annotated[Json[List[str]], Form()] a sequence field? {is_sequence_field(model_field)}")
diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..51b62c4f
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,30 @@
+from typing import List, Annotated
+from pydantic import Json
+from fastapi._compat.shared import field_annotation_is_sequence
+
+def test_json_sequence():
+    # This is the case that was failing
+    annotation = Annotated[List[str], Json]
+    result = field_annotation_is_sequence(annotation)
+    print(f"Annotated[List[str], Json] -> {result}")
+    assert result is False, "Should be False for Json[List[str]]"
+
+    # This should still be True
+    annotation_list = List[str]
+    result_list = field_annotation_is_sequence(annotation_list)
+    print(f"List[str] -> {result_list}")
+    assert result_list is True, "Should be True for List[str]"
+
+    # This should still be True
+    annotation_annotated_list = Annotated[List[str], "some metadata"]
+    result_annotated_list = field_annotation_is_sequence(annotation_annotated_list)
+    print(f"Annotated[List[str], 'some metadata'] -> {result_annotated_list}")
+    assert result_annotated_list is True, "Should be True for Annotated[List[str], ...]"
+
+if __name__ == "__main__":
+    try:
+        test_json_sequence()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

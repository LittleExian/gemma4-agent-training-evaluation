+def iter_graphemes(text: str) -> Iterator[str]:
+    """Split text into grapheme clusters.
+
+    This is a simplified implementation of Unicode TR #29.
+    """
+    if not text:
+        return
+
+    grapheme = ""
+    for char in text:
+        if (unicodedata.category(char).startswith("M") or char == "\u200d") and grapheme:
+            grapheme += char
+        elif "\U0001F1E6" <= char <= "\U0001F1FF" and grapheme and "\U0001F1E6" <= grapheme[-1] <= "\U0001F1FF":
+            grapheme += char
+        else:
+            if grapheme:
+                yield grapheme
+            grapheme = char
+    if grapheme:
+        yield grapheme
+

index 00000000..cc99971f
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,29 @@
+
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from typing import Optional
+import pytest
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(q: Optional[str] = Form(None)):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_empty_string_as_none():
+    # When q is sent as an empty string, it should be interpreted as None if default is None
+    response = client.post("/test", data={"q": ""})
+    assert response.status_code == 200
+    assert response.json() == {"q": None}
+
+if __name__ == "__main__":
+    try:
+        test_empty_string_as_none()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

@@ -0,0 +1,13 @@
+from rich.console import Console
+from rich.markdown import Markdown
+
+console = Console(record=True)
+markdown_text = "| Col 1 | Col 2 |\n| --- | --- |\n| Cell 1 | Cell 2 with **bold** and [link](http://example.com) |"
+markdown = Markdown(markdown_text)
+console.print(markdown)
+
+output = console.export_text()
+print(output)
+
+# We expect to see both "bold" and "link" in the output for Cell 2.
+assert "Cell 2 with bold and link" in output

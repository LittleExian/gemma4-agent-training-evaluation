--- /dev/null
+++ b/repro.py
@@ -0,0 +1,14 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+app = FastAPI()
+
+class Model(BaseModel):
+    b: bytes
+
+@app.post("/test")
+def test(m: Model):
+    return m
+
+print(json.dumps(app.openapi(), indent=2))

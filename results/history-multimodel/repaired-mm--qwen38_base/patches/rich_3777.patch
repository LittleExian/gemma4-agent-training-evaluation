diff --git a/rich/console.py b/rich/console.py
index 5929fb1c..1c4e02c1 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -731,11 +731,7 @@ class Console:
             if no_color is not None
             else self._environ.get("NO_COLOR", "") != ""
         )
-        self.is_interactive = (
-            (self.is_terminal and not self.is_dumb_terminal)
-            if force_interactive is None
-            else force_interactive
-        )
+        self._force_interactive = force_interactive
 
         self._record_buffer_lock = threading.RLock()
         self._thread_locals = ConsoleThreadLocals(
@@ -983,6 +979,27 @@ class Console:
         is_dumb = _term.lower() in ("dumb", "unknown")
         return self.is_terminal and is_dumb
 
+    @property
+    def is_interactive(self) -> bool:
+        """Check if the console is interactive.
+
+        Returns:
+            bool: True if the console is interactive, otherwise False.
+        """
+        if self._force_interactive is not None:
+            return self._force_interactive
+
+        tty_interactive = self._environ.get("TTY_INTERACTIVE", "")
+        # 0 indicates device is not interactive
+        if tty_interactive == "0":
+            return False
+        # 1 indicates device is interactive
+        if tty_interactive == "1":
+            return True
+
+        # Any other value defaults to auto detect
+        return self.is_terminal and not self.is_dumb_terminal
+
     @property
     def options(self) -> ConsoleOptions:
         """Get default console options."""

@@ -0,0 +1,44 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+openapi_schema = app.openapi()
+responses_500_route1 = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]["anyOf"]
+print(f"Route 1 anyOf length: {len(responses_500_route1)}")
+print(json.dumps(responses_500_route1, indent=2))
+
+# Check if they are duplicated
+# For 3 routes, if it's duplicated, we expect 3 * 2 = 6 elements in anyOf
+if len(responses_500_route1) > 2:
+    print("BUG REPRODUCED: anyOf contains duplicate refs")
+else:
+    print("BUG NOT REPRODUCED")

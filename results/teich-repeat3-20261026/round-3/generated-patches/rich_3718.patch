+from rich.console import Console
+from rich.panel import Panel
+from rich.text import Text
+import sys
+
+def get_ansi(renderable, style=None, border_style=None, title=None):
+    console = Console(force_terminal=True, width=40, color_system="standard")
+    if title is not None:
+        panel = Panel(renderable, style=style, border_style=border_style, title=title)
+    else:
+        panel = Panel(renderable, style=style, border_style=border_style)
+    
+    # We want to capture the ANSI codes.
+    # We can use a custom console or just capture the output.
+    # But the easiest is to use the console's render method.
+    
+    # To capture ANSI codes, we can use a custom console that doesn't strip them.
+    # Or just use the console's render method and then convert to string.
+    
+    # Actually, we can just use the console's print method and capture stdout.
+    # But we need to make sure ANSI codes are enabled.
+    
+    # Let's use a simpler way:
+    # We can use the console's render method and then iterate over the segments.
+    
+    segments = console.render(panel)
+    
+    # Now we convert segments to ANSI.
+    # We can use the console's _get_ansi_code method if it exists, or just use the console's print.
+    
+    # Let's just use the console's print and capture stdout.
+    # We need to make sure the console is configured to use ANSI.
+    
+    # Let's try this:
+    import io
+    from contextlib import redirect_stdout
+    
+    f = io.StringIO()
+    with redirect_stdout(f):
+        console.print(panel)
+    
+    return f.getvalue()
+
+# Case 1: style="on red", border_style="none", title="Title 1"
+print("Case 1:")
+print(repr(get_ansi("Hello", style="on red", border_style="none", title="Title 1")))
+
+# Case 2: style="on red", border_style="bold white", title="Title 2"
+print("\nCase 2:")
+print(repr(get_ansi("Hello", style="on red", border_style="bold white", title="Title 2")))
+
+# Case 3: style="on red", border_style="bold white", title=Text("Title 3", style="yellow")
+print("\nCase 3:")
+print(repr(get_ansi("Hello", style="on red", border_style="bold white", title=Text("Title 3", style="yellow"))))

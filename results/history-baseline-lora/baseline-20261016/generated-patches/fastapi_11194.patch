+from fastapi import FastAPI, Form, File, UploadFile
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/test_order_1")
+async def test_order_1(a: str = Form(...), b: bytes = File(...)):
+    return {"a": a, "b_len": len(b)}
+
+@app.post("/test_order_2")
+async def test_order_2(b: bytes = File(...), a: str = Form(...)):
+    return {"a": a, "b_len": len(b)}
+
+client = TestClient(app)
+
+def test_order_1():
+    # File after Form - this should fail currently
+    response = client.post(
+        "/test_order_1",
+        data={"a": "hello"},
+        files={"b": ("test.txt", b"world")}
+    )
+    print(f"Order 1 response: {response.status_code} {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"a": "hello", "b_len": 5}
+
+def test_order_2():
+    # Form after File - this should work
+    response = client.post(
+        "/test_order_2",
+        data={"a": "hello"},
+        files={"b": ("test.txt", b"world")}
+    )
+    print(f"Order 2 response: {response.status_code} {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"a": "hello", "b_len": 5}
+
+if __name__ == "__main__":
+    try:
+        test_order_1()
+        print("test_order_1 passed")
+    except Exception as e:
+        print(f"test_order_1 failed: {e}")
+
+    try:
+        test_order_2()
+        print("test_order_2 passed")
+    except Exception as e:
+        print(f"test_order_2 failed: {e}")

+\"\"\"Automate release preparation: update version and release notes.\"\"\"
+
+import sys
+import re
+from pathlib import Path
+
+
+def main() -> None:
+    if len(sys.argv) < 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+
+    version = sys.argv[1]
+
+    # Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(content)
+    print(f"Updated fastapi/__init__.py to version {version}")
+
+    # Update docs/en/docs/release-notes.md
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    content = release_notes_file.read_text()
+
+    if f"## {version}" in content:
+        print(f"Version {version} already exists in release-notes.md")
+    else:
+        lines = content.splitlines()
+        header_index = -1
+        for i, line in enumerate(lines):
+            if line.startswith("# Release Notes"):
+                header_index = i
+                break
+        
+        if header_index != -1:
+            lines.insert(header_index + 1, f"## {version}")
+            release_notes_file.write_text("\n".join(lines) + "\n")
+            print(f"Added {version} to docs/en/docs/release-notes.md")
+        else:
+            print("Could not find # Release Notes header in release-notes.md")
+
+
+if __name__ == "__main__":
+    main()

index 00000000..55bc8231
--- /dev/null
+++ b/search_model_dump.py
@@ -0,0 +1,11 @@
+
+import os
+
+for root, dirs, files in os.walk("fastapi"):
+    for file in files:
+        if file.endswith(".py"):
+            path = os.path.join(root, file)
+            with open(path, "r") as f:
+                for i, line in enumerate(f):
+                    if "_model_dump" in line:
+                        print(f"{path}:{i+1}: {line.strip()}")

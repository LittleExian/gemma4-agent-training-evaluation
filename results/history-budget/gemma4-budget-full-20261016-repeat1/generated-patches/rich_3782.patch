+from rich.console import Console
+from rich.syntax import Syntax
+
+console = Console(force_terminal=True, width=40)
+
+# Case 1: No padding
+syntax_no_padding = Syntax("print('hello')", "python", background_color="blue", padding=0)
+print("--- No Padding ---")
+console.print(syntax_no_padding)
+
+# Case 2: With padding
+syntax_padding = Syntax("print('hello')", "python", background_color="blue", padding=1)
+print("\n--- With Padding ---")
+console.print(syntax_padding)

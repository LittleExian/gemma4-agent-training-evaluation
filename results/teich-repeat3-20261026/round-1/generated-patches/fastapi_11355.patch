@@ -0,0 +1,46 @@
+from __future__ import annotations
+from fastapi import FastAPI, Depends
+from fastapi.dependencies.utils import get_typed_return_annotation, get_typed_signature
+import inspect
+
+def test_forward_ref_return():
+    def my_func() -> "MyClass":
+        return MyClass()
+    
+    class MyClass:
+        pass
+
+    # This should resolve "MyClass" to MyClass
+    annotation = get_typed_return_annotation(my_func)
+    print(f"Return annotation: {annotation}")
+    assert annotation is MyClass
+
+def test_forward_ref_param():
+    def my_func(param: "MyClass"):
+        pass
+    
+    class MyClass:
+        pass
+
+    # This should resolve "MyClass" to MyClass
+    signature = get_typed_signature(my_func)
+    param = signature.parameters["param"]
+    print(f"Param annotation: {param.annotation}")
+    assert param.annotation is MyClass
+
+if __name__ == "__main__":
+    try:
+        test_forward_ref_return()
+        print("test_forward_ref_return passed")
+    except Exception as e:
+        print(f"test_forward_ref_return failed: {e}")
+        import traceback
+        traceback.print_exc()
+
+    try:
+        test_forward_ref_param()
+        print("test_forward_ref_param passed")
+    except Exception as e:
+        print(f"test_forward_ref_param failed: {e}")
+        import traceback
+        traceback.print_exc()

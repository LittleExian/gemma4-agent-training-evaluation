--- /dev/null
+++ b/repro.py
@@ -0,0 +1,43 @@
+from fastapi import Depends, FastAPI, Security
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+def get_scopes(security_scopes: SecurityScopes):
+    return security_scopes.scopes
+
+def dep_a(scopes: List[str] = Security(get_scopes, scopes=["read"])):
+    return scopes
+
+def dep_b(scopes: List[str] = Security(get_scopes, scopes=["write"])):
+    return scopes
+
+@app.get("/test")
+def read_root(
+    a: List[str] = Depends(dep_a),
+    b: List[str] = Depends(dep_b)
+):
+    return {"a": a, "b": b}
+
+client = TestClient(app)
+
+def test_scopes():
+    response = client.get("/test")
+    print(f"Response: {response.json()}")
+    # Both a and b should see both scopes if they are aggregated
+    # However, in the current implementation, dep_a only sees ["read"] and dep_b only sees ["write"]
+    # because they are siblings.
+    # With the fix, both should see ["read", "write"] (order might vary)
+    assert set(response.json()["a"]) == {"read", "write"}
+    assert set(response.json()["b"]) == {"read", "write"}
+
+if __name__ == "__main__":
+    try:
+        test_scopes()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..d7d5940b
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,44 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import SecurityScopes, OAuth2PasswordBearer
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def dep_shared(scopes: SecurityScopes):
+    return scopes.scopes
+
+def dep1(scopes: SecurityScopes, shared=Depends(dep_shared)):
+    return {"scopes": scopes.scopes, "shared": shared}
+
+def dep2(scopes: SecurityScopes, shared=Depends(dep_shared)):
+    return {"scopes": scopes.scopes, "shared": shared}
+
+@app.get("/")
+def root(
+    d1=Security(dep1, scopes=["scope1"]),
+    d2=Security(dep2, scopes=["scope2"]),
+):
+    return {"d1": d1, "d2": d2}
+
+client = TestClient(app)
+
+def test_security_scopes_propagation():
+    # Provide a token to avoid 401
+    response = client.get("/", headers={"Authorization": "Bearer token"})
+    assert response.status_code == 200
+    data = response.json()
+    
+    # Both d1 and d2 should have both scopes
+    # and dep_shared should also have both scopes
+    expected_scopes = ["scope1", "scope2"]
+    
+    # The order might be different, so we use sets
+    assert set(data["d1"]["scopes"]) == set(expected_scopes)
+    assert set(data["d1"]["shared"]) == set(expected_scopes)
+    assert set(data["d2"]["scopes"]) == set(expected_scopes)
+    assert set(data["d2"]["shared"]) == set(expected_scopes)
+
+if __name__ == "__main__":
+    test_security_scopes_propagation()
+    print("Test passed!")

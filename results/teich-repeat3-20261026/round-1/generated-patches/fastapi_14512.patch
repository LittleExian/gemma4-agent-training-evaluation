@@ -0,0 +1,37 @@
+
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+from fastapi import FastAPI, Body
+import json
+
+class Cat(BaseModel):
+    type: Literal["cat"]
+    meows: bool
+
+class Dog(BaseModel):
+    type: Literal["dog"]
+    barks: bool
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Pet, Body()]):
+    return pet
+
+def test_openapi_schema():
+    schema = app.openapi()
+    schema_str = json.dumps(schema)
+    print(schema_str)
+    assert '\"discriminator\": {\"propertyName\": \"type\"}' in schema_str
+
+if __name__ == "__main__":
+    try:
+        test_openapi_schema()
+        print("Success!")
+    except Exception as e:
+        print(f"Failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

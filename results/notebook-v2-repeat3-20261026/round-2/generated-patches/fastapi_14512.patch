+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+import json
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Annotated[Union[Cat, Dog], Field(discriminator="kind"), Body()]):
+    return data
+
+print(json.dumps(app.openapi(), indent=2))

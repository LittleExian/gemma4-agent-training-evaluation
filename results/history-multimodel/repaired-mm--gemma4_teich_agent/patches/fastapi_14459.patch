--- /dev/null
+++ b/repro.py
@@ -0,0 +1,34 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def dep2_func(token: str = Depends(oauth2_scheme)):
+    return token
+
+def dep1_func(token: str = Depends(dep2_func)):
+    return token
+
+def dep3_func(token: str = Depends(dep2_func)):
+    return token
+
+@app.get("/read", dependencies=[Security(dep1_func, scopes=["read"])])
+async def read():
+    return {"message": "read"}
+
+@app.get("/write", dependencies=[Security(dep3_func, scopes=["write"])])
+async def write():
+    return {"message": "write"}
+
+# We need to trigger OpenAPI generation
+openapi_schema = get_openapi(
+    title=app.title,
+    version=app.version,
+    openapi_version=app.openapi_version,
+    routes=app.routes,
+)
+
+import json
+print(json.dumps(openapi_schema, indent=2))

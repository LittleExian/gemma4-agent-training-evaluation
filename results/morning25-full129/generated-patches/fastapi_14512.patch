@@ -0,0 +1,41 @@
+
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+from typing import Annotated, Union, Literal
+import pytest
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    type: Literal["cat"]
+    meow: str
+
+class Dog(BaseModel):
+    type: Literal["dog"]
+    bark: str
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Union[Cat, Dog], Body(discriminator="type")]):
+    return pet
+
+client = TestClient(app)
+
+def test_tagged_union_body():
+    # Test Cat
+    response = client.post("/pet", json={"type": "cat", "meow": "meow"})
+    assert response.status_code == 200
+    assert response.json() == {"type": "cat", "meow": "meow"}
+
+    # Test Dog
+    response = client.post("/pet", json={"type": "dog", "bark": "bark"})
+    assert response.status_code == 200
+    assert response.json() == {"type": "dog", "bark": "bark"}
+
+    # Test invalid type
+    response = client.post("/pet", json={"type": "bird", "chirp": "chirp"})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    test_tagged_union_body()
+    print("Tests passed!")

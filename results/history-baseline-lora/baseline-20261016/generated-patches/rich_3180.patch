+from rich.console import Console
+from rich._wrap import divide_line
+
+def test_wrap():
+    text = "abcdefgh你好ijklmn"
+    width = 4
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+    
+    # Let's see how it's actually wrapped
+    # In rich, the divides are used to split the text.
+    lines = []
+    last = 0
+    for d in divides:
+        lines.append(text[last:d])
+        last = d
+    lines.append(text[last:])
+    print(f"Lines: {lines}")
+
+test_wrap()

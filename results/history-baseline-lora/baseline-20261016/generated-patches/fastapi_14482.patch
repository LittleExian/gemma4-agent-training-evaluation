+++ b/reproduce_issue.py
@@ -0,0 +1,32 @@
+from fastapi.encoders import jsonable_encoder
+from pydantic import BaseModel, ConfigDict
+
+class ArbitraryType:
+    def __init__(self):
+        self.x = 1
+    def __repr__(self):
+        return "ArbitraryType()"
+
+class MyModel(BaseModel):
+    foo: ArbitraryType
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+
+model = MyModel(foo=ArbitraryType())
+
+print("Testing model_dump(mode='json')...")
+try:
+    print(model.model_dump(mode="json"))
+except Exception as e:
+    print(f"model_dump(mode='json') failed: {e}")
+
+print("\nTesting model_dump(mode='python')...")
+try:
+    print(model.model_dump(mode="python"))
+except Exception as e:
+    print(f"model_dump(mode='python') failed: {e}")
+
+print("\nTesting jsonable_encoder...")
+try:
+    print(jsonable_encoder(model))
+except Exception as e:
+    print(f"jsonable_encoder failed: {e}")

diff --git a/verify_sse.py b/verify_sse.py
new file mode 100644
index 000000000..1aeca09ab
--- /dev/null
+++ b/verify_sse.py
@@ -0,0 +1,48 @@
+from fastapi.sse import ServerSentEvent
+from pydantic import ValidationError
+import pytest
+
+def test_sse_id_newline():
+    try:
+        ServerSentEvent(id="line1\nline2")
+    except ValidationError as e:
+        assert "SSE 'id' must not contain newlines" in str(e)
+        return
+    pytest.fail("Should have raised ValidationError for newline in id")
+
+def test_sse_event_newline():
+    try:
+        ServerSentEvent(event="line1\nline2")
+    except ValidationError as e:
+        assert "SSE 'event' must not contain newlines" in str(e)
+        return
+    pytest.fail("Should have raised ValidationError for newline in event")
+
+def test_sse_id_null():
+    try:
+        ServerSentEvent(id="null\0char")
+    except ValidationError as e:
+        assert "SSE 'id' must not contain null characters" in str(e)
+        return
+    pytest.fail("Should have raised ValidationError for null character in id")
+
+def test_sse_valid():
+    try:
+        ServerSentEvent(data="hello", event="greeting", id="1")
+    except ValidationError as e:
+        pytest.fail(f"Should not have raised ValidationError: {e}")
+
+if __name__ == "__main__":
+    try:
+        test_sse_id_newline()
+        print("test_sse_id_newline passed")
+        test_sse_event_newline()
+        print("test_sse_event_newline passed")
+        test_sse_id_null()
+        print("test_sse_id_null passed")
+        test_sse_valid()
+        print("test_sse_valid passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

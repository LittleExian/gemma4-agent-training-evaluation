+++ b/repro.py
@@ -0,0 +1,50 @@
+from fastapi import FastAPI
+from pydantic import BaseModel, computed_field
+from fastapi.openapi.utils import get_openapi
+import json
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+    @computed_field
+    @property
+    def total(self) -> float:
+        return self.price * 1.1
+
+@app.get("/items", response_model=Item)
+def read_item():
+    return Item(name="test", price=10.0)
+
+# Test with separate_input_output_schemas=False
+openapi_schema_false = get_openapi(
+    title="Test API",
+    version="1.0.0",
+    routes=app.routes,
+    separate_input_output_schemas=False,
+)
+
+# Test with separate_input_output_schemas=True
+openapi_schema_true = get_openapi(
+    title="Test API",
+    version="1.0.0",
+    routes=app.routes,
+    separate_input_output_schemas=True,
+)
+
+def check_computed_field(schema, schema_name):
+    try:
+        properties = schema["components"]["schemas"][schema_name]["properties"]
+        return "total" in properties
+    except KeyError:
+        return False
+
+print(f"Computed field present with separate_input_output_schemas=False: {check_computed_field(openapi_schema_false, 'Item')}")
+print(f"Computed field present with separate_input_output_schemas=True: {check_computed_field(openapi_schema_true, 'Item')}")
+
+if not check_computed_field(openapi_schema_false, 'Item') and check_computed_field(openapi_schema_true, 'Item'):
+    print("BUG REPRODUCED")
+else:
+    print("BUG NOT REPRODUCED")

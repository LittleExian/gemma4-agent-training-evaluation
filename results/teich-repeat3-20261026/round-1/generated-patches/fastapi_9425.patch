@@ -0,0 +1,44 @@
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/", status_code=204)
+def route() -> "None":
+    return None
+
+@app.get("/int", status_code=200)
+def route_int() -> "int":
+    return 1
+
+@app.get("/none", status_code=204)
+def route_none() -> None:
+    return None
+
+client = TestClient(app)
+
+def test_route():
+    response = client.get("/")
+    assert response.status_code == 204
+    assert response.text == ""
+
+def test_route_int():
+    response = client.get("/int")
+    assert response.status_code == 200
+    assert response.json() == 1
+
+def test_route_none():
+    response = client.get("/none")
+    assert response.status_code == 204
+    assert response.text == ""
+
+if __name__ == "__main__":
+    try:
+        test_route()
+        test_route_int()
+        test_route_none()
+        print("Tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()

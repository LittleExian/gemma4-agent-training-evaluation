+def get_unwrapped_callables(func: Any) -> list[Any]:
+    """
+    Recursively extract all callables in the chain of wrappers and partials.
+    """
+    callables = [func]
+    while True:
+        current = callables[-1]
+        # Handle functools.partial
+        if isinstance(current, partial):
+            # The actual function being wrapped
+            func_to_unwrap = current.func
+            if func_to_unwrap != current:
+                callables.append(func_to_unwrap)
+            else:
+                break
+        # Handle functools.wraps (__wrapped__)
+        elif hasattr(current, "__wrapped__"):
+            wrapped = current.__wrapped__
+            if wrapped != current:
+                callables.append(wrapped)
+            else:
+                break
+        else:
+            break
+    return callables
+
+
+def is_async_callable(func: Any) -> bool:
+    """
+    Check if any callable in the chain is asynchronous.
+    """
+    for callable_ in get_unwrapped_callables(func):
+        if iscoroutinefunction(callable_):
+            return True
+    return False
+
+
+def is_async_gen_callable(func: Any) -> bool:
+    """
+    Check if any callable in the chain is an async generator.
+    """
+    for callable_ in get_unwrapped_callables(func):
+        if inspect.isasyncgenfunction(callable_):
+            return True
+    return False
+
+
+def is_gen_callable(func: Any) -> bool:
+    """
+    Check if any callable in the chain is a generator.
+    """
+    for callable_ in get_unwrapped_callables(func):
+        if inspect.isgeneratorfunction(callable_):
+            return True
+    return False

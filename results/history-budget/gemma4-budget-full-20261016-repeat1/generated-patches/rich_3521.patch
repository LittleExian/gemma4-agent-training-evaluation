+from rich.segment import Segment
+from rich.cells import cell_len
+
+def test():
+    # \u200B is a zero-width space
+    text = "A\u200BB"
+    # cell_len("A") = 1
+    # cell_len("\u200B") = 0
+    # cell_len("B") = 1
+    # Total cell_length = 2
+    
+    seg = Segment(text)
+    print(f"Text: {text}, cell_length: {seg.cell_length}")
+    
+    # Split at cut = 1
+    left, right = seg.split_cells(1)
+    print(f"Split at 1: left='{left.text}', right='{right.text}'")
+    print(f"left cell_len: {cell_len(left.text)}, right cell_len: {cell_len(right.text)}")
+
+if __name__ == "__main__":
+    test()

@@ -0,0 +1,46 @@
+from fastapi import FastAPI, Security, Depends
+from fastapi.security import OAuth2
+from fastapi.testclient import TestClient
+import json
+
+app = FastAPI()
+
+oauth2_read = OAuth2(
+    flows={"password": {"tokenUrl": "token", "scopes": {"read": "read"}}},
+    scheme_name="oauth2_scheme"
+)
+
+oauth2_write = OAuth2(
+    flows={"password": {"tokenUrl": "token", "scopes": {"write": "write"}}},
+    scheme_name="oauth2_scheme"
+)
+
+@app.get("/read")
+def read(token: str = Security(oauth2_read, scopes=["read"])):
+    return {"message": "read"}
+
+@app.get("/write")
+def write(token: str = Security(oauth2_write, scopes=["write"])):
+    return {"message": "write"}
+
+client = TestClient(app)
+
+def test_openapi_security_schemes():
+    openapi_schema = app.openapi()
+    security_schemes = openapi_schema["components"]["securitySchemes"]
+    
+    assert "oauth2_scheme" in security_schemes
+    scopes = security_schemes["oauth2_scheme"]["flows"]["password"]["scopes"]
+    print(f"Scopes: {scopes}")
+    assert "read" in scopes
+    assert "write" in scopes
+
+if __name__ == "__main__":
+    try:
+        test_openapi_security_schemes()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

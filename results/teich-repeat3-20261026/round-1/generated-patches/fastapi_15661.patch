+#!/usr/bin/env python3
+import subprocess
+import sys
+
+def run(cmd: str) -> None:
+    print(f"Running: {cmd}")
+    subprocess.run(cmd, shell=True, check=True)
+
+def main() -> None:
+    try:
+        run("./scripts/format.sh")
+        run("./scripts/lint.sh")
+        run("./scripts/test.sh")
+        run("python scripts/add_latest_release_date.py")
+        print("Release preparation completed successfully!")
+    except subprocess.CalledProcessError as e:
+        print(f"Error during release preparation: {e}", file=sys.stderr)
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()

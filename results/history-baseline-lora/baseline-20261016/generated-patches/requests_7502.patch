diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..6a0eeb6c
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,39 @@
+import requests
+from requests.models import PreparedRequest
+
+class FileWrapper:
+    def __getattr__(self, name):
+        if name == 'read':
+            return lambda length=None: b"file content"
+        raise AttributeError(name)
+
+def test_encode_files_with_wrapper():
+    files = {'file': ('test.txt', FileWrapper())}
+    # We can use a PreparedRequest object to call _encode_files
+    req = PreparedRequest()
+    # _encode_files is a method of PreparedRequest
+    body, content_type = req._encode_files(files, None)
+    assert b"file content" in body
+    print("test_encode_files_with_wrapper passed")
+
+def test_encode_params_with_wrapper():
+    data = FileWrapper()
+    # _encode_params is a static method of PreparedRequest
+    result = PreparedRequest._encode_params(data)
+    assert result == data
+    print("test_encode_params_with_wrapper passed")
+
+if __name__ == "__main__":
+    try:
+        test_encode_files_with_wrapper()
+    except Exception as e:
+        print(f"test_encode_files_with_wrapper failed: {e}")
+        import traceback
+        traceback.print_exc()
+    
+    try:
+        test_encode_params_with_wrapper()
+    except Exception as e:
+        print(f"test_encode_params_with_wrapper failed: {e}")
+        import traceback
+        traceback.print_exc()

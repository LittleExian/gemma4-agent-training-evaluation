+def get_endpoint_context(
+    endpoint: Callable[..., Any],
+    method: str | None = None,
+    path: str | None = None,
+) -> str:
+    """
+    Get the endpoint context for error messages.
+
+    This includes the file path, line number, function name, and HTTP method and route.
+    The base context (file, line, function name) is cached on the endpoint function to
+    avoid re-computing it on subsequent calls.
+    """
+    cached_base = getattr(endpoint, "_fastapi_endpoint_context_base", None)
+    if cached_base is None:
+        try:
+            file_path = inspect.getfile(endpoint)
+            line_number = inspect.getsourcelines(endpoint)[1]
+            function_name = endpoint.__name__
+        except (TypeError, OSError):
+            return ""
+        cached_base = f'File "{file_path}", line {line_number}, in {function_name}'
+        try:
+            endpoint._fastapi_endpoint_context_base = cached_base
+        except (AttributeError, TypeError):
+            pass
+
+    context = cached_base
+    if method and path:
+        context += f"\n    {method} {path}"
+    return context
+
+

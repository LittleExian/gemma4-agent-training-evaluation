--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,56 @@
+
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_root(my_header: str = Header()):
+    return {"my_header": my_header}
+
+client = TestClient(app)
+
+def test_underscore_header():
+    # By default convert_underscores=True. 
+    # It should NOT accept 'my_header'
+    response = client.get("/", headers={"my_header": "value"})
+    print(f"Response with my_header: {response.json()}")
+    assert response.status_code == 422
+
+def test_hyphen_header():
+    # By default convert_underscores=True.
+    # It SHOULD accept 'my-header'
+    response = client.get("/", headers={"my-header": "value"})
+    print(f"Response with my-header: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"my_header": "value"}
+
+def test_underscore_header_disabled():
+    # With convert_underscores=False, it SHOULD accept 'my_header'
+    @app.get("/disabled")
+    async def read_root_disabled(my_header: str = Header(convert_underscores=False)):
+        return {"my_header": my_header}
+    
+    response = client.get("/disabled", headers={"my_header": "value"})
+    print(f"Response with my_header (disabled): {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"my_header": "value"}
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header()
+        print("test_underscore_header passed")
+    except Exception as e:
+        print(f"test_underscore_header failed: {e}")
+
+    try:
+        test_hyphen_header()
+        print("test_hyphen_header passed")
+    except Exception as e:
+        print(f"test_hyphen_header failed: {e}")
+
+    try:
+        test_underscore_header_disabled()
+        print("test_underscore_header_disabled passed")
+    except Exception as e:
+        print(f"test_underscore_header_disabled failed: {e}")

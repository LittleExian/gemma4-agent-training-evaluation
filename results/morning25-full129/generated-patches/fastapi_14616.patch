+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import Annotated, List
+from fastapi.dependencies.utils import _get_multidict_value
+from pydantic.fields import FieldInfo
+import pydantic
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(tags: Annotated[Json[List[str]], Form()]):
+    return {"tags": tags}
+
+# We need to get the field object.
+# FastAPI creates a Pydantic model for the request body/form.
+# Let's see how it's done.
+# Actually, we can just look at the app's route.
+route = app.routes[0]
+# The route's endpoint is the 'upload' function.
+# FastAPI uses 'get_model_for_body' or similar.
+# But for Form, it's different.
+
+# Let's just use a simple Pydantic model to see what happens to Json.
+class Model(pydantic.BaseModel):
+    tags: Annotated[Json[List[str]], Form()]
+
+field = Model.model_fields['tags']
+print(f"field.annotation: {field.annotation}")
+print(f"field.metadata: {getattr(field, 'metadata', 'No metadata')}")
diff --git a/debug_json.py b/debug_json.py
new file mode 100644
index 00000000..3a7379c2
--- /dev/null
+++ b/debug_json.py
@@ -0,0 +1,18 @@
+from pydantic import Json
+import pydantic
+print(f"pydantic.Json: {pydantic.Json}")
+print(f"Json: {Json}")
+print(f"Are they same? {pydantic.Json is Json}")
+
+# Let's see what's in the metadata of a Json field
+from typing import Annotated, List
+from pydantic import BaseModel
+
+class Model(BaseModel):
+    tags: Annotated[List[str], Json]
+
+field = Model.model_fields['tags']
+print(f"field.metadata: {field.metadata}")
+print(f"Is Json in metadata? {Json in field.metadata}")
+print(f"Metadata element: {field.metadata[0]}")
+print(f"Is metadata element same as Json? {field.metadata[0] is Json}")

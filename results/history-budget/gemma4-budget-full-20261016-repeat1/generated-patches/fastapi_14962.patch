diff --git a/test_rust_serialization.py b/test_rust_serialization.py
new file mode 100644
index 00000000..f04dec05
--- /dev/null
+++ b/test_rust_serialization.py
@@ -0,0 +1,25 @@
+from fastapi import FastAPI, Response
+from pydantic import BaseModel
+from fastapi.testclient import TestClient
+import time
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+@app.get("/item", response_model=Item)
+async def get_item():
+    return Item(name="Test Item", price=10.5)
+
+client = TestClient(app)
+
+def test_rust_serialization():
+    response = client.get("/item")
+    assert response.status_code == 200
+    assert response.json() == {"name": "Test Item", "price": 10.5}
+    print("Test passed!")
+
+if __name__ == "__main__":
+    test_rust_serialization()

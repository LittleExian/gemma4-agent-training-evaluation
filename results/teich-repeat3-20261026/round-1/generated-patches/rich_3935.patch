--- /dev/null
+++ b/repro_measure.py
@@ -0,0 +1,23 @@
+from rich.console import Console
+from rich.padding import Padding
+from rich.measure import Measurement
+
+def test_padding_measure_expand():
+    console = Console(width=20)
+    renderable = "Hello"
+    # expand=True
+    padding = Padding(renderable, (0, 2, 0, 2), expand=True)
+    
+    measurement = padding.__rich_measure__(console, console.options)
+    print(f"Measurement (expand=True): {measurement}")
+    
+    # Expected: Measurement(20, 20)
+    # Actual: Measurement(9, 9) (since "Hello" is 5, 5+2+2=9)
+    
+    if measurement.minimum != 20 or measurement.maximum != 20:
+        print("FAILED: Measurement should be (20, 20)")
+    else:
+        print("PASSED")
+
+if __name__ == "__main__":
+    test_padding_measure_expand()

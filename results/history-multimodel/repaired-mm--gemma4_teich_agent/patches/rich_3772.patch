@@ -0,0 +1,17 @@
+from rich.traceback import install
+import sys
+
+install(show_locals=True)
+
+class BadRepr:
+    def __repr__(self):
+        raise RuntimeError("Repr failed")
+
+def foo():
+    x = BadRepr()
+    1 / 0
+
+try:
+    foo()
+except Exception:
+    sys.excepthook(*sys.exc_info())

diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..1f4cb00c
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,39 @@
+from fastapi._compat.shared import field_annotation_is_sequence, field_annotation_is_scalar_sequence, field_annotation_is_scalar
+from typing import List, Optional, Sequence, Union
+import types
+
+# Python 3.10+ union syntax
+try:
+    UnionType = types.UnionType
+except AttributeError:
+    UnionType = Union
+
+def test():
+    # Test cases
+    test_cases = [
+        (List[int], True, True),
+        (Optional[List[int]], True, True),
+        (Sequence[int], True, True),
+        (Optional[Sequence[int]], True, True),
+        (list[int], True, True),
+        (list[int] | None, True, True),
+        (Sequence[int] | None, True, True),
+        (int, False, False),
+        (Optional[int], False, False),
+        (List[List[int]], True, False),
+        (Optional[List[List[int]]], True, False),
+        (list[list[int]], True, False),
+        (list[list[int]] | None, True, False),
+    ]
+
+    for annotation, expected_seq, expected_scalar_seq in test_cases:
+        res_seq = field_annotation_is_sequence(annotation)
+        res_scalar_seq = field_annotation_is_scalar_sequence(annotation)
+        print(f"Annotation: {annotation}")
+        print(f"  is_sequence: {res_seq} (expected {expected_seq})")
+        print(f"  is_scalar_sequence: {res_scalar_seq} (expected {expected_scalar_seq})")
+        assert res_seq == expected_seq, f"Failed is_sequence for {annotation}"
+        assert res_scalar_seq == expected_scalar_seq, f"Failed is_scalar_sequence for {annotation}"
+
+if __name__ == "__main__":
+    test()

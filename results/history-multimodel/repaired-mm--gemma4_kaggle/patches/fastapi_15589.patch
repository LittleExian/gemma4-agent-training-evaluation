diff --git a/repro_model.py b/repro_model.py
new file mode 100644
index 000000000..eee75bdfd
--- /dev/null
+++ b/repro_model.py
@@ -0,0 +1,29 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class MyHeaders(BaseModel):
+    my_header: str
+
+@app.get("/")
+async def read_headers(headers: MyHeaders = Header()):
+    return {"my_header": headers.my_header}
+
+client = TestClient(app)
+
+def test_underscore_header_with_model():
+    # This should NOT be accepted if convert_underscores=True (default)
+    response = client.get("/", headers={"my_header": "value"})
+    assert response.status_code == 422, "Should not accept underscored header"
+
+def test_hyphen_header_with_model():
+    # This SHOULD be accepted
+    response = client.get("/", headers={"my-header": "value"})
+    assert response.status_code == 200
+    assert response.json() == {"my_header": "value"}
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])

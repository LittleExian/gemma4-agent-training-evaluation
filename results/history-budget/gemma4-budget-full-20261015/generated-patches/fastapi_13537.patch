+++ b/reproduce_bug.py
@@ -0,0 +1,41 @@
+
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+from typing import Optional
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(name: Optional[str] = Form(None)):
+    return {"name": name}
+
+client = TestClient(app)
+
+def test_empty_string_form_value():
+    # When name is sent as an empty string, it should be interpreted as None if default is None
+    # But the bug says it's interpreted as "" and then validation might choke.
+    # In this case, name is Optional[str], so "" is valid for str.
+    # Let's try with a type that doesn't accept "".
+    pass
+
+@app.post("/test_int")
+async def test_int_endpoint(age: Optional[int] = Form(None)):
+    return {"age": age}
+
+def test_empty_string_int_form_value():
+    # If age is sent as "", it should be interpreted as None (the default)
+    # instead of trying to validate "" as an int.
+    response = client.post("/test_int", data={"age": ""})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"age": None}
+
+if __name__ == "__main__":
+    try:
+        test_empty_string_int_form_value()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()

@@ -0,0 +1,33 @@
+from rich.text import Text
+from rich.console import Console
+
+def test_wrap_cjk():
+    # Width 1, CJK character (width 2)
+    text = Text("你好")
+    console = Console(width=1, force_terminal=True)
+    
+    # Default overflow is "fold"
+    lines = text.wrap(console, width=1)
+    
+    # Each line should be a single CJK character
+    # "你好" should be wrapped into 2 lines: "你" and "好"
+    # If the bug is present, they will be replaced by spaces.
+    
+    print(f"Wrapped lines: {lines}")
+    for i, line in enumerate(lines):
+        print(f"Line {i}: '{line.plain}' (cell_len: {line.cell_len})")
+    
+    assert len(lines) == 2
+    assert lines[0].plain == "你"
+    assert lines[1].plain == "好"
+
+if __name__ == "__main__":
+    try:
+        test_wrap_cjk()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

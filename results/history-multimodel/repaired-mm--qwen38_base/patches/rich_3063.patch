+import re
+import sys
+sys.path.insert(0, '/workspace')
+from rich.markup import RE_TAGS
+
+s = 'foo' + '\\' * 2 + '[bold]bar[/bold]'
+print('string:', repr(s))
+for m in RE_TAGS.finditer(s):
+    print('span', m.span(), 'lens', len(m.group(1)), len(m.group(2)), len(m.group(3)))
+    print('  g1', repr(m.group(1)), 'g2', repr(m.group(2)), 'g3', repr(m.group(3)))
+
+s2 = 'foo' + '\\' * 1 + '[bold]bar[/bold]'
+print('--- single backslash ---', repr(s2))
+for m in RE_TAGS.finditer(s2):
+    print('span', m.span(), 'g1', repr(m.group(1)), 'g2', repr(m.group(2)), 'g3', repr(m.group(3)))
+
+s3 = 'foo' + '\\' * 3 + '[bold]bar[/bold]'
+print('--- three backslashes ---', repr(s3))
+for m in RE_TAGS.finditer(s3):
+    print('span', m.span(), 'g1', repr(m.group(1)), 'g2', repr(m.group(2)), 'g3', repr(m.group(3)))

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..28567d1e
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,24 @@
+
+from typing import Dict, Tuple, Literal, Any
+from fastapi._compat.v2 import _remap_definitions_and_field_mappings, ModelField
+from pydantic.fields import FieldInfo
+from pydantic import BaseModel
+
+class MyModel(BaseModel):
+    x: int
+
+model_name_map = {MyModel: "MyModel"}
+field = ModelField(field_info=FieldInfo(annotation=MyModel), name="MyModel", mode="validation")
+# schema not a dict
+field_mapping = {(field, "validation"): "not a dict"} 
+definitions = {}
+
+try:
+    _remap_definitions_and_field_mappings(
+        model_name_map=model_name_map,
+        definitions=definitions,
+        field_mapping=field_mapping,
+    )
+    print("Success")
+except Exception as e:
+    print(f"Failed: {type(e).__name__}: {e}")

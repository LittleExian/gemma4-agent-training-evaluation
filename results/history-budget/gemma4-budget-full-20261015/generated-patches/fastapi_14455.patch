@@ -0,0 +1,18 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+
+app = FastAPI()
+
+scheme1 = OAuth2PasswordBearer(tokenUrl="token", scopes={"read": "Read access"})
+scheme2 = OAuth2PasswordBearer(tokenUrl="token", scopes={"write": "Write access"})
+
+@app.get("/read")
+def read(token: str = Security(scheme1, scopes=["read"])):
+    return {"msg": "read"}
+
+@app.get("/write")
+def write(token: str = Security(scheme2, scopes=["write"])):
+    return {"msg": "write"}
+
+import json
+print(json.dumps(app.openapi(), indent=2))

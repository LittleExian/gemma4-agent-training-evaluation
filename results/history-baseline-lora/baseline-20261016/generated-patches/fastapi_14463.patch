@@ -0,0 +1,60 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+from fastapi.testclient import TestClient
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+client = TestClient(app)
+
+def test_openapi_duplication():
+    response = client.get("/openapi.json")
+    openapi_json = response.json()
+    
+    # Check /route1 responses 500
+    route1_500_schema = openapi_json["paths"]["/route1"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]
+    any_of = route1_500_schema.get("anyOf", [])
+    
+    print(f"Number of refs in anyOf for /route1: {len(any_of)}")
+    
+    # Expected: 2 refs (ModelA and ModelB)
+    # Actual (bug): 6 refs (ModelA, ModelB repeated 3 times)
+    assert len(any_of) == 2, f"Expected 2 refs, got {len(any_of)}"
+
+if __name__ == "__main__":
+    try:
+        test_openapi_duplication()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

@@ -0,0 +1,21 @@
+from fastapi import FastAPI, Depends
+from fastapi.security import HTTPBearer
+from fastapi.openapi.utils import get_openapi
+
+auth_scheme = HTTPBearer()
+app = FastAPI(dependencies=[Depends(auth_scheme)])
+
+@app.get("/")
+def read_root():
+    return {"Hello": "World"}
+
+# We need to simulate what happens in app.openapi()
+# The app.openapi() method calls get_openapi with app.routes
+# But app.routes are not yet fully processed into dependants until the first request or when openapi is called.
+
+# In FastAPI, the dependants are created in the route.
+# Let's see if the security schemes appear in the openapi schema.
+
+import json
+schema = app.openapi()
+print(json.dumps(schema, indent=2))

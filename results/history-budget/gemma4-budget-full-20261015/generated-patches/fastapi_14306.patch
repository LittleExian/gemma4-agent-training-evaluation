diff --git a/fastapi/routing.py b/fastapi/routing.py
index c10175b1..b8b64151 100644
--- a/fastapi/routing.py
+++ b/fastapi/routing.py
@@ -51,6 +51,41 @@ from fastapi.exceptions import (
     ResponseValidationError,
     WebSocketRequestValidationError,
 )
+
+_endpoint_context_cache: Dict[Any, Dict[str, Any]] = {}
+
+def get_endpoint_context(dependant: Any, request: Any = None, websocket: Any = None) -> Optional[Dict[str, Any]]:
+    if dependant not in _endpoint_context_cache:
+        try:
+            func = dependant.call
+            if hasattr(func, "func"):
+                func = func.func
+            try:
+                source_file = inspect.getfile(func)
+                _, start_line = inspect.getsourcelines(func)
+                name = func.__name__
+            except (TypeError, OSError):
+                source_file = "unknown"
+                start_line = 0
+                name = getattr(func, "__name__", "unknown")
+            _endpoint_context_cache[dependant] = {
+                "file": source_file,
+                "line": start_line,
+                "name": name,
+            }
+        except Exception:
+            return None
+    context = _endpoint_context_cache[dependant].copy()
+    if request:
+        context["method"] = getattr(request, "method", "UNKNOWN")
+        context["path"] = getattr(request.url, "path", "UNKNOWN")
+    elif websocket:
+        context["method"] = "WEBSOCKET"
+        context["path"] = getattr(websocket.url, "path", "UNKNOWN")
+    else:
+        return None
+    return context
+

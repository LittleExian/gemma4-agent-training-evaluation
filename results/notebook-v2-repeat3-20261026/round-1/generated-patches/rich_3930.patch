+def split_graphemes(text: str) -> list[str]:
+    """Split text into a list of grapheme clusters."""
+    if not text:
+        return []
+    graphemes = []
+    for i, char in enumerate(text):
+        if i == 0:
+            graphemes.append(char)
+            continue
+
+        prev_char = text[i-1]
+        if (
+            unicodedata.combining(char)
+            or prev_char == "\u200D"
+            or char == "\u200D"
+            or 0x1F3FB <= ord(char) <= 0x1F3FF
+            or char in "\uFE0E\uFE0F"
+        ):
+            graphemes[-1] += char
+        else:
+            graphemes.append(char)
+    return graphemes
+

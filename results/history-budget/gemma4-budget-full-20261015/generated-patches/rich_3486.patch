diff --git a/test_pep657.py b/test_pep657.py
new file mode 100644
index 00000000..3589e636
--- /dev/null
+++ b/test_pep657.py
@@ -0,0 +1,16 @@
+import traceback
+import sys
+
+def foo():
+    return 1 / 0
+
+try:
+    foo()
+except Exception as e:
+    tb = e.__traceback__
+    # Create a new traceback object by slicing it or something
+    # For simplicity, just use the same one
+    te = traceback.TracebackException(type(e), e, tb)
+    print(f"te stack: {len(te.stack)}")
+    for fs in te.stack:
+        print(f"colno: {getattr(fs, 'colno', 'N/A')}")

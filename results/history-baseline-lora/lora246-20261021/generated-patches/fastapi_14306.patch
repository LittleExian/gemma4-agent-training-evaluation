+def get_endpoint_context(endpoint: Callable[..., Any]) -> Optional[str]:
+    """
+    Get the endpoint context for a given endpoint.
+    """
+    try:
+        # Get the source file and line number of the endpoint function
+        frame = inspect.getframeinfo(inspect.getsourcefile(endpoint), inspect.findline(endpoint))
+        return f"{frame.filename}:{frame.lineno}"
+    except (TypeError, OSError, ValueError):
+        return None
+

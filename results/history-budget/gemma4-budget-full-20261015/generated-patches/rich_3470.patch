diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..3dd47a90
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,8 @@
+from rich.console import Console
+
+console = Console(record=True)
+with console.capture() as capture:
+    console.print("Hello Capture")
+
+print(f"Captured: {capture.get()}")
+print(f"Recorded: {console.export_text()}")
diff --git a/repro_nested.py b/repro_nested.py
new file mode 100644
index 00000000..ad6c6c08
--- /dev/null
+++ b/repro_nested.py
@@ -0,0 +1,12 @@
+from rich.console import Console
+
+console = Console(record=True)
+with console.capture() as capture1:
+    console.print("Hello 1")
+    with console.capture() as capture2:
+        console.print("Hello 2")
+    console.print("Hello 3")
+
+print(f"Captured 1: {capture1.get()}")
+print(f"Captured 2: {capture2.get()}")
+print(f"Recorded: {console.export_text()}")

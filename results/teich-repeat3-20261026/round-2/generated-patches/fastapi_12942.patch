diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..09eb9685
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,56 @@
+from typing import Any, Literal, Annotated
+from pydantic import BaseModel, Field, Discriminator, Tag
+from fastapi import FastAPI, Body
+from fastapi.params import Body as FastAPIBody
+from fastapi.testclient import TestClient
+
+class Pie(BaseModel):
+    time_to_cook: int
+    num_ingredients: int
+
+class ApplePie(Pie):
+    fruit: Literal["apple"] = "apple"
+
+class PumpkinPie(Pie):
+    filling: Literal["pumpkin"] = "pumpkin"
+
+def get_discriminator_value(v: Any) -> str:
+    if isinstance(v, dict):
+        return v.get("fruit", v.get("filling"))
+    return getattr(v, "fruit", getattr(v, "filling", None))
+
+Dessert = Annotated[
+    Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")],
+    Discriminator(get_discriminator_value),
+]
+
+app = FastAPI()
+
+@app.post("/dessert")
+async def dinner(dessert: Dessert) -> dict[str, Any]:
+    return dessert.model_dump()
+
+client = TestClient(app)
+
+def test_dessert_endpoint():
+    # Test ApplePie
+    response = client.post("/dessert", json={"time_to_cook": 60, "num_ingredients": 5, "fruit": "apple"})
+    print(f"ApplePie response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["fruit"] == "apple"
+
+    # Test PumpkinPie
+    response = client.post("/dessert", json={"time_to_cook": 90, "num_ingredients": 8, "filling": "pumpkin"})
+    print(f"PumpkinPie response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["filling"] == "pumpkin"
+
+if __name__ == "__main__":
+    try:
+        test_dessert_endpoint()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

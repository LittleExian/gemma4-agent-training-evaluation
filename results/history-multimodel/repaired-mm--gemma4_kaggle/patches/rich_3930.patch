+def split_graphemes(text: str) -> list[str]:
+    """Split text into a list of grapheme clusters."""
+    if not text:
+        return []
+
+    graphemes = []
+    current_grapheme = ""
+    next_char_is_continuation = False
+
+    for char in text:
+        is_continuation = (
+            unicodedata.category(char).startswith("M")
+            or char == "\u200D"
+            or "\U0001F3FB" <= char <= "\U0001F3FF"
+        )
+
+        if next_char_is_continuation or is_continuation:
+            current_grapheme += char
+            next_char_is_continuation = char == "‍"
+        else:
+            if current_grapheme:
+                graphemes.append(current_grapheme)
+            current_grapheme = char
+            next_char_is_continuation = False
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+
+    return graphemes
+

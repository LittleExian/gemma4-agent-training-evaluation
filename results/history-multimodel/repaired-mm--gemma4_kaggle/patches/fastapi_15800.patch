diff --git a/verify_frontend.py b/verify_frontend.py
new file mode 100644
index 000000000..b558d6970
--- /dev/null
+++ b/verify_frontend.py
@@ -0,0 +1,41 @@
+
+from fastapi import FastAPI, APIRouter
+from fastapi.staticfiles import StaticFiles
+from starlette.routing import Mount
+import os
+
+# Create a dummy directory for static files
+os.makedirs("test_static", exist_ok=True)
+with open("test_static/index.html", "w") as f:
+    f.write("Hello Frontend")
+
+def test_fastapi_frontend():
+    app = FastAPI()
+    app.frontend("/", directory="test_static")
+    mounts = [route for route in app.routes if isinstance(route, Mount)]
+    print(f"FastAPI mounts: {mounts}")
+    assert len(mounts) > 0
+    assert mounts[0].path in ["/", ""]
+    assert mounts[0].name == "frontend"
+    print("test_fastapi_frontend passed")
+
+def test_apirouter_frontend():
+    router = APIRouter()
+    router.frontend("/static", directory="test_static")
+    mounts = [route for route in router.routes if isinstance(route, Mount)]
+    print(f"APIRouter mounts: {mounts}")
+    assert len(mounts) > 0
+    assert mounts[0].path == "/static"
+    assert mounts[0].name == "frontend"
+    print("test_apirouter_frontend passed")
+
+if __name__ == "__main__":
+    try:
+        test_fastapi_frontend()
+        test_apirouter_frontend()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

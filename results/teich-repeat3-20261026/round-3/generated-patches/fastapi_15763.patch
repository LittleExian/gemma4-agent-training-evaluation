diff --git a/repro.py b/repro.py
new file mode 100644
index 000000000..22bba0771
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,30 @@
+from starlette.routing import Route, compile_path
+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+
+def test_empty_path():
+    app = FastAPI()
+    router = APIRouter()
+    try:
+        @router.get("")
+        def root():
+            return {"message": "root"}
+        app.include_router(router)
+        print("Successfully included router with empty path and no prefix")
+    except FastAPIError as e:
+        print(f"Caught expected error: {e}")
+    except Exception as e:
+        print(f"Caught unexpected error: {type(e).__name__}: {e}")
+
+def test_empty_path_with_prefix():
+    app = FastAPI()
+    router = APIRouter()
+    @router.get("")
+    def root():
+        return {"message": "root"}
+    app.include_router(router, prefix="/api")
+    print("Successfully included router with empty path and prefix /api")
+
+if __name__ == "__main__":
+    test_empty_path()
+    test_empty_path_with_prefix()

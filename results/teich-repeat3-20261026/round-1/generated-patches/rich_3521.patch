@@ -0,0 +1,23 @@
+from rich.segment import Segment, cell_len
+from rich.text import Text
+
+def test_split_cells_bug():
+    text = "😀" * 100 + "a" * 100
+    cell_length = cell_len(text)
+    cut = 201
+    segment = Segment(text, None, None)
+    s1, s2 = segment.split_cells(cut)
+    
+    s1_len = cell_len(s1.text)
+    s2_len = cell_len(s2.text)
+    
+    print(f"Text length: {len(text)}, Cell length: {cell_length}")
+    print(f"Cut at {cut}: cell_len(s1) = {s1_len}, cell_len(s2) = {s2_len}")
+    
+    assert s1_len == cut, f"s1 length should be {cut}, got {s1_len}"
+    assert s2_len == cell_length - cut, f"s2 length should be {cell_length - cut}, got {s2_len}"
+    assert s1_len + s2_len == cell_length, f"Total length should be {cell_length}, got {s1_len + s2_len}"
+
+if __name__ == "__main__":
+    test_split_cells_bug()
+    print("Test passed!")

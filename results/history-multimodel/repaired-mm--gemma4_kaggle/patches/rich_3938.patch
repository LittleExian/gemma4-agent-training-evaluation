+text = Text("This is a long line with a background style", style="on blue")
+console_true.print(text)
+print(repr(console_true.file.getvalue()))
+
+print("\n--- soft_wrap=False ---")
+console_false = Console(file=io.StringIO(), force_terminal=True, width=20, soft_wrap=False)
+console_false.print(text)
+print(repr(console_false.file.getvalue()))

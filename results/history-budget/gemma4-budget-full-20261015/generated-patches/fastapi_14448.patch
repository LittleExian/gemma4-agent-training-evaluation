--- /dev/null
+++ b/repro.py
@@ -0,0 +1,78 @@
+import asyncio
+import functools
+import inspect
+from fastapi.utils import is_async_callable, is_gen_callable, is_async_gen_callable
+
+def sync_func():
+    return "sync"
+
+async def async_func():
+    return "async"
+
+def sync_gen():
+    yield "sync_gen"
+
+async def async_gen():
+    yield "async_gen"
+
+def wrapper(func):
+    @functools.wraps(func)
+    def wrapped(*args, **kwargs):
+        return func(*args, **kwargs)
+    return wrapped
+
+def async_wrapper(func):
+    @functools.wraps(func)
+    async def wrapped(*args, **kwargs):
+        return await func(*args, **kwargs)
+    return wrapped
+
+def test_is_async_callable():
+    # Simple sync
+    assert is_async_callable(sync_func) is False
+    # Simple async
+    assert is_async_callable(async_func) is True
+    # Sync wrapped by sync
+    assert is_async_callable(wrapper(sync_func)) is False
+    # Sync wrapped by async
+    assert is_async_callable(async_wrapper(sync_func)) is True
+    # Async wrapped by sync
+    assert is_async_callable(wrapper(async_func)) is True
+    # Async wrapped by async
+    assert is_async_callable(async_wrapper(async_func)) is True
+    # Partial sync
+    assert is_async_callable(functools.partial(sync_func)) is False
+    # Partial async
+    assert is_async_callable(functools.partial(async_func)) is True
+    # Partial of wrapped sync
+    assert is_async_callable(functools.partial(wrapper(sync_func))) is False
+    # Partial of wrapped async
+    assert is_async_callable(functools.partial(wrapper(async_func))) is True
+    # Wrapped partial async
+    assert is_async_callable(wrapper(functools.partial(async_func))) is True
+    # Async wrapped partial async
+    assert is_async_callable(async_wrapper(functools.partial(async_func))) is True
+
+def test_is_gen_callable():
+    assert is_gen_callable(sync_gen) is True
+    assert is_gen_callable(sync_func) is False
+    assert is_gen_callable(wrapper(sync_gen)) is True
+    assert is_gen_callable(functools.partial(sync_gen)) is True
+    assert is_gen_callable(wrapper(functools.partial(sync_gen))) is True
+
+def test_is_async_gen_callable():
+    assert is_async_gen_callable(async_gen) is True
+    assert is_async_gen_callable(sync_gen) is False
+    assert is_async_gen_callable(wrapper(async_gen)) is True
+    assert is_async_gen_callable(functools.partial(async_gen)) is True
+    assert is_async_gen_callable(wrapper(functools.partial(async_gen))) is True
+
+if __name__ == "__main__":
+    try:
+        test_is_async_callable()
+        test_is_gen_callable()
+        test_is_async_gen_callable()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

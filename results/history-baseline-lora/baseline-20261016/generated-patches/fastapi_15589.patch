@@ -0,0 +1,30 @@
+from fastapi import FastAPI, Header, HTTPException
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_header(my_header: str = Header(...)):
+    return {"my_header": my_header}
+
+client = TestClient(app)
+
+def test_underscore_header_required():
+    # Default convert_underscores=True
+    # Should only accept 'my-header'
+    # Request with 'my_header' should result in 422 Unprocessable Entity
+    response = client.get("/", headers={"my_header": "value1"})
+    print(f"Response with my_header: {response.status_code} {response.json()}")
+    assert response.status_code == 422
+
+    response = client.get("/", headers={"my-header": "value2"})
+    print(f"Response with my-header: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["my_header"] == "value2"
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header_required()
+        print("test_underscore_header_required passed")
+    except Exception as e:
+        print(f"test_underscore_header_required failed: {e}")

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..dafa0f9c
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,21 @@
+from rich.text import Text
+from rich.segment import Segment
+from rich.console import Console
+
+def test_render_empty_text():
+    console = Console()
+    
+    # Case 1: Empty Text, no spans
+    t1 = Text("")
+    res1 = list(t1.render(console, end="."))
+    print(f"Case 1: {res1}")
+    
+    # Case 2: Empty Text, with spans
+    t2 = Text("")
+    t2.append("", style="red")
+    print(f"Case 2 spans: {t2._spans}")
+    res2 = list(t2.render(console, end="."))
+    print(f"Case 2: {res2}")
+
+if __name__ == "__main__":
+    test_render_empty_text()
diff --git a/repro2.py b/repro2.py
new file mode 100644
index 00000000..e8616332
--- /dev/null
+++ b/repro2.py
@@ -0,0 +1,19 @@
+from rich.console import Console
+from rich.text import Text, Span
+from rich.segment import Segment
+
+def test_render_empty_no_spans():
+    t = Text("")
+    console = Console()
+    segments = list(t.render(console, end="something"))
+    print(f"No spans: {segments}")
+
+def test_render_empty_with_spans():
+    t = Text("")
+    t.spans = [Span(0, 0, "red")]
+    console = Console()
+    segments = list(t.render(console, end="something"))
+    print(f"With spans: {segments}")
+
+test_render_empty_no_spans()
+test_render_empty_with_spans()

new file mode 100644
index 00000000..09be9fdb
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+
+import io
+import sys
+from rich.console import Console
+from rich.file_proxy import FileProxy
+
+class MockFile(io.TextIOBase):
+    def isatty(self):
+        return True
+    def fileno(self):
+        return 1
+    def write(self, s):
+        return len(s)
+    def flush(self):
+        pass
+
+def test_proxy_isatty():
+    mock_file = MockFile()
+    console = Console(file=io.StringIO()) # dummy console
+    proxy = FileProxy(console, mock_file)
+    
+    print(f"MockFile isatty: {mock_file.isatty()}")
+    try:
+        print(f"FileProxy isatty: {proxy.isatty()}")
+    except Exception as e:
+        print(f"FileProxy isatty raised: {e}")
+
+if __name__ == "__main__":
+    test_proxy_isatty()
diff --git a/repro_encoding.py b/repro_encoding.py
new file mode 100644
index 00000000..0f51a3ba
--- /dev/null
+++ b/repro_encoding.py
@@ -0,0 +1,28 @@
+
+import io
+from rich.console import Console
+from rich.file_proxy import FileProxy
+
+class MockFile(io.TextIOBase):
+    def __init__(self):
+        super().__init__()
+        self.encoding = "cp1252"
+    def isatty(self):
+        return True
+    def fileno(self):
+        return 1
+    def write(self, s):
+        return len(s)
+    def flush(self):
+        pass
+
+def test_proxy_encoding():
+    mock_file = MockFile()
+    console = Console(file=io.StringIO()) # dummy console
+    proxy = FileProxy(console, mock_file)
+    
+    print(f"MockFile encoding: {mock_file.encoding}")
+    print(f"FileProxy encoding: {proxy.encoding}")
+
+if __name__ == "__main__":
+    test_proxy_encoding()

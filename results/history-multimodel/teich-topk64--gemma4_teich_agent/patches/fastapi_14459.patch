@@ -0,0 +1,39 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.security.base import SecurityBase
+from fastapi.openapi.utils import get_openapi_security_definitions
+from fastapi.dependencies.utils import get_flat_dependant
+from fastapi.routing import get_dependant
+
+class MySecurity(SecurityBase):
+    scheme_name = "my_security"
+    
+    async def __call__(self, request):
+        return True
+
+my_security = MySecurity()
+
+async def parent_p_scoped(d=Depends(my_security)):
+    return d
+
+app = FastAPI()
+
+@app.get("/test_scoped", dependencies=[Security(parent_p_scoped, scopes=["scope1"]), Depends(my_security)])
+async def test_scoped():
+    return {"ok": True}
+
+route_scoped = app.routes[0]
+print(f"Route type: {type(route_scoped)}")
+
+if hasattr(route_scoped, "dependant"):
+    dependant_scoped = route_scoped.dependant
+else:
+    print("Route has no dependant attribute")
+    exit(1)
+
+flat_dependant_scoped = get_flat_dependant(dependant_scoped, skip_repeats=True)
+security_definitions_scoped, operation_security_scoped = get_openapi_security_definitions(flat_dependant_scoped)
+
+print(f"Operation security scoped: {operation_security_scoped}")
+# Expected: [{'my_security': ['scope1']}]
+# If bug exists, it might be: [{'my_security': []}]

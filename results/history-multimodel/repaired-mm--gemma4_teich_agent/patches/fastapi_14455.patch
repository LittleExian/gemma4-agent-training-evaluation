+def merge_security_definitions(
+    existing: Dict[str, Any], new: Dict[str, Any]
+) -> None:
+    for security_name, security_definition in new.items():
+        if security_name in existing:
+            existing_definition = existing[security_name]
+            if (
+                existing_definition.get("type") == "oauth2"
+                and security_definition.get("type") == "oauth2"
+            ):
+                existing_flows = existing_definition.get("flows", {})
+                new_flows = security_definition.get("flows", {})
+                for flow_name, flow_def in new_flows.items():
+                    if flow_name in existing_flows:
+                        existing_flows[flow_name].setdefault("scopes", {}).update(
+                            flow_def.get("scopes", {})
+                        )
+                    else:
+                        existing_flows[flow_name] = flow_def
+                existing_definition["flows"] = existing_flows
+            else:
+                existing[security_name] = security_definition
+        else:
+            existing[security_name] = security_definition
 
 

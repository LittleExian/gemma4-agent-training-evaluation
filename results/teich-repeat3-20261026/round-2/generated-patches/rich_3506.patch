@@ -0,0 +1,12 @@
+from rich.segment import Segment
+
+def test_split_cells(text, cut):
+    seg = Segment(text)
+    before, after = seg.split_cells(cut)
+    print(f"text: {repr(text)}, cut: {cut}, cell_length: {seg.cell_length} -> before: {repr(before.text)}, after: {repr(after.text)}")
+
+test_split_cells('\u200d', 0)
+test_split_cells('\u200d', 1)
+test_split_cells('A', 0)
+test_split_cells('A', 1)
+test_split_cells('A', 2)

@@ -0,0 +1,41 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+openapi_schema = app.openapi()
+responses_500 = openapi_schema["paths"]["/route1"]["get"]["responses"]["500"]
+any_of = responses_500["content"]["application/json"]["schema"]["anyOf"]
+print(f"Number of anyOf elements: {len(any_of)}")
+if len(any_of) > 2:
+    print("Issue reproduced: anyOf elements are duplicated")
+else:
+    print("Issue not reproduced")

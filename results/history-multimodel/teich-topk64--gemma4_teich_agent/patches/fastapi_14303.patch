+from fastapi import FastAPI, Query, Header, Cookie, Depends
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, ConfigDict
+from typing import List, Optional
+
+app = FastAPI()
+
+class MyExtraModel(BaseModel):
+    model_config = ConfigDict(extra="allow")
+    name: str
+
+@app.get("/query")
+def test_query(params: MyExtraModel = Depends(MyExtraModel)):
+    return params
+
+@app.get("/header")
+def test_header(params: MyExtraModel = Header()):
+    return params
+
+@app.get("/cookie")
+def test_cookie(params: MyExtraModel = Cookie()):
+    return params
+
+client = TestClient(app)
+
+def test_query_extra_multi():
+    # Use a list of tuples for multiple values of the same key
+    response = client.get("/query", params=[("name", "test"), ("extra", "1"), ("extra", "2")])
+    print(f"Query response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["extra"] == ["1", "2"]
+
+def test_header_extra_multi():
+    # Use a list of tuples for multiple values of the same key
+    response = client.get("/header", headers=[("name", "test"), ("extra", "1"), ("extra", "2")])
+    print(f"Header response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["extra"] == ["1", "2"]
+
+def test_cookie_extra_multi():
+    # Use a list of tuples for multiple values of the same key
+    response = client.get("/cookie", cookies=[("name", "test"), ("extra", "1"), ("extra", "2")])
+    print(f"Cookie response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["extra"] == ["1", "2"]
+
+if __name__ == "__main__":
+    try:
+        test_query_extra_multi()
+        print("Query test passed")
+    except Exception as e:
+        print(f"Query test failed: {e}")
+        import traceback
+        traceback.print_exc()
+
+    try:
+        test_header_extra_multi()
+        print("Header test passed")
+    except Exception as e:
+        print(f"Header test failed: {e}")
+        import traceback
+        traceback.print_exc()
+
+    try:
+        test_cookie_extra_multi()
+        print("Cookie test passed")
+    except Exception as e:
+        print(f"Cookie test failed: {e}")
+        import traceback
+        traceback.print_exc()

diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..54ad990a
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,71 @@
+from typing import Any, Literal, Annotated
+from pydantic import BaseModel
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+
+class Pie(BaseModel):
+    time_to_cook: int
+    num_ingredients: int
+
+class ApplePie(Pie):
+    fruit: Literal["apple"] = "apple"
+
+class PumpkinPie(Pie):
+    filling: Literal["pumpkin"] = "pumpkin"
+
+def get_discriminator_value(v: Any) -> str:
+    if isinstance(v, dict):
+        return v.get("fruit", v.get("filling"))
+    return getattr(v, "fruit", getattr(v, "filling", None))
+
+# This is the problematic part
+# Note: Tag and Discriminator are from pydantic (or similar)
+# Actually, in Pydantic v2, Discriminator is used.
+# Let's check if Tag is available. 
+# The issue says: Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")]
+# Wait, Tag is not a standard Pydantic thing. Maybe it's from some other library or a custom one?
+# Looking at the issue again, it seems they are using Pydantic v2's Discriminator.
+# But where does Tag come from? 
+# Actually, Pydantic v2 uses Field(discriminator='...') or Annotated[Union[...], Discriminator(...)]
+# Let's re-read the issue.
+# Ah, the issue might be using a version of Pydantic or some other library.
+# Wait, the issue says "The solution is to improve the function handling type annotations by handling the case where we can have Annotated types inside an Annotated type."
+# This suggests the problem is in how FastAPI unwraps Annotated.
+
+from pydantic import Discriminator
+
+# Let's try to use a simpler version of the discriminated union that Pydantic v2 supports
+# and see if FastAPI fails to recognize it as body.
+
+# Actually, let's try to use the exact code from the issue, but I need to know where Tag comes from.
+# If Tag is not defined, the script will fail.
+# Let's try to define a dummy Tag class.
+
+class Tag:
+    def __init__(self, value):
+        self.value = value
+
+Dessert = Annotated[
+    Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")],
+    Discriminator(get_discriminator_value),
+]
+
+app = FastAPI()
+@app.post("/dessert")
+async def dinner(dessert: Dessert) -> dict[str, Any]:
+    return dessert.model_dump()
+
+client = TestClient(app)
+
+def test_dessert():
+    # This should be a body parameter
+    response = client.post("/dessert", json={"fruit": "apple", "time_to_cook": 10, "num_ingredients": 3})
+    print(f"Response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_dessert()
+        print("Success!")
+    except Exception as e:
+        print(f"Error: {e}")

+class RouterInclusion(BaseRoute):
+    def __init__(
+        self,
+        router: "APIRouter",
+        prefix: str = "",
+        tags: list[str | Enum] | None = None,
+        dependencies: Sequence[params.Depends] | None = None,
+        default_response_class: type[Response] | None = None,
+        responses: dict[int | str, dict[str, Any]] | None = None,
+        callbacks: list[BaseRoute] | None = None,
+        deprecated: bool | None = None,
+        include_in_schema: bool | None = None,
+        generate_unique_id_function: Callable[[APIRoute], str] | None = None,
+    ) -> None:
+        self.router = router
+        self.prefix = prefix
+        self.tags = tags or []
+        self.dependencies = list(dependencies or [])
+        self.default_response_class = default_response_class
+        self.responses = responses or {}
+        self.callbacks = callbacks or []
+        self.deprecated = deprecated
+        self.include_in_schema = include_in_schema
+        self.generate_unique_id_function = generate_unique_id_function
+        self.path = prefix
+
+    def matches(self, scope: Scope) -> Match[ASGIApp] | None:
+        path = scope.get("path", "")
+        if not path.startswith(self.prefix):
+            return None
+
+        new_scope = scope.copy()
+        new_scope["path"] = path[len(self.prefix):]
+
+        match = self.router.matches(new_scope)
+        if match:
+            return self, match[1]
+        return None
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        path = scope.get("path", "")
+        new_scope = scope.copy()
+        new_scope["path"] = path[len(self.prefix):]
+        await self.router.handle(new_scope, receive, send)
+
+

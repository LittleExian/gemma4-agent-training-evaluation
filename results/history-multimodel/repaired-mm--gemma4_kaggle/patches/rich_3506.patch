diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..78479a7c
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+from rich.segment import Segment
+from rich.style import Style
+
+def test_split():
+    # 💩 is 2 cells wide
+    text = "A💩B" # cell_length = 4
+    seg = Segment(text)
+    # cut = 0
+    s1, s2 = seg._split_cells(seg, 0)
+    print(f"cut=0: {repr(s1.text)} | {repr(s2.text)}")
+    
+    # cut = 1
+    s1, s2 = seg._split_cells(seg, 1)
+    print(f"cut=1: {repr(s1.text)} | {repr(s2.text)}")
+    
+    # cut = 2
+    s1, s2 = seg._split_cells(seg, 2)
+    print(f"cut=2: {repr(s1.text)} | {repr(s2.text)}")
+    
+    # cut = 3
+    s1, s2 = seg._split_cells(seg, 3)
+    print(f"cut=3: {repr(s1.text)} | {repr(s2.text)}")
+    
+    # cut = 4
+    s1, s2 = seg._split_cells(seg, 4)
+    print(f"cut=4: {repr(s1.text)} | {repr(s2.text)}")
+
+if __name__ == "__main__":
+    test_split()

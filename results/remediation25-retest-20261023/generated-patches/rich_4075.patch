@@ -0,0 +1,47 @@
+from rich.console import Console
+import io
+
+def test_print_end():
+    c = Console(file=io.StringIO(), force_terminal=False)
+    
+    # Case 1: c.print(end='') should print nothing
+    c.print(end='')
+    assert c.file.getvalue() == '', f"Expected '', got {repr(c.file.getvalue())}"
+    c.file.truncate(0)
+    c.file.seek(0)
+    
+    # Case 2: c.print(end='\n') should print one newline
+    c.print(end='\n')
+    assert c.file.getvalue() == '\n', f"Expected '\n', got {repr(c.file.getvalue())}"
+    c.file.truncate(0)
+    c.file.seek(0)
+    
+    # Case 3: c.print("hello", end='') should print 'hello'
+    c.print("hello", end='')
+    assert c.file.getvalue() == 'hello', f"Expected 'hello', got {repr(c.file.getvalue())}"
+    c.file.truncate(0)
+    c.file.seek(0)
+    
+    # Case 4: c.print("hello", end='\n') should print 'hello\n'
+    c.print("hello", end='\n')
+    assert c.file.getvalue() == 'hello\n', f"Expected 'hello\n', got {repr(c.file.getvalue())}"
+    c.file.truncate(0)
+    c.file.seek(0)
+    
+    # Case 5: c.print("hello", NewLine(), end='') should print 'hello\n'
+    from rich.text import NewLine
+    c.print("hello", NewLine(), end='')
+    assert c.file.getvalue() == 'hello\n', f"Expected 'hello\n', got {repr(c.file.getvalue())}"
+    c.file.truncate(0)
+    c.file.seek(0)
+
+    # Case 6: c.print("hello", NewLine(), end='\n') should print 'hello\n\n'
+    c.print("hello", NewLine(), end='\n')
+    assert c.file.getvalue() == 'hello\n\n', f"Expected 'hello\n\n', got {repr(c.file.getvalue())}"
+    c.file.truncate(0)
+    c.file.seek(0)
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_print_end()

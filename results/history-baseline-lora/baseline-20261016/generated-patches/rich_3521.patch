+from rich.segment import Segment
+
+# Case 1: Segment with only zero-width characters
+seg = Segment("\u200B")
+print(f"Text: {repr(seg.text)}, Cell length: {seg.cell_length}")
+
+# This should be handled by Segment.split_cells
+print(f"split_cells(1): {seg.split_cells(1)}")
+
+# But what if we call Segment._split_cells directly?
+try:
+    print(f"Segment._split_cells(1): {Segment._split_cells(seg, 1)}")
+except ZeroDivisionError as e:
+    print(f"Caught ZeroDivisionError: {e}")
+
+# Case 2: Segment with mixed characters, but cell_length is 0?
+# Not possible if there are any non-zero-width characters.

+++ b/repro.py
@@ -0,0 +1,44 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+from fastapi.openapi.utils import get_openapi
+import json
+
+app = FastAPI()
+
+class Address(BaseModel):
+    street: str
+    city: str
+
+class UserCreate(BaseModel):
+    username: str
+    address: Address
+
+@app.post("/users")
+def create_user(user: UserCreate):
+    return user
+
+openapi_schema = get_openapi(
+    title=app.title,
+    version=app.version,
+    openapi_version=app.openapi_version,
+    summary=app.summary,
+    description=app.description,
+    terms_of_service=app.terms_of_service,
+    contact=app.contact,
+    license_info=app.license_info,
+    routes=app.routes,
+    webhooks=app.webhooks.routes,
+    separate_input_output_schemas=True,
+)
+schemas = openapi_schema.get("components", {}).get("schemas", {})
+
+print(f"Schemas: {list(schemas.keys())}")
+
+address_validation = any("Address" in k and "validation" in k for k in schemas.keys())
+address_serialization = any("Address" in k and "serialization" in k for k in schemas.keys())
+
+if address_validation and address_serialization:
+    print("SUCCESS: Both validation and serialization schemas for Address found.")
+else:
+    print(f"FAILURE: Address schemas not separated. Found: {list(schemas.keys())}")
+    exit(1)

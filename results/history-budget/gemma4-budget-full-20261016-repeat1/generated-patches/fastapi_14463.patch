@@ -0,0 +1,55 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+from typing import Union
+import json
+
+app = FastAPI()
+
+class ErrorA(BaseModel):
+    message: str = "Error A"
+
+class ErrorB(BaseModel):
+    message: str = "Error B"
+
+# Shared response configuration
+shared_response = {
+    "model": Union[ErrorA, ErrorB],
+    "content": {
+        "application/json": {
+            "examples": {
+                "example1": {"value": {"message": "Error A"}},
+                "example2": {"value": {"message": "Error B"}},
+            }
+        }
+    }
+}
+
+@app.get("/route1", responses={500: shared_response})
+async def route1():
+    return {"message": "route1"}
+
+@app.get("/route2", responses={500: shared_response})
+async def route2():
+    return {"message": "route2"}
+
+@app.get("/route3", responses={500: shared_response})
+async def route3():
+    return {"message": "route3"}
+
+if __name__ == "__main__":
+    openapi_schema = app.openapi()
+    # Check the 500 response for each route
+    for path, methods in openapi_schema["paths"].items():
+        for method, operation in methods.items():
+            responses = operation.get("responses", {})
+            response_500 = responses.get("500", {})
+            content = response_500.get("content", {})
+            json_content = content.get("application/json", {})
+            schema = json_content.get("schema", {})
+            any_of = schema.get("anyOf", [])
+            print(f"Path: {path}, Method: {method}, anyOf length: {len(any_of)}")
+            if len(any_of) > 2:
+                print("BUG DETECTED: anyOf list is growing!")
+                exit(1)
+    print("SUCCESS: anyOf list size is stable.")
+    exit(0)

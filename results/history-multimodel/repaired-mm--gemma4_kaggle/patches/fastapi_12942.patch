diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..850c7359
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,34 @@
+from fastapi import FastAPI, Body, Query
+from fastapi.dependencies.utils import analyze_param
+from pydantic import BaseModel
+from typing import Annotated
+
+class Pie(BaseModel):
+    name: str
+
+def test_nested_annotated():
+    # Nested Annotated: Annotated[Annotated[Pie, "meta1"], "meta2"]
+    # This should be treated as a Body parameter because Pie is a BaseModel.
+    annotation = Annotated[Annotated[Pie, "meta1"], "meta2"]
+    result = analyze_param(
+        param_name="pie",
+        annotation=annotation,
+        value=None, # Not using a default value for simplicity
+        is_path_param=False,
+    )
+    
+    # If it's treated as a Body parameter, result.field_info should be a Body instance
+    # or at least not a Query/Path/Header/Cookie.
+    # In FastAPI, Body is a subclass of FieldInfo.
+    
+    from fastapi.params import Body as BodyParam
+    if isinstance(result.field, BodyParam):
+        print("Correct: Treated as Body parameter")
+    else:
+        print(f"Incorrect: Treated as {type(result.field)} parameter")
+        # If it's a Query parameter, it's incorrect.
+        # Let's see what it actually is.
+        print(f"Field: {result.field}")
+
+if __name__ == "__main__":
+    test_nested_annotated()

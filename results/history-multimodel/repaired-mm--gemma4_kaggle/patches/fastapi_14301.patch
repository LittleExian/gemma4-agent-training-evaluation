diff --git a/repro_scope.py b/repro_scope.py
new file mode 100644
index 00000000..8b0000c3
--- /dev/null
+++ b/repro_scope.py
@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+def test_scope_function():
+    app = FastAPI()
+    call_count = 0
+
+    async def my_dep():
+        nonlocal call_count
+        call_count += 1
+        return 1
+
+    @app.get("/", dependencies=[Depends(my_dep, scope="function")])
+    async def root(val = Depends(my_dep, scope="function")):
+        return {"val": val}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert call_count == 2, f"Expected 2 calls for scope='function', got {call_count}"
+
+def test_scope_request():
+    app = FastAPI()
+    call_count = 0
+
+    async def my_dep():
+        nonlocal call_count
+        call_count += 1
+        return 1
+
+    @app.get("/", dependencies=[Depends(my_dep)])
+    async def root(val = Depends(my_dep)):
+        return {"val": val}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert call_count == 1, f"Expected 1 call for scope='request', got {call_count}"
+
+if __name__ == "__main__":
+    try:
+        test_scope_function()
+        print("test_scope_function passed")
+    except Exception as e:
+        print(f"test_scope_function failed: {e}")
+
+    try:
+        test_scope_request()
+        print("test_scope_request passed")
+    except Exception as e:
+        print(f"test_scope_request failed: {e}")

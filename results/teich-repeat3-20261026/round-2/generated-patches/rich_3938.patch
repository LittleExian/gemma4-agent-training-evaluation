+from rich.console import Console
+from rich.text import Text
+import io
+
+def test_soft_wrap_background():
+    console = Console(file=io.StringIO(), width=20, soft_wrap=True, force_terminal=True)
+    text = Text("Hello World", style="on red")
+    # "Hello World" is 11 chars.
+    # With width 20, it should fit in one line.
+    # But if we make it longer than 20, it should soft wrap.
+    text = Text("This is a long line that will soft wrap", style="on red")
+    # "This is a long line that will soft wrap" is 39 chars.
+    # With width 20, it should wrap into 2 lines.
+    # Line 1: "This is a long line " (20 chars)
+    # Line 2: "that will soft wrap" (19 chars)
+    # We want Line 2 to have 1 space of red bg to fill the width.
+    console.print(text)
+    output = console.file.getvalue()
+    print(f"Output: {repr(output)}")
+    # We expect the output to have red bg until the end of the line.
+    # In terms of ANSI codes, it should have the red bg code and then spaces.
+
+if __name__ == "__main__":
+    test_soft_wrap_background()

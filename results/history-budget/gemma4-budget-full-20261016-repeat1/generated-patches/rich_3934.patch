+from rich.live import Live
+from rich.console import Console
+import sys
+
+def test_empty_live():
+    console = Console(file=sys.stdout)
+    print("Before live")
+    with Live("Hello", console=console, transient=True) as live:
+        print("Inside live")
+    print("After live")
+
+if __name__ == "__main__":
+    test_empty_live()

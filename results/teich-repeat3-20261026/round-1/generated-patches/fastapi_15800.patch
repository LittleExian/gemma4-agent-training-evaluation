index c7c551e4e..021e0324b 100644
--- a/fastapi/applications.py
+++ b/fastapi/applications.py
@@ -4692,3 +4692,29 @@ class FastAPI(Starlette):
             return func
 
         return decorator
+
+    def frontend(
+        self,
+        path: str,
+        *,
+        directory: str,
+        name: str | None = None,
+    ) -> None:
+        """
+        Mount a static directory to serve as the frontend.
+
+        Read more about it in the
+        [FastAPI docs for Static Files](https://fastapi.tiangolo.com/tutorial/staticfiles/).
+
+        ## Example
+
+        ```python
+        from fastapi import FastAPI
+
+        app = FastAPI()
+
+        app.frontend("/", directory="dist")
+        ```
+        """
+        from fastapi.staticfiles import StaticFiles
+        self.mount(path, app=StaticFiles(directory=directory), name=name or "frontend")

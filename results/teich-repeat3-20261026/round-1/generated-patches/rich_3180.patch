+from rich._wrap import divide_line
+from rich.console import Console
+
+def test_wrap():
+    text = "你好世界"
+    width = 1
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+    
+    # The expected divides should be [1, 2, 3] because each char is 2 cells
+    # and width is 1.
+    
+    # Let's see what rich.console.Console does
+    console = Console(width=width)
+    console.print(text)
+
+if __name__ == "__main__":
+    test_wrap()

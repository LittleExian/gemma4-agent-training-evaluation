new file mode 100644
index 00000000..901e08ef
--- /dev/null
+++ b/repro_router.py
@@ -0,0 +1,34 @@
+
+from fastapi import APIRouter, FastAPI
+import asyncio
+
+startup_called = False
+shutdown_called = False
+
+def startup_handler():
+    global startup_called
+    startup_called = True
+
+def shutdown_handler():
+    global shutdown_called
+    shutdown_called = True
+
+router = APIRouter(on_startup=[startup_handler], on_shutdown=[shutdown_handler])
+app = FastAPI()
+app.include_router(router)
+
+async def main():
+    # In FastAPI, when you include a router, the router's on_startup/on_shutdown
+    # handlers are merged into the app's lifespan.
+    # Let's see if they are actually called.
+    async with app.router.lifespan_context(app):
+        pass
+
+    print(f"Startup called: {startup_called}")
+    print(f"Shutdown called: {shutdown_called}")
+
+    assert startup_called, "Startup handler was not called"
+    assert shutdown_called, "Shutdown handler was not called"
+
+if __name__ == "__main__":
+    asyncio.run(main())

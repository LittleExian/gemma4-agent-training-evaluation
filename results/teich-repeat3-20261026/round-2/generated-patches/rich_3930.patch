+def split_graphemes(text: str) -> list[str]:
+    """Split text into grapheme clusters."""
+    if not text:
+        return []
+
+    # \p{M} = [\u0300-\u036f\u1ab0-\u1aff\u1dc0-\u1dff\u20d0-\u20ff\ufe20-\ufe2f\ufe00-\ufe0f]
+    # \P{M} = [^\u0300-\u036f\u1ab0-\u1aff\u1dc0-\u1dff\u20d0-\u20ff\ufe20-\ufe2f\ufe00-\ufe0f]
+    # \X = \P{M} ( \p{M} | \u200d \P{M} ( \p{M} | \u200d \P{M} )* )*
+
+    p_m = r"[\u0300-\u036f\u1ab0-\u1aff\u1dc0-\u1dff\u20d0-\u20ff\ufe20-\ufe2f\ufe00-\ufe0f]"
+    p_not_m = r"[^\u0300-\u036f\u1ab0-\u1aff\u1dc0-\u1dff\u20d0-\u20ff\ufe20-\ufe2f\ufe00-\ufe0f]"
+    regex = rf"{p_not_m}({p_m}|\u200d{p_not_m}({p_m}|\u200d{p_not_m})*)*"
+
+    return re.findall(regex, text)

@@ -0,0 +1,20 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+import json
+
+app = FastAPI()
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def shared_dependency(security=Security(oauth2_scheme)):
+    return security
+
+def scoped_dependency(security=Security(shared_dependency, scopes=["scope1"])):
+    return security
+
+@app.get("/test", dependencies=[Depends(shared_dependency), Depends(scoped_dependency)])
+def test_route():
+    return {"message": "hello"}
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))

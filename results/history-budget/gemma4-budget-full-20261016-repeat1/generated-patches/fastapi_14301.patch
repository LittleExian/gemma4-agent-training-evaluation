--- /dev/null
+++ b/tests/test_repro_scope.py
@@ -0,0 +1,22 @@
+import pytest
+from fastapi import Depends, FastAPI
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+call_count = 0
+def dep_a():
+    global call_count
+    call_count += 1
+    return "a"
+
+@app.get("/", dependencies=[Depends(dep_a, scope="request")])
+def root(a = Depends(dep_a)):
+    return {"call_count": call_count}
+
+client = TestClient(app)
+
+def test_request_scope_caching():
+    global call_count
+    call_count = 0
+    response = client.get("/")
+    assert response.json()["call_count"] == 1

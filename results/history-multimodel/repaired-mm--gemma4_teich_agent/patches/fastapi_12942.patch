+from fastapi import FastAPI, Body\nfrom pydantic import BaseModel, Field, Discriminator\nfrom typing import Union, Annotated, Literal\nfrom fastapi.testclient import TestClient\nimport pytest\n\nclass Cat(BaseModel):\n    type: Literal[\"cat\"] = \"cat\"\n    meows: bool\n\nclass Dog(BaseModel):\n    type: Literal[\"dog\"] = \"dog\"\n    barks: bool\n\napp = FastAPI()\n\n@app.post(\"/cat-dog\")\nasync def cat_dog(pet: Annotated[Annotated[Union[Cat, Dog], Discriminator(\"type\")], \"some metadata\"]):\n    return pet\n\nclient = TestClient(app)\n\ndef test_cat_dog():\n    # Test with Cat\n    response = client.post(\"/cat-dog\", json={\"type\": \"cat\", \"meows\": True})\n    assert response.status_code == 200\n    assert response.json() == {\"type\": \"cat\", \"meows\": True}\n\n    # Test with Dog\n    response = client.post(\"/cat-dog\", json={\"type\": \"dog\", \"barks\": True})\n    assert response.status_code == 200\n    assert response.json() == {\"type\": \"dog\", \"barks\": True}\n\nif __name__ == \"__main__\":\n    try:\n        test_cat_dog()\n        print(\"Test passed!\")\n    except Exception as e:\n        print(f\"Test failed: {e}\")\n        import traceback\n        traceback.print_exc()\n        exit(1)\n

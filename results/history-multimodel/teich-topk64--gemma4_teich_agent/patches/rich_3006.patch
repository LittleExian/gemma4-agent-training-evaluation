@@ -0,0 +1,20 @@
+from rich.repr import rich_repr
+
+class BadEq:
+    def __eq__(self, other):
+        return True
+    def __repr__(self):
+        return "BadEq()"
+
+@rich_repr
+class A:
+    def __init__(self, x=BadEq()):
+        self.x = x
+
+a = A(x=BadEq())
+print(f"repr(a): {repr(a)}")
+expected = "A(x=BadEq())"
+if repr(a) == expected:
+    print("SUCCESS")
+else:
+    print(f"FAILURE: expected {expected}, got {repr(a)}")

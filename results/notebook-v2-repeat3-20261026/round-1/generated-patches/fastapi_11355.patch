+from __future__ import annotations
+from fastapi import FastAPI
+from pydantic import BaseModel
+import inspect
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+@app.get("/items/")
+async def read_items(item: Item):
+    return item
+
+print(f"Annotations: {read_items.__annotations__}")
+# In Python 3.10 with from __future__ import annotations, 
+# read_items.__annotations__ should be {'item': 'Item'}
+
+# Now let's see how FastAPI handles it.
+# We can check the route's endpoint and its parameters.
+for route in app.routes:
+    if route.path == "/items/":
+        print(f"Route endpoint: {route.endpoint}")
+        # FastAPI processes the endpoint in APIRoute.__init__
+        # Let's see if it resolved the type.
+        # The resolved parameters are stored in route.endpoint_class or similar?
+        # Actually, APIRoute has a `route_class` and it creates a `route` object.
+        # The parameters are in route.endpoint_class? No.
+        # Let's check route.endpoint's annotations after FastAPI has processed it.
+        print(f"Resolved annotations: {route.endpoint.__annotations__}")
+        # Wait, FastAPI doesn't modify the original function's annotations.
+        # It creates a `route` object that contains the resolved parameters.
+        # Let's look at route.endpoint_class or route.endpoint.
+        # Actually, APIRoute has `route.endpoint` which is the original function.
+        # The resolved parameters are in `route.endpoint_class`? No.
+        # Let's check `route.endpoint`'s `__annotations__` again.
+        # If FastAPI uses get_type_hints, it should work.
+        # But where does it store the resolved types?
+        # In APIRoute, it's in `self.endpoint_class`? No.
+        # Let's check `route.endpoint`'s `__annotations__` after the app is created.
+        # Actually, let's just check if the route was created successfully.
+        print("Route created successfully")
+

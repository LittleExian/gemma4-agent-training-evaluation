@@ -0,0 +1,49 @@
+from fastapi import FastAPI
+from pydantic import BaseModel, computed_field
+from fastapi.openapi.utils import get_openapi
+from fastapi.routing import APIRoute
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    @computed_field
+    @property
+    def description(self) -> str:
+        return f"Item {self.name}"
+
+@app.get("/items", response_model=Item)
+def read_item():
+    return Item(name="test")
+
+def test_openapi_computed_field(separate_input_output_schemas: bool):
+    app.openapi_extra = {"separate_input_output_schemas": separate_input_output_schemas}
+    # We need to override the default get_openapi behavior or pass it to get_openapi
+    # But app.openapi() doesn't take separate_input_output_schemas.
+    # It's a parameter of get_openapi.
+    
+    routes = app.routes
+    openapi_schema = get_openapi(
+        title="Test",
+        version="0.1.0",
+        openapi_version="3.1.0",
+        routes=routes,
+        separate_input_output_schemas=separate_input_output_schemas,
+    )
+    
+    # Find the Item schema in components/schemas
+    if "components" not in openapi_schema:
+        print(f"separate_input_output_schemas={separate_input_output_schemas}: components missing")
+        return False
+    
+    item_schema = openapi_schema["components"].get("schemas", {}).get("Item")
+    if not item_schema:
+        print(f"separate_input_output_schemas={separate_input_output_schemas}: Item schema missing")
+        return False
+    
+    print(f"separate_input_output_schemas={separate_input_output_schemas}, Item schema properties: {item_schema['properties'].keys()}")
+    return "description" in item_schema["properties"]
+
+if __name__ == "__main__":
+    print(f"separate_input_output_schemas=True: {test_openapi_computed_field(True)}")
+    print(f"separate_input_output_schemas=False: {test_openapi_computed_field(False)}")

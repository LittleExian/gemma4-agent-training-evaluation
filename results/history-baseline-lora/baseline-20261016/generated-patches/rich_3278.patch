diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..37ae1834
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,17 @@
+from rich.ansi import _ansi_tokenize
+
+text = "Hello\x1b7World"
+tokens = list(_ansi_tokenize(text))
+print(f"Tokens: {tokens}")
+
+def strip_ansi(text):
+    result = []
+    for token in _ansi_tokenize(text):
+        if token.plain:
+            result.append(token.plain)
+    return "".join(result)
+
+stripped = strip_ansi(text)
+print(f"Stripped: {repr(stripped)}")
+assert stripped == "HelloWorld", f"Expected 'HelloWorld', got {repr(stripped)}"
+print("Success!")

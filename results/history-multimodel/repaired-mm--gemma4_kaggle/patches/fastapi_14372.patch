+from fastapi import Depends, Security
+
+def test_equality():
+    d1 = Depends(dependency=lambda: None, use_cache=True)
+    d2 = Depends(dependency=lambda: None, use_cache=True)
+    # Note: lambdas are not equal, so d1 != d2.
+    # Let's use a named function.
+    def my_dep(): pass
+    d3 = Depends(dependency=my_dep, use_cache=True)
+    d4 = Depends(dependency=my_dep, use_cache=True)
+    
+    print(f"d3 == d4: {d3 == d4}") # Should be True
+    
+    s1 = Security(dependency=my_dep, scopes=["read"])
+    s2 = Security(dependency=my_dep, scopes=["read"])
+    print(f"s1 == s2: {s1 == s2}") # Should be True
+
+if __name__ == "__main__":
+    test_equality()

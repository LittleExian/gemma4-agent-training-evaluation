+++ b/repro.py
@@ -0,0 +1,47 @@
+
+import asyncio
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test-file-after-form")
+async def test_file_after_form(form_data: str = Form(...), file: bytes = File(...)):
+    return {"form_data": form_data, "file_len": len(file)}
+
+@app.post("/test-form-after-file")
+async def test_form_after_file(file: bytes = File(...), form_data: str = Form(...)):
+    return {"form_data": form_data, "file_len": len(file)}
+
+client = TestClient(app)
+
+def test_repro():
+    # Case 1: File follows Form
+    response = client.post(
+        "/test-file-after-form",
+        data={"form_data": "hello"},
+        files={"file": b"world"}
+    )
+    print(f"Case 1 (File after Form) status: {response.status_code}")
+    assert response.status_code == 200, f"Case 1 failed with status {response.status_code}: {response.text}"
+    assert response.json() == {"form_data": "hello", "file_len": 5}
+
+    # Case 2: Form follows File
+    response = client.post(
+        "/test-form-after-file",
+        data={"form_data": "hello"},
+        files={"file": b"world"}
+    )
+    print(f"Case 2 (Form after File) status: {response.status_code}")
+    assert response.status_code == 200, f"Case 2 failed with status {response.status_code}: {response.text}"
+    assert response.json() == {"form_data": "hello", "file_len": 5}
+
+if __name__ == "__main__":
+    try:
+        test_repro()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

+from rich.console import Console, ConsoleOptions
+from rich.syntax import Syntax
+
+console = Console()
+options = ConsoleOptions()
+try:
+    syntax = Syntax("print('hello')", lexer="python", padding=None)
+    syntax.__rich_measure__(console, options)
+    print("Success!")
+except Exception as e:
+    print(f"Caught exception: {e}")
+    import traceback
+    traceback.print_exc()

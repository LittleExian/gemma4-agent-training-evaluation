new file mode 100644
index 00000000..1380e2b2
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,34 @@
+
+import requests
+from requests.models import Request, PreparedRequest
+
+class FileWrapper:
+    def __init__(self, data):
+        self.data = data
+    def __getattr__(self, name):
+        if name == 'read':
+            return lambda length=None: self.data
+        raise AttributeError(name)
+
+def test_getattr_wrapper():
+    data = b'hello world'
+    wrapper = FileWrapper(data)
+    files = {'file': ('test.txt', wrapper)}
+    
+    # We want to see if requests can handle this wrapper
+    # We can use requests.Request and then prepare it
+    req = Request('POST', 'http://httpbin.org/post', files=files)
+    prepared = req.prepare()
+    
+    # The body should contain the data from the wrapper
+    assert data in prepared.body
+    print("Test passed!")
+
+if __name__ == '__main__':
+    try:
+        test_getattr_wrapper()
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

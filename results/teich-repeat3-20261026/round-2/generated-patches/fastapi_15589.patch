@@ -0,0 +1,28 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class UserHeaders(BaseModel):
+    user_id: str
+
+@app.get("/")
+async def read_root(headers: UserHeaders = Header(convert_underscores=False)):
+    return {"user_id": headers.user_id}
+
+client = TestClient(app)
+
+def test_model_header_no_convert_underscores():
+    # convert_underscores=False, should accept user_id
+    response = client.get("/", headers={"user_id": "123"})
+    assert response.status_code == 200
+    assert response.json() == {"user_id": "123"}
+
+    # should NOT accept user-id (unless it's also the field name)
+    response = client.get("/", headers={"user-id": "123"})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    test_model_header_no_convert_underscores()
+    print("Test passed!")

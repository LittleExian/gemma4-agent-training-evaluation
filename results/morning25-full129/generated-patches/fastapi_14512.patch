@@ -0,0 +1,46 @@
+from typing import Union, Annotated, Literal
+from pydantic import BaseModel
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+
+class Cat(BaseModel):
+    type: Literal["cat"] = "cat"
+    meow: str
+
+class Dog(BaseModel):
+    type: Literal["dog"] = "dog"
+    bark: str
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(item: Annotated[Union[Cat, Dog], Body(discriminator="type")]):
+    return item
+
+client = TestClient(app)
+
+def test_discriminator():
+    # This should work
+    response = client.post("/test", json={"type": "cat", "meow": "meow"})
+    assert response.status_code == 200
+    assert response.json() == {"type": "cat", "meow": "meow"}
+
+    # This should fail because "type" is "cat" but "bark" is provided
+    # If discriminator is working, it should fail with a validation error for "meow" missing
+    # If discriminator is NOT working, it might try to match Dog and fail because "type" is "cat"
+    # or it might try to match Cat and fail because "meow" is missing.
+    
+    # Let's try a case that would fail if discriminator is NOT used.
+    # If discriminator is used, it should immediately know it's a Cat and fail because "meow" is missing.
+    # If discriminator is NOT used, it will try Cat (fail) then try Dog (fail).
+    
+    response = client.post("/test", json={"type": "cat", "bark": "bark"})
+    assert response.status_code == 422
+    
+    # Let's check the error message.
+    # If discriminator is working, the error should be about "meow" missing.
+    # If discriminator is NOT working, it might be a different error.
+    print(response.json())
+
+if __name__ == "__main__":
+    test_discriminator()

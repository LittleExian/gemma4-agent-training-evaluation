+def graphemes(text: str) -> Iterable[str]:
+    """Split a string into graphemes."""
+    if not text:
+        return
+    start = 0
+    for i in range(1, len(text)):
+        if (
+            unicodedata.category(text[i]).startswith("M")
+            or text[i] == "‍"
+            or text[i - 1] == "‍"
+        ):
+            continue
+        yield text[start:i]
+        start = i
+    yield text[start:]
+

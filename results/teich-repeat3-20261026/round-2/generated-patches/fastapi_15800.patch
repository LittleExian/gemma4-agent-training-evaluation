diff --git a/verify_frontend.py b/verify_frontend.py
new file mode 100644
index 000000000..53ddb2581
--- /dev/null
+++ b/verify_frontend.py
@@ -0,0 +1,48 @@
+
+import os
+import shutil
+from fastapi import FastAPI, APIRouter
+from fastapi.testclient import TestClient
+from starlette.staticfiles import StaticFiles
+
+def test_fastapi_frontend():
+    app = FastAPI()
+    dist_dir = "test_dist"
+    os.makedirs(dist_dir, exist_ok=True)
+    with open(os.path.join(dist_dir, "index.html"), "w") as f:
+        f.write("Hello FastAPI Frontend")
+    
+    app.frontend("/", directory=dist_dir)
+    
+    client = TestClient(app)
+    response = client.get("/")
+    print(f"FastAPI: status_code={response.status_code}, text={response.text}")
+    assert response.status_code == 200
+    assert response.text == "Hello FastAPI Frontend"
+    
+    shutil.rmtree(dist_dir)
+    print("test_fastapi_frontend passed")
+
+def test_apirouter_frontend():
+    app = FastAPI()
+    router = APIRouter(prefix="/api")
+    dist_dir = "test_dist_router"
+    os.makedirs(dist_dir, exist_ok=True)
+    with open(os.path.join(dist_dir, "index.html"), "w") as f:
+        f.write("Hello APIRouter Frontend")
+    
+    router.frontend("/", directory=dist_dir)
+    app.include_router(router)
+    
+    client = TestClient(app)
+    # The path should be /api/ because of the prefix and the path in frontend
+    response = client.get("/api/")
+    assert response.status_code == 200
+    assert response.text == "Hello APIRouter Frontend"
+    
+    shutil.rmtree(dist_dir)
+    print("test_apirouter_frontend passed")
+
+if __name__ == "__main__":
+    test_fastapi_frontend()
+    test_apirouter_frontend()

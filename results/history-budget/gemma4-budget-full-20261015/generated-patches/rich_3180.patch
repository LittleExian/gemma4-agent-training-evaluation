+from rich.text import Text
+from rich.console import Console
+from io import StringIO
+
+def test_cjk_fold():
+    # Width 1. "你好"
+    # "你好" is 4 cells.
+    # Line 1: "你" (2 cells) -> truncate(1, overflow="fold") -> " "
+    # Line 2: "好" (2 cells) -> truncate(1, overflow="fold") -> " "
+    
+    console = Console(width=1, force_terminal=False)
+    text = Text("你好")
+    text.overflow = "fold"
+    
+    output = StringIO()
+    console.file = output
+    console.print(text)
+    
+    result = output.getvalue()
+    print(f"Result: {repr(result)}")
+
+if __name__ == "__main__":
+    test_cjk_fold()

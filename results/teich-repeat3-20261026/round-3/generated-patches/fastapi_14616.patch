diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..c9dd25a4
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,30 @@
+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import List
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Json[List[str]] = Form()):
+    return {"data": data}
+
+client = TestClient(app)
+
+def test_json_form():
+    # The input is a JSON string representing a list of strings
+    json_string = '["abc", "def"]'
+    # We send it as a form field
+    response = client.post("/test", data={"data": json_string})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["data"] == ["abc", "def"]
+
+if __name__ == "__main__":
+    try:
+        test_json_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()

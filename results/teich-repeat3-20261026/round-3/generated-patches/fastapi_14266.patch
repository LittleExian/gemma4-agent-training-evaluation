--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,23 @@
+from fastapi import FastAPI, Depends
+from fastapi.security import OAuth2PasswordBearer
+import json
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+app = FastAPI(dependencies=[Depends(oauth2_scheme)])
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
+
+# Check if 'components' -> 'securitySchemes' exists and contains 'oauth2_scheme' (or similar)
+# and if 'security' is present at the top level.
+
+if "components" in openapi_schema and "securitySchemes" in openapi_schema["components"]:
+    print("Security schemes found in components")
+else:
+    print("Security schemes NOT found in components")
+
+if "security" in openapi_schema:
+    print("Security found at top level")
+else:
+    print("Security NOT found at top level")

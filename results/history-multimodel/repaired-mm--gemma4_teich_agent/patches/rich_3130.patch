+from rich.markdown import Markdown
+from rich.console import Console
+from rich.console import ConsoleOptions
+from rich.style import Style
+from rich.text import Text
+from rich.markdown import MarkdownContext, TableDataElement
+
+def test_table_data_element_on_text():
+    element = TableDataElement(justify="left")
+    console = Console()
+    context = MarkdownContext(console, console.options, Style())
+    
+    element.on_text(context, "Hello ")
+    element.on_text(context, Text("World", style="bold"))
+    element.on_text(context, "!")
+    
+    print(f"Content: {element.content}")
+    if isinstance(element.content, Text):
+        print(f"Content plain: {element.content.plain}")
+    else:
+        print(f"Content is not Text: {type(element.content)}")
+
+if __name__ == "__main__":
+    test_table_data_element_on_text()

@@ -0,0 +1,22 @@
+from rich.console import Console
+from rich.table import Table
+from rich.text import Text
+
+def test_column_highlight_inheritance():
+    console = Console(force_terminal=True)
+    
+    # Table with highlight=True
+    table = Table(highlight=True)
+    # Add a row with more columns than currently exist
+    table.add_row("1", "2", "3") 
+    
+    # The columns were added automatically. 
+    # Let's check if they have highlight=True
+    for col in table.columns:
+        print(f"Column {col._index} highlight: {col.highlight}")
+        assert col.highlight is True
+
+    print("Test passed!")
+
+if __name__ == "__main__":
+    test_column_highlight_inheritance()

@@ -0,0 +1,34 @@
+from rich.segment import Segment
+from rich.text import Text
+
+def test_split_cells():
+    # A character with width 2.
+    # Let's use a character that is known to be width 2.
+    # '😀' is usually width 2.
+    text = "a😀b"
+    # cell_len("a") = 1
+    # cell_len("a😀") = 3
+    # cell_len("a😀b") = 4
+    
+    segment = Segment(text, None, None)
+    
+    # Cut at 1: "a" | "😀b"
+    s1, s2 = segment.split_cells(1)
+    print(f"Cut at 1: {repr(s1.text)} | {repr(s2.text)}")
+    assert s1.text == "a"
+    assert s2.text == "😀b"
+    
+    # Cut at 2: "a " | " b" (😀 is split)
+    s1, s2 = segment.split_cells(2)
+    print(f"Cut at 2: {repr(s1.text)} | {repr(s2.text)}")
+    assert s1.text == "a "
+    assert s2.text == " b"
+    
+    # Cut at 3: "a😀" | "b"
+    s1, s2 = segment.split_cells(3)
+    print(f"Cut at 3: {repr(s1.text)} | {repr(s2.text)}")
+    assert s1.text == "a😀"
+    assert s2.text == "b"
+
+if __name__ == "__main__":
+    test_split_cells()

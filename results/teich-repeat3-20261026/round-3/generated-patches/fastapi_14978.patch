diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..4e39ffe9
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,71 @@
+from fastapi import FastAPI, Body, HTTPException
+from fastapi.testclient import TestClient
+import pytest
+import json
+
+app = FastAPI()
+
+@app.post("/strict", status_code=200)
+async def strict_endpoint(body: dict = Body(..., strict_content_type=True, media_type="application/json")):
+    return body
+
+@app.post("/flexible", status_code=200)
+async def flexible_endpoint(body: dict = Body(..., strict_content_type=False, media_type="application/json")):
+    return body
+
+@app.post("/problem", status_code=200)
+async def problem_endpoint(body: dict = Body(..., strict_content_type=True, media_type="application/problem+json")):
+    return body
+
+client = TestClient(app)
+
+def test_strict_json_ok():
+    response = client.post("/strict", json={"a": 1}, headers={"Content-Type": "application/json"})
+    assert response.status_code == 200
+    assert response.json() == {"a": 1}
+
+def test_strict_json_fail_problem():
+    response = client.post("/strict", json={"a": 1}, headers={"Content-Type": "application/problem+json"})
+    assert response.status_code == 415
+    assert response.json()["detail"] == "Content-Type must be application/json"
+
+def test_strict_json_fail_missing():
+    response = client.post("/strict", content=json.dumps({"a": 1}), headers={})
+    assert response.status_code == 415
+    assert response.json()["detail"] == "Content-Type must be application/json"
+
+def test_flexible_json_ok():
+    response = client.post("/flexible", json={"a": 1}, headers={"Content-Type": "application/json"})
+    assert response.status_code == 200
+    assert response.json() == {"a": 1}
+
+def test_flexible_json_ok_problem():
+    response = client.post("/flexible", json={"a": 1}, headers={"Content-Type": "application/problem+json"})
+    assert response.status_code == 200
+    assert response.json() == {"a": 1}
+
+def test_flexible_json_ok_missing():
+    response = client.post("/flexible", json={"a": 1}, headers={})
+    assert response.status_code == 200
+    assert response.json() == {"a": 1}
+
+def test_problem_ok():
+    response = client.post("/problem", json={"a": 1}, headers={"Content-Type": "application/problem+json"})
+    assert response.status_code == 200
+    assert response.json() == {"a": 1}
+
+def test_problem_fail_json():
+    response = client.post("/problem", json={"a": 1}, headers={"Content-Type": "application/json"})
+    assert response.status_code == 415
+    assert response.json()["detail"] == "Content-Type must be application/problem+json"
+
+if __name__ == "__main__":
+    test_strict_json_ok()
+    test_strict_json_fail_problem()
+    test_strict_json_fail_missing()
+    test_flexible_json_ok()
+    test_flexible_json_ok_problem()
+    test_flexible_json_ok_missing()
+    test_problem_ok()
+    test_problem_fail_json()
+    print("All tests passed!")

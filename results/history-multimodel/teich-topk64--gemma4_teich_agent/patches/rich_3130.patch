+from rich.console import Console
+from rich.markdown import Markdown
+
+console = Console(record=True)
+markdown_text = """
+| Header 1 | Header 2 |
+| --- | --- |
+| *Italic* and **Bold** | Normal |
+| [Link](https://google.com) and *Italic* | Normal |
+"""
+markdown = Markdown(markdown_text)
+console.print(markdown)
+
+output = console.export_text()
+print(output)
+
+# Check if both styles are present in the first cell of the first row
+# The output should contain "Italic and Bold"
+if "Italic and Bold" in output:
+    print("SUCCESS: Mixed styles in table cell are preserved")
+else:
+    print("FAILURE: Mixed styles in table cell are lost")
+
+# Check if link and italic are present
+if "Link" in output and "Italic" in output:
+    print("SUCCESS: Link and mixed styles in table cell are preserved")
+else:
+    print("FAILURE: Link and mixed styles in table cell are lost")

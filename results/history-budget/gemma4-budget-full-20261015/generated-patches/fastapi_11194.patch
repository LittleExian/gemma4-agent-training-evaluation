@@ -0,0 +1,39 @@
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/test_order_1")
+async def test_order_1(file: bytes = File(...), form_data: str = Form(...)):
+    return {"file_len": len(file), "form_data": form_data}
+
+@app.post("/test_order_2")
+async def test_order_2(form_data: str = Form(...), file: bytes = File(...)):
+    return {"file_len": len(file), "form_data": form_data}
+
+client = TestClient(app)
+
+def test_repro():
+    # Test order 1: File then Form (should work)
+    response = client.post(
+        "/test_order_1",
+        data={"form_data": "hello"},
+        files={"file": ("test.txt", b"content")}
+    )
+    assert response.status_code == 200
+    assert response.json() == {"file_len": 7, "form_data": "hello"}
+
+    # Test order 2: Form then File (should fail according to problem statement)
+    response = client.post(
+        "/test_order_2",
+        data={"form_data": "hello"},
+        files={"file": ("test.txt", b"content")}
+    )
+    print(f"Response status code: {response.status_code}")
+    print(f"Response body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"file_len": 7, "form_data": "hello"}
+
+if __name__ == "__main__":
+    test_repro()

+def is_async_callable(call: Any) -> bool:
+    current = call
+    while True:
+        if inspect.isclass(current):
+            return False
+        if starlette_is_async_callable(current):
+            return True
+        if isinstance(current, functools.partial):
+            current = current.func
+        else:
+            unwrapped = inspect.unwrap(current)
+            if unwrapped is current:
+                break
+            current = unwrapped
+    return False
+
+
+def is_gen_callable(call: Any) -> bool:
+    current = call
+    while True:
+        if inspect.isclass(current):
+            return False
+        if inspect.isgeneratorfunction(current):
+            return True
+        if hasattr(current, "__call__") and inspect.isgeneratorfunction(current.__call__):
+            return True
+        if isinstance(current, functools.partial):
+            current = current.func
+        else:
+            unwrapped = inspect.unwrap(current)
+            if unwrapped is current:
+                break
+            current = unwrapped
+    return False
+
+
+def is_async_gen_callable(call: Any) -> bool:
+    current = call
+    while True:
+        if inspect.isclass(current):
+            return False
+        if inspect.isasyncgenfunction(current):
+            return True
+        if hasattr(current, "__call__") and inspect.isasyncgenfunction(current.__call__):
+            return True
+        if isinstance(current, functools.partial):
+            current = current.func
+        else:
+            unwrapped = inspect.unwrap(current)
+            if unwrapped is current:
+                break
+            current = unwrapped
+    return False

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..38a9b07b
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+from fastapi import FastAPI, Form
+from pydantic import BaseModel, Json
+from typing import List
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(tags: Json[List[str]] = Form()):
+    return {"tags": tags}
+
+client = TestClient(app)
+
+def test_json_list_form():
+    # The input is a JSON string representing a list of strings
+    # In a form, this is sent as a single field with the JSON string as value
+    response = client.post("/test", data={"tags": '["abc", "def"]'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"tags": ["abc", "def"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_list_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()

diff --git a/verify_tty_interactive.py b/verify_tty_interactive.py
new file mode 100644
index 00000000..1ac893b9
--- /dev/null
+++ b/verify_tty_interactive.py
@@ -0,0 +1,54 @@
+import os
+from rich.console import Console
+from rich.progress import Progress
+from rich.status import Status
+import time
+
+def test_progress_disabled():
+    os.environ["TTY_INTERACTIVE"] = "0"
+    console = Console()
+    with Progress(console=console) as progress:
+        task = progress.add_task("Testing progress")
+        progress.update(task, advance=1)
+    # If disabled, it should not have started the live display.
+    # We can check if progress.disable is True.
+    assert progress.disable is True
+
+def test_progress_enabled():
+    os.environ["TTY_INTERACTIVE"] = "1"
+    console = Console()
+    with Progress(console=console) as progress:
+        task = progress.add_task("Testing progress")
+        progress.update(task, advance=1)
+    assert progress.disable is False
+
+def test_status_disabled():
+    os.environ["TTY_INTERACTIVE"] = "0"
+    console = Console()
+    with Status("Testing status", console=console) as status:
+        # If disabled, status._live.is_started should be False.
+        assert status._live.is_started is False
+
+def test_status_enabled():
+    os.environ["TTY_INTERACTIVE"] = "1"
+    console = Console()
+    with Status("Testing status", console=console) as status:
+        assert status._live.is_started is True
+
+if __name__ == "__main__":
+    try:
+        test_progress_disabled()
+        print("test_progress_disabled passed")
+        test_progress_enabled()
+        print("test_progress_enabled passed")
+        test_status_disabled()
+        print("test_status_disabled passed")
+        test_status_enabled()
+        print("test_status_enabled passed")
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

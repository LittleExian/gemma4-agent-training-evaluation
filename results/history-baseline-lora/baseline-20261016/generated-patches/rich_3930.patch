+def graphemes(text: str) -> Iterable[str]:
+    """Split a string into graphemes."""
+    if not text:
+        return
+
+    cluster = ""
+    for char in text:
+        if not cluster:
+            cluster += char
+            continue
+
+        # If the current character is a combining mark, it's part of the cluster
+        if unicodedata.category(char).startswith("M"):
+            cluster += char
+            continue
+
+        # If the current character is an emoji modifier, it's part of the cluster
+        if "\U0001F3FB" <= char <= "\U0001F3FF":
+            cluster += char
+            continue
+
+        # If the previous character was a ZWJ, the current character is part of the cluster
+        if cluster[-1] == "\u200D":
+            cluster += char
+            continue
+
+        # If the current character is a ZWJ, it's part of the cluster
+        if char == "\u200D":
+            cluster += char
+            continue
+
+        yield cluster
+        cluster = char
+
+    if cluster:
+        yield cluster
+

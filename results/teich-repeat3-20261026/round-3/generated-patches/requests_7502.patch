diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..0fe57269
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,42 @@
+import requests
+from requests.models import RequestEncodingMixin, PreparedRequest
+from requests.structures import CaseInsensitiveDict
+from io import BytesIO
+
+class FileWrapper:
+    def __init__(self, content):
+        self._content = BytesIO(content)
+    def __getattr__(self, name):
+        return getattr(self._content, name)
+
+def test_encode_files_with_getattr_wrapper():
+    # We need a class that inherits from RequestEncodingMixin and has a url
+    class MockRequest(RequestEncodingMixin):
+        def __init__(self, url):
+            self.url = url
+        def prepare_body(self, data, files):
+            # This is a simplified version of what PreparedRequest.prepare_body does
+            # but we want to test _encode_files specifically.
+            # In requests, _encode_files is a static method of RequestEncodingMixin.
+            return self._encode_files(files, data)
+
+    files = {"file": FileWrapper(b"hello world")}
+    data = {}
+    # _encode_files is a static method of RequestEncodingMixin
+    # It returns (body, content_type)
+    body, content_type = RequestEncodingMixin._encode_files(files, data)
+    
+    # If it worked, the content should be read from the FileWrapper
+    # and put into the body.
+    assert b"hello world" in body, f"Expected b'hello world' in body, got {body}"
+    print("Body contains content!")
+
+if __name__ == "__main__":
+    try:
+        test_encode_files_with_getattr_wrapper()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

diff --git a/verify_graphemes.py b/verify_graphemes.py
new file mode 100644
index 00000000..922c5e8f
--- /dev/null
+++ b/verify_graphemes.py
@@ -0,0 +1,61 @@
+
+import unicodedata
+from rich.cells import split_graphemes, cell_len, set_cell_size, chop_cells
+
+def test_split_graphemes():
+    # Basic
+    assert split_graphemes("abc") == ["a", "b", "c"]
+    # Combining mark
+    assert split_graphemes("a\u0301") == ["a\u0301"]
+    # Emoji with modifier
+    assert split_graphemes("👋🏾") == ["👋🏾"]
+    # ZWJ sequence
+    assert split_graphemes("👨‍👩‍👧‍👦") == ["👨‍👩‍👧‍👦"]
+    # RIS (Flags)
+    assert split_graphemes("🇺🇸") == ["🇺🇸"]
+    assert split_graphemes("🇺🇸🇺🇸") == ["🇺🇸", "🇺🇸"]
+    assert split_graphemes("🇺🇸🇺🇸🇺🇸") == ["🇺🇸", "🇺🇸🇺🇸"] # Wait, RIS should be pairs. 🇺🇸 is 2 RIS. 🇺🇸🇺🇸🇺🇸 is 6 RIS.
+    # Let's check RIS properly.
+    # 🇺🇸 is U+1F1FA U+1F1F8
+    # 🇺🇸🇺🇸 is U+1F1FA U+1F1F8 U+1F1FA U+1F1F8
+    # 🇺🇸🇺🇸🇺🇸 is U+1F1FA U+1F1F8 U+1F1FA U+1F1F8 U+1F1FA U+1F1F8
+    # So 🇺🇸🇺🇸🇺🇸 should be ["🇺🇸", "🇺🇸", "🇺🇸"]
+    
+    # Let's test with actual codepoints
+    ris1 = "\U0001f1fa"
+    ris2 = "\U0001f1f8"
+    assert split_graphemes(ris1 + ris2) == [ris1 + ris2]
+    assert split_graphemes(ris1 + ris2 + ris1 + ris2) == [ris1 + ris2, ris1 + ris2]
+    assert split_graphemes(ris1 + ris2 + ris1) == [ris1 + ris2, ris1]
+
+def test_set_cell_size():
+    # Wide character
+    assert set_cell_size("👋", 1) == " "
+    assert set_cell_size("👋", 2) == "👋"
+    # Grapheme cluster
+    # 👋🏾 is width 2.
+    assert set_cell_size("👋🏾", 1) == " "
+    assert set_cell_size("👋🏾", 2) == "👋🏾"
+    # Combining mark
+    # a\u0301 is width 1.
+    assert set_cell_size("a\u0301", 1) == "a\u0301"
+
+def test_chop_cells():
+    # Wide character
+    assert chop_cells("👋👋", 2) == ["👋", "👋"]
+    # Grapheme cluster
+    # 👋🏾 is width 2.
+    assert chop_cells("👋🏾👋🏾", 2) == ["👋🏾", "👋🏾"]
+
+if __name__ == "__main__":
+    try:
+        test_split_graphemes()
+        print("test_split_graphemes passed")
+        test_set_cell_size()
+        print("test_set_cell_size passed")
+        test_chop_cells()
+        print("test_chop_cells passed")
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

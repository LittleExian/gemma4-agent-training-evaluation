@@ -10,6 +10,37 @@ from starlette.responses import Response as Response  # noqa
 from starlette.responses import StreamingResponse as StreamingResponse  # noqa
 from typing_extensions import deprecated
 
+
+class EventSourceResponse(StreamingResponse):
+    """
+    Response for Server-Sent Events (SSE).
+
+    Sets the `Content-Type` to `text/event-stream`, `Cache-Control` to `no-cache`,
+    and `Connection` to `keep-alive`.
+    """
+
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: Any = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ) -> None:
+        if headers is None:
+            headers = {}
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        headers["Content-Type"] = media_type
+        super().__init__(
+            content=content,
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type=None,
+        )
+

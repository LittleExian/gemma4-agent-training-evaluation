@@ -0,0 +1,29 @@
+from fastapi import FastAPI, Body
+from fastapi.openapi.utils import get_openapi
+from pydantic import BaseModel, Field
+from typing import Annotated, Union
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    type: str = "cat"
+    meow: str = "meow"
+
+class Dog(BaseModel):
+    type: str = "dog"
+    bark: str = "bark"
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+
+@app.post("/pet")
+def create_pet(pet: Annotated[Pet, Body()]):
+    return pet
+
+openapi_schema = get_openapi(
+    title="FastAPI",
+    version="0.1.0",
+    routes=app.routes,
+)
+
+import json
+print(json.dumps(openapi_schema, indent=2))
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..f0cdcc57
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+
+class Cat(BaseModel):
+    type: Literal["cat"]
+    meows: bool
+
+class Dog(BaseModel):
+    type: Literal["dog"]
+    barks: bool
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Pet, Body()]):
+    return pet
+
+client = TestClient(app)
+
+def test_cat():
+    response = client.post("/pet", json={"type": "cat", "meows": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "cat", "meows": True}
+
+def test_dog():
+    response = client.post("/pet", json={"type": "dog", "barks": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "dog", "barks": True}
+
+def test_invalid():
+    response = client.post("/pet", json={"type": "bird", "wings": True})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_cat()
+        print("test_cat passed")
+        test_dog()
+        print("test_dog passed")
+        test_invalid()
+        print("test_invalid passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

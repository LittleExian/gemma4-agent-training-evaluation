diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..be893ccd
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,37 @@
+
+import requests
+from requests.models import Request
+
+class FileWrapper:
+    def __init__(self, fileobj):
+        self._fileobj = fileobj
+    def __getattr__(self, name):
+        return getattr(self._fileobj, name)
+
+class MockFile:
+    def read(self, length=None):
+        return b"file content"
+
+def test_getattr_wrapper():
+    mock_file = MockFile()
+    wrapper = FileWrapper(mock_file)
+    
+    # This is what _encode_files does internally
+    # It checks if the file object is an instance of _SupportsRead
+    # We can simulate this by calling requests.Request('POST', 'http://httpbin.org/post', files={'file': wrapper}).prepare()
+    
+    req = Request('POST', 'http://httpbin.org/post', files={'file': wrapper})
+    prepared = req.prepare()
+    
+    print(f"Body: {prepared.body}")
+    assert b"file content" in prepared.body
+
+if __name__ == "__main__":
+    try:
+        test_getattr_wrapper()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

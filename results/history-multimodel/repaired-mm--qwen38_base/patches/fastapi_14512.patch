diff --git a/repro5.py b/repro5.py
new file mode 100644
index 00000000..35e6af9e
--- /dev/null
+++ b/repro5.py
@@ -0,0 +1,32 @@
+from typing import Annotated, Literal, Union
+from pydantic import BaseModel
+from fastapi import Body
+from fastapi._compat.v2 import copy_field_info, ModelField
+
+
+class Cat(BaseModel):
+    pet_type: Literal["cat"]
+    meows: bool
+
+
+class Dog(BaseModel):
+    pet_type: Literal["dog"]
+    barks: float
+
+
+bi = Body(discriminator="pet_type")
+ann = Annotated[Union[Cat, Dog], bi]
+
+merged = type(bi).from_annotation(ann)
+print("merged.annotation:", merged.annotation)
+print("merged.discriminator:", merged.discriminator)
+print("merged.metadata:", merged.metadata)
+
+new = copy_field_info(field_info=bi, annotation=ann)
+print("new.annotation:", new.annotation)
+print("new.discriminator:", new.discriminator)
+print("new.metadata:", new.metadata)
+
+mf = ModelField(field_info=new, name="things")
+print("type_adapter:", mf._type_adapter)
+print("core schema:", mf._type_adapter.core_schema)

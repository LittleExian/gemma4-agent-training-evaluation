diff --git a/reproduce_partial.py b/reproduce_partial.py
new file mode 100644
index 00000000..b8cd42ec
--- /dev/null
+++ b/reproduce_partial.py
@@ -0,0 +1,30 @@
+
+import inspect
+from functools import partial
+from typing import Any, Dict, Callable
+from fastapi.dependencies.utils import get_typed_signature
+
+def get_typed_annotation(annotation: Any, globalns: Dict[str, Any]) -> Any:
+    return annotation
+
+def test_partial():
+    def my_dep(q: str):
+        return q
+
+    p = partial(my_dep, q="foo")
+    sig = get_typed_signature(p)
+    print(f"Signature: {sig}")
+    print(f"Parameters: {sig.parameters}")
+
+    class MyClass:
+        def __call__(self, q: str):
+            return q
+
+    c = MyClass()
+    p_c = partial(c, q="foo")
+    sig_c = get_typed_signature(p_c)
+    print(f"Class Signature: {sig_c}")
+    print(f"Class Parameters: {sig_c.parameters}")
+
+if __name__ == "__main__":
+    test_partial()
diff --git a/reproduce_partial_forward_ref.py b/reproduce_partial_forward_ref.py
new file mode 100644
index 00000000..b4fa8f9c
--- /dev/null
+++ b/reproduce_partial_forward_ref.py
@@ -0,0 +1,30 @@
+
+import inspect
+from functools import partial
+from typing import Any, Dict, Callable, ForwardRef
+from fastapi.dependencies.utils import get_typed_signature, get_typed_annotation
+
+def evaluate_forwardref(forward_ref, globalns, localns):
+    return forward_ref._evaluate(globalns, localns, set())
+
+def test_partial_forward_ref():
+    class MyModel:
+        pass
+
+    def my_dep(q: "MyModel"):
+        return q
+
+    # This should work normally
+    sig = get_typed_signature(my_dep)
+    print(f"Normal Signature: {sig}")
+
+    # This might fail with partial
+    p = partial(my_dep, q="foo")
+    try:
+        sig_p = get_typed_signature(p)
+        print(f"Partial Signature: {sig_p}")
+    except Exception as e:
+        print(f"Partial Signature failed: {e}")
+
+if __name__ == "__main__":
+    test_partial_forward_ref()

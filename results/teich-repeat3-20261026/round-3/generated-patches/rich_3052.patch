new file mode 100644
index 00000000..3a8420da
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,42 @@
+from rich.prompt import Prompt
+import pytest
+from unittest.mock import patch
+
+def test_case_sensitive_default():
+    # Case sensitive (default)
+    with patch("rich.console.Console.input", side_effect=["paul"]):
+        with pytest.raises(StopIteration): # Loop until StopIteration
+            Prompt.ask("Enter your name", choices=["Paul", "Jessica", "Duncan"])
+
+def test_case_sensitive_explicit():
+    # Case sensitive (explicit)
+    with patch("rich.console.Console.input", side_effect=["paul"]):
+        with pytest.raises(StopIteration): # Loop until StopIteration
+            Prompt.ask("Enter your name", choices=["Paul", "Jessica", "Duncan"], case_sensitive=True)
+
+def test_case_insensitive():
+    # Case insensitive
+    with patch("rich.console.Console.input", side_effect=["paul"]):
+        res = Prompt.ask("Enter your name", choices=["Paul", "Jessica", "Duncan"], case_sensitive=False)
+        assert res == "paul"
+
+def test_case_insensitive_exact():
+    # Case insensitive, exact match
+    with patch("rich.console.Console.input", side_effect=["Paul"]):
+        res = Prompt.ask("Enter your name", choices=["Paul", "Jessica", "Duncan"], case_sensitive=False)
+        assert res == "Paul"
+
+if __name__ == "__main__":
+    try:
+        test_case_sensitive_default()
+        print("test_case_sensitive_default passed")
+        test_case_sensitive_explicit()
+        print("test_case_sensitive_explicit passed")
+        test_case_insensitive()
+        print("test_case_insensitive passed")
+        test_case_insensitive_exact()
+        print("test_case_insensitive_exact passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e

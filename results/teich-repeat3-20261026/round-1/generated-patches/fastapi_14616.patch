diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..a4208b9e
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,30 @@
+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import List
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(field: Json[List[str]] = Form(...)):
+    return {"field": field}
+
+client = TestClient(app)
+
+def test_json_list_form():
+    # The JSON string for ["abc", "def"] is '["abc", "def"]'
+    # We send it as a form field.
+    response = client.post("/test", data={"field": '["abc", "def"]'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"field": ["abc", "def"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_list_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

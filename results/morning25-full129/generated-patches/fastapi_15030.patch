@@ -82,3 +82,33 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events.
+
+    This response sets the `media_type` to `text/event-stream` and the
+    `Cache-Control` header to `no-cache` and the `Connection` header to `keep-alive`.
+    """
+
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: dict | None = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ):
+        if headers is None:
+            headers = {}
+        else:
+            headers = dict(headers)
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        super().__init__(
+            content,
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type=media_type,
+        )
+

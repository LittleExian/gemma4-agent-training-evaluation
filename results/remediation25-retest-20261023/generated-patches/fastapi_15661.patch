+import argparse
+import os
+import subprocess
+import sys
+import re
+from pathlib import Path
+
+VERSION_FILE = "fastapi/__init__.py"
+RELEASE_NOTES_FILE = "docs/en/docs/release-notes.md"
+
+def update_version(new_version: str) -> None:
+    with open(VERSION_FILE, "r") as f:
+        content = f.read()
+
+    new_content = re.sub(r'(__version__\s*=\s*")[^"]+(")', rf'\g<1>{new_version}\g<2>', content)
+
+    if content == new_content:
+        print(f"Version in {VERSION_FILE} is already {new_version} or not found.")
+    else:
+        with open(VERSION_FILE, "w") as f:
+            f.write(new_content)
+        print(f"Updated {VERSION_FILE} to {new_version}")
+
+def add_release_header(new_version: str) -> None:
+    if not os.path.exists(RELEASE_NOTES_FILE):
+        print(f"Release notes file {RELEASE_NOTES_FILE} not found.")
+        return
+
+    with open(RELEASE_NOTES_FILE, "r") as f:
+        content = f.read()
+
+    header = f"## {new_version}\n"
+    if header in content:
+        print(f"Release header {new_version} already exists in {RELEASE_NOTES_FILE}.")
+    else:
+        with open(RELEASE_NOTES_FILE, "w") as f:
+            f.write(header + content)
+        print(f"Added release header {new_version} to {RELEASE_NOTES_FILE}")
+
+def run_add_date_script() -> None:
+    print("Running scripts/add_latest_release_date.py...")
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Error running scripts/add_latest_release_date.py")
+        sys.exit(result.returncode)
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Automate release preparation.")
+    parser.add_argument("version", help="The new version to release (e.g., 0.136.4)")
+    args = parser.parse_args()
+
+    update_version(args.version)
+    add_release_header(args.version)
+    run_add_date_script()
+    print("Release preparation complete!")
+
+if __name__ == "__main__":
+    main()

@@ -0,0 +1,15 @@
+from rich.console import Console, ConsoleOptions
+from rich.padding import Padding
+import io
+
+output = io.StringIO()
+console = Console(file=output)
+options = console.options.update(max_width=None)
+try:
+    # We need to call something that uses __rich_console__ with these options
+    # console.print doesn't take options.
+    # We can use console.render_lines
+    list(console.render_lines(Padding("Hello", (1, 1, 1, 1), expand=True), options))
+    print("Success")
+except Exception as e:
+    print(f"Caught exception: {e}")

@@ -0,0 +1,40 @@
+from fastapi import FastAPI, Response, StreamingResponse
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/stream")
+async def stream_data():
+    yield "hello"
+    yield " world"
+
+@app.get("/stream-explicit")
+async def stream_data_explicit():
+    yield "hello"
+    yield " world"
+
+# Wait, I need to use response_class in the decorator
+# Let's fix the app
+app = FastAPI()
+
+@app.get("/stream")
+async def stream_data():
+    yield "hello"
+    yield " world"
+
+@app.get("/stream-explicit", response_class=StreamingResponse)
+async def stream_data_explicit():
+    yield "hello"
+    yield " world"
+
+client = TestClient(app)
+
+def test_stream():
+    res1 = client.get("/stream")
+    print(f"Implicit: {repr(res1.text)}")
+    
+    res2 = client.get("/stream-explicit")
+    print(f"Explicit: {repr(res2.text)}")
+
+if __name__ == "__main__":
+    test_stream()

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..9747b202
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,32 @@
+
+import functools
+from typing import ForwardRef, Any, Dict
+from fastapi.dependencies.utils import get_typed_signature, get_typed_annotation
+from wrapper_module import wrap
+
+# Define a class to use as a forward reference
+class MyModel:
+    pass
+
+def foo(a: "MyModel"):
+    return a
+
+# Wrap foo
+wrapped_foo = wrap(foo)
+
+print(f"foo globals: {foo.__globals__ is globals()}")
+print(f"wrapped_foo globals: {wrapped_foo.__globals__ is globals()}")
+
+try:
+    sig = get_typed_signature(wrapped_foo)
+    print(f"Success! Signature: {sig}")
+    for param in sig.parameters.values():
+        print(f"Param {param.name} annotation: {param.annotation}")
+        if param.annotation is MyModel:
+            print("Annotation resolved correctly!")
+        else:
+            print("Annotation NOT resolved correctly.")
+except Exception as e:
+    print(f"Error: {e}")
+    import traceback
+    traceback.print_exc()
diff --git a/wrapper_module.py b/wrapper_module.py
new file mode 100644
index 00000000..7f29889d
--- /dev/null
+++ b/wrapper_module.py
@@ -0,0 +1,8 @@
+
+import functools
+
+def wrap(f):
+    @functools.wraps(f)
+    def wrapper(*args, **kwargs):
+        return f(*args, **kwargs)
+    return wrapper

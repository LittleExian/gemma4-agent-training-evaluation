+from __future__ import annotations
+import inspect
+from typing import List
+from fastapi.dependencies.utils import get_typed_return_annotation
+from models import MyModel
+
+def my_func() -> List[MyModel]:
+    return [MyModel()]
+
+def test_get_typed_return_annotation():
+    print(f"Function: {my_func}")
+    print(f"Return annotation: {inspect.signature(my_func).return_annotation}")
+    try:
+        annotation = get_typed_return_annotation(my_func)
+        print(f"Resolved annotation: {annotation}")
+        print("Success!")
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()
+
+if __name__ == "__main__":
+    test_get_typed_return_annotation()

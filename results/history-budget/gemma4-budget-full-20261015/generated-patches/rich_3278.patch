new file mode 100644
index 00000000..4b4d3e5b
--- /dev/null
+++ b/test_ansi.py
@@ -0,0 +1,39 @@
+import re
+
+re_ansi = re.compile(
+    r"(?:\x1b\](.*?)\x1b\\)|(?:\x1b([(@-Z\\\\-_]|\\[[0-?]*[ -/]*[@-~]))",
+    re.VERBOSE,
+)
+
+def tokenize(text):
+    position = 0
+    for match in re_ansi.finditer(text):
+        start, end = match.span(0)
+        osc, sgr = match.groups()
+        if start > position:
+            print(f"Plain: {repr(text[position:start])}")
+        if sgr:
+            if sgr == "(":
+                print(f"SGR: {repr(sgr)} (skipped)")
+            elif sgr.endswith("m"):
+                print(f"SGR: {repr(sgr)} (kept)")
+            else:
+                print(f"SGR: {repr(sgr)} (stripped)")
+        else:
+            print(f"OSC: {repr(osc)}")
+        position = end
+    if position < len(text):
+        print(f"Plain: {repr(text[position:])}")
+
+print("Testing \x1b7 (should be stripped)")
+tokenize("\x1b7hello")
+print("\nTesting \x1b8 (should be stripped)")
+tokenize("\x1b8hello")
+print("\nTesting \x1b0 (should be stripped)")
+tokenize("\x1b0hello")
+print("\nTesting \x1b? (should be stripped)")
+tokenize("\x1b?hello")
+print("\nTesting \x1b[m (should be kept)")
+tokenize("\x1b[mhello")
+print("\nTesting \x1b( (should be stripped)")
+tokenize("\x1b(hello")

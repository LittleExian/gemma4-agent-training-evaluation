@@ -0,0 +1,35 @@
+from fastapi import FastAPI, Depends, Security, SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+call_count_a = 0
+call_count_b = 0
+
+def dep_b(scopes: SecurityScopes):
+    global call_count_b
+    call_count_b += 1
+    return "b"
+
+def dep_a(b=Depends(dep_b)):
+    global call_count_a
+    call_count_a += 1
+    return b
+
+@app.get("/")
+def root(d1=Depends(dep_a), d2=Depends(dep_a)):
+    return {"d1": d1, "d2": d2}
+
+client = TestClient(app)
+
+def test_cache():
+    global call_count_a, call_count_b
+    call_count_a = 0
+    call_count_b = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    print(f"Call count A: {call_count_a}, B: {call_count_b}")
+    assert call_count_a == 1
+    assert call_count_b == 1
+
+if __name__ == "__main__":
+    test_cache()

@@ -0,0 +1,24 @@
+from rich.text import Text
+
+def test_expand_tabs_style():
+    text = Text("Hello\tWorld", style="white")
+    text.stylize("red", 0, 6) # "Hello\t" is red
+    
+    text.expand_tabs(tab_size=8)
+    
+    # "Hello" is 5 chars. Tab is at index 5.
+    # Tab expands to 8 - (5 % 8) = 3 spaces.
+    # Total length should be 5 + 3 + 5 = 13.
+    # The red style should be present from 0 to 8.
+    
+    print(f"Text: {text.plain}")
+    print(f"Spans: {text._spans}")
+    
+    # Check if the total length of red spans is 8.
+    red_len = sum(s.end - s.start for s in text._spans if s.style == "red")
+    print(f"Red length: {red_len}")
+    
+    print(f"Found expected red length: {red_len == 8}")
+
+if __name__ == "__main__":
+    test_expand_tabs_style()

+from fastapi import Depends, FastAPI, Security
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+counter = {"count": 0}
+
+def dep_a():
+    counter["count"] += 1
+    return counter["count"]
+
+def dep_b(a = Depends(dep_a)):
+    return a
+
+def dep_c(a = Depends(dep_a)):
+    return a
+
+@app.get("/")
+def root(b = Security(dep_b, scopes=["scope1"]), c = Security(dep_c, scopes=["scope2"])):
+    return {"b": b, "c": c}
+
+client = TestClient(app)
+
+def test_cache():
+    counter["count"] = 0
+    response = client.get("/")
+    print(f"Response: {response.json()}")
+    assert response.json() == {"b": 1, "c": 1}
+    assert counter["count"] == 1
+
+if __name__ == "__main__":
+    try:
+        test_cache()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")

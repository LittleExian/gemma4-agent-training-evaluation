@@ -0,0 +1,19 @@
+from rich.console import Console
+from rich.padding import Padding
+
+console = Console(width=10)
+# Padding with left=6, right=6, total=12. Console width=10.
+# expand=True
+p1 = Padding("Hello", (0, 6, 0, 6), expand=True)
+print("--- expand=True ---")
+console.print(p1)
+
+# expand=False
+p2 = Padding("Hello", (0, 6, 0, 6), expand=False)
+print("--- expand=False ---")
+console.print(p2)
+
+# Padding with left=2, right=2, total=4. Console width=10.
+p3 = Padding("Hello", (0, 2, 0, 2), expand=True)
+print("--- expand=True, small padding ---")
+console.print(p3)

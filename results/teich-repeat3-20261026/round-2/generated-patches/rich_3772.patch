@@ -0,0 +1,30 @@
+import sys
+from rich.traceback import install
+
+# Install rich traceback handler
+install()
+
+class BadException(Exception):
+    def __str__(self):
+        # This will be called when rich.traceback tries to render the error
+        raise RuntimeError("Recursion!")
+
+def fail():
+    raise BadException("Initial error")
+
+def fail_during_render():
+    import linecache
+    # Mock linecache.getlines to raise BadException during rendering
+    def bad_getlines(filename):
+        raise BadException("Error during getlines")
+    linecache.getlines = bad_getlines
+    
+    # This will raise BadException, which will be handled by sys.excepthook
+    fail()
+
+if __name__ == "__main__":
+    try:
+        fail_during_render()
+    except Exception:
+        # Trigger sys.excepthook manually for the test
+        sys.excepthook(*sys.exc_info())

@@ -0,0 +1,22 @@
+from typing import Union, Optional, List, Tuple, Set, Deque, FrozenSet, Sequence
+from typing_extensions import Annotated
+from fastapi._compat.shared import field_annotation_is_sequence, field_annotation_is_scalar_sequence, field_annotation_is_scalar
+import types
+
+def test_type(annotation, name):
+    print(f"{name}:")
+    print(f"  is_sequence: {field_annotation_is_sequence(annotation)}")
+    print(f"  is_scalar_sequence: {field_annotation_is_scalar_sequence(annotation)}")
+    print(f"  is_scalar: {field_annotation_is_scalar(annotation)}")
+
+test_type(List[int], "List[int]")
+test_type(Optional[List[int]], "Optional[List[int]]")
+test_type(List[int] | None, "List[int] | None")
+test_type(List[int] | List[str], "List[int] | List[str]")
+test_type(List[int] | str, "List[int] | str")
+test_type(List[int] | List[int], "List[int] | List[int]")
+test_type(List[int] | None | str, "List[int] | None | str")
+test_type(List[int] | List[int] | None, "List[int] | List[int] | None")
+test_type(str | None, "str | None")
+test_type(int | None, "int | None")
+test_type(List[int] | dict, "List[int] | dict")
diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..5a4f3937
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,28 @@
+from typing import Union, List, get_args, get_origin
+import types
+from fastapi._compat.shared import field_annotation_is_sequence, field_annotation_is_scalar_sequence
+
+UnionType = getattr(types, "UnionType", Union)
+
+def test():
+    # Case 1: List[int] | None -> True
+    u1 = Union[List[int], None]
+    print(f"List[int] | None: sequence={field_annotation_is_sequence(u1)}, scalar_sequence={field_annotation_is_scalar_sequence(u1)}")
+    
+    # Case 2: List[int] | str -> False
+    u2 = Union[List[int], str]
+    print(f"List[int] | str: sequence={field_annotation_is_sequence(u2)}, scalar_sequence={field_annotation_is_scalar_sequence(u2)}")
+    
+    # Case 3: List[int] | List[str] -> True
+    u3 = Union[List[int], List[str]]
+    print(f"List[int] | List[str]: sequence={field_annotation_is_sequence(u3)}, scalar_sequence={field_annotation_is_scalar_sequence(u3)}")
+    
+    # Case 4: List[int] | None | List[str] -> True
+    u4 = Union[List[int], None, List[str]]
+    print(f"List[int] | None | List[str]: sequence={field_annotation_is_sequence(u4)}, scalar_sequence={field_annotation_is_scalar_sequence(u4)}")
+
+    # Case 5: List[int] | int -> False (for sequence)
+    u5 = Union[List[int], int]
+    print(f"List[int] | int: sequence={field_annotation_is_sequence(u5)}, scalar_sequence={field_annotation_is_scalar_sequence(u5)}")
+
+test()

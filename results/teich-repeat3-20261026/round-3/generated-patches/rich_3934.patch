diff --git a/reproduce_empty_live.py b/reproduce_empty_live.py
new file mode 100644
index 00000000..da66f5b5
--- /dev/null
+++ b/reproduce_empty_live.py
@@ -0,0 +1,13 @@
+from rich.live import Live
+from rich.console import Console
+
+console = Console(record=False)
+with Live(renderable=None, console=console, transient=False) as live:
+    console.print("Before live")
+    live.update("")
+    console.print("During live")
+    live.update("Something")
+    console.print("After update")
+    live.stop()
+
+console.print("After live")

diff --git a/fastapi/dependencies/models.py b/fastapi/dependencies/models.py
index d6359c0f..0ba76ba2 100644
--- a/fastapi/dependencies/models.py
+++ b/fastapi/dependencies/models.py
@@ -43,8 +43,26 @@ class Dependant:
     path: Optional[str] = None
     scope: Union[Literal["function", "request"], None] = None
 
+    @cached_property
+    def uses_scopes(self) -> bool:
+        if self.security_scopes_param_name:
+            return True
+        for security_requirement in self.security_requirements:
+            if security_requirement.scopes:
+                return True
+        for sub_dependant in self.dependencies:
+            if sub_dependant.uses_scopes:
+                return True
+        return False
+
     @cached_property
     def cache_key(self) -> DependencyCacheKey:
+        if not self.uses_scopes:
+            return (
+                self.call,
+                (),
+                self.computed_scope or "",
+            )
         return (
             self.call,
             tuple(sorted(set(self.security_scopes or []))),
diff --git a/repro.py b/repro.py

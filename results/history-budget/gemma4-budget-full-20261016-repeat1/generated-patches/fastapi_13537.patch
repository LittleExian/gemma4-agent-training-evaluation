--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,33 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from typing import Optional
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(q: Optional[str] = Form(None)):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_empty_string_form_value():
+    # When q is sent as an empty string, it should be interpreted as None if default is None
+    response = client.post("/test", data={"q": ""})
+    assert response.status_code == 200
+    assert response.json() == {"q": None}
+
+def test_missing_form_value():
+    # When q is missing, it should be None
+    response = client.post("/test", data={})
+    assert response.status_code == 200
+    assert response.json() == {"q": None}
+
+def test_provided_form_value():
+    # When q is provided, it should be the value
+    response = client.post("/test", data={"q": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"q": "hello"}
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])

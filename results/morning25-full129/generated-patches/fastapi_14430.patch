@@ -0,0 +1,31 @@
+
+import typing
+from fastapi._compat.v2 import ModelField, serialize_sequence_value
+from pydantic import Field
+from pydantic.fields import FieldInfo
+import types
+
+# Mock ModelField
+def create_model_field(annotation):
+    field_info = FieldInfo(annotation=annotation)
+    return ModelField(field_info=field_info, name="test_field")
+
+# Test with typing.Union
+field_union = create_model_field(typing.Union[typing.List[int], None])
+try:
+    res = serialize_sequence_value(field=field_union, value=[1, 2, 3])
+    print(f"Union: {res}")
+except Exception as e:
+    print(f"Union failed: {e}")
+
+# Test with Python 3.10+ union syntax
+# We use eval to avoid syntax error on older python versions, although we are on 3.10+
+try:
+    annotation_310 = eval("list[int] | None")
+    field_310 = create_model_field(annotation_310)
+    res = serialize_sequence_value(field=field_310, value=[1, 2, 3])
+    print(f"UnionType: {res}")
+except Exception as e:
+    print(f"UnionType failed: {e}")
+    import traceback
+    traceback.print_exc()

--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,28 @@
+
+from pydantic import BaseModel
+from pydantic.fields import FieldInfo
+from fastapi._compat import v2
+from typing import List
+from fastapi.openapi.constants import REF_TEMPLATE
+
+class ModelA(BaseModel):
+    x: int
+
+class ModelB(BaseModel):
+    a: ModelA
+    b: int
+
+fields = [
+    v2.ModelField(FieldInfo(annotation=ModelB), "ModelB"),
+    v2.ModelField(FieldInfo(annotation=int), "int_field"),
+]
+
+model_name_map = {ModelB: "ModelB_New", ModelA: "ModelA_New"}
+
+try:
+    mapping, definitions = v2.get_definitions(fields=fields, model_name_map=model_name_map)
+    print("Success")
+except KeyError as e:
+    print(f"Caught expected KeyError: {e}")
+except Exception as e:
+    print(f"Caught unexpected exception: {type(e).__name__}: {e}")

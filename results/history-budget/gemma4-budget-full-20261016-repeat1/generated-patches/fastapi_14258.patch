@@ -0,0 +1,20 @@
+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_include_router_into_itself():
+    router = APIRouter()
+    with pytest.raises(FastAPIError) as excinfo:
+        router.include_router(router)
+    assert "Cannot include a router into itself" in str(excinfo.value)
+
+def test_app_include_router_into_itself():
+    app = FastAPI()
+    # app.router is the main router
+    with pytest.raises(FastAPIError) as excinfo:
+        app.router.include_router(app.router)
+    assert "Cannot include a router into itself" in str(excinfo.value)
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])

+import subprocess
+import sys
+import typer
+
+app = typer.Typer()
+
+@app.callback()
+def callback():
+    """
+    Release preparation tool.
+    """
+    pass
+
+@app.command()
+def prepare():
+    """
+    Prepare the release by adding the date to release notes, formatting, linting, and testing.
+    """
+    commands = [
+        f"{sys.executable} scripts/add_latest_release_date.py",
+        "./scripts/format.sh",
+        "./scripts/lint.sh",
+        "./scripts/test.sh",
+    ]
+
+    for cmd in commands:
+        print(f"Running: {cmd}")
+        result = subprocess.run(cmd, shell=True)
+        if result.returncode != 0:
+            print(f"Command failed: {cmd}")
+            sys.exit(result.returncode)
+
+    print("Release preparation completed successfully!")
+
+if __name__ == "__main__":
+    app()

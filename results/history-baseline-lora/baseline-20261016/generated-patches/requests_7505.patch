diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..a801ef69
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,24 @@
+
+from requests._types import is_supports_read
+
+class MockRead:
+    def read(self, length=None):
+        return b"data"
+
+class MockNoRead:
+    def other(self):
+        pass
+
+def test_is_supports_read():
+    # Test with object that has read method
+    assert is_supports_read(MockRead()) is True
+    # Test with object that does not have read method
+    assert is_supports_read(MockNoRead()) is False
+    # Test with string
+    assert is_supports_read("hello") is False
+    # Test with None
+    assert is_supports_read(None) is False
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_is_supports_read()

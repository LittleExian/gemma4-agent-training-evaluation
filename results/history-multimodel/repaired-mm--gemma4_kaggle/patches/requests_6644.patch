diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..cb695acd
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,27 @@
+from requests.models import PreparedRequest
+
+def test_excess_slashes():
+    prep = PreparedRequest()
+    prep.prepare_url("http://example.com//foo", None)
+    print(f"URL with //foo: {prep.url}")
+    assert prep.url == "http://example.com/foo"
+
+    prep.prepare_url("http://example.com///bar", None)
+    print(f"URL with ///bar: {prep.url}")
+    assert prep.url == "http://example.com/bar"
+
+    prep.prepare_url("http://example.com/baz", None)
+    print(f"URL with /baz: {prep.url}")
+    assert prep.url == "http://example.com/baz"
+
+    prep.prepare_url("http://example.com", None)
+    print(f"URL with no path: {prep.url}")
+    assert prep.url == "http://example.com/"
+
+if __name__ == "__main__":
+    try:
+        test_excess_slashes()
+        print("Tests passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e

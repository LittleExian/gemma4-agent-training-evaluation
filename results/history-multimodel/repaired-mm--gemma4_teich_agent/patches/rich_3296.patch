new file mode 100644
index 00000000..3f45c8a3
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,19 @@
+from rich.console import Console
+from rich.syntax import Syntax
+
+def test_syntax_padding_background_color():
+    console = Console(record=True)
+    
+    # Case: background_color override, padding enabled
+    syntax = Syntax("print('hello')", "python", padding=1, background_color="red")
+    console.print(syntax)
+    
+    # The first segment should be the top padding.
+    # It should have the red background.
+    first_segment = console._record_buffer[0]
+    print(f"First segment style: {first_segment.style}")
+    assert first_segment.style.bgcolor == "red"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    test_syntax_padding_background_color()

@@ -0,0 +1,41 @@
+from fastapi import FastAPI
+from fastapi.openapi.utils import get_openapi
+from pydantic import BaseModel, computed_field
+import json
+
+app = FastAPI()
+
+class Rectangle(BaseModel):
+    width: int
+    length: int
+
+    @computed_field
+    @property
+    def area(self) -> int:
+        return self.width * self.length
+
+@app.get("/")
+def read_root() -> Rectangle:
+    return Rectangle(width=3, length=4)
+
+def test_openapi():
+    openapi_schema = get_openapi(
+        title="Test",
+        version="0.1.0",
+        routes=app.routes,
+    )
+    
+    # Check if Rectangle schema has 'area'
+    rectangle_schema = openapi_schema["components"]["schemas"]["Rectangle"]
+    print(f"Rectangle properties: {list(rectangle_schema['properties'].keys())}")
+    
+    assert "area" in rectangle_schema["properties"], "Computed field 'area' missing from OpenAPI schema"
+    print("Success: Computed field 'area' is present!")
+
+if __name__ == "__main__":
+    try:
+        test_openapi()
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()

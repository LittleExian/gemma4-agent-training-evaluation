diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..51d0286e
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,38 @@
+
+from __future__ import annotations
+import inspect
+from typing import Dict, Any
+from fastapi.dependencies.utils import get_typed_annotation, get_typed_signature, get_typed_return_annotation
+
+def test_string_annotation():
+    class MyModel:
+        pass
+
+    def my_func(a: MyModel) -> MyModel:
+        return a
+
+    sig = inspect.signature(my_func)
+    annotation = sig.parameters['a'].annotation
+    print(f"Annotation type: {type(annotation)}")
+    print(f"Annotation value: {annotation}")
+
+    # Test get_typed_signature
+    typed_sig = get_typed_signature(my_func)
+    resolved_param = typed_sig.parameters['a'].annotation
+    print(f"Resolved param type: {resolved_param}")
+    assert resolved_param is MyModel
+
+    # Test get_typed_return_annotation
+    resolved_return = get_typed_return_annotation(my_func)
+    print(f"Resolved return type: {resolved_return}")
+    assert resolved_return is MyModel
+
+if __name__ == "__main__":
+    try:
+        test_string_annotation()
+        print("Success!")
+    except Exception as e:
+        print(f"Failure: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

+import sys
+from rich.traceback import install
+from unittest.mock import patch
+
+# Install rich traceback
+install()
+
+# Mock Traceback.from_exception to raise an exception
+with patch("rich.traceback.Traceback.from_exception", side_effect=RuntimeError("Rich failed!")):
+    # Trigger an exception that will be handled by sys.excepthook
+    raise ValueError("Original Error")
+
+print("Successfully handled failure in excepthook without recursion!")

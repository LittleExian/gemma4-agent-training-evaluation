+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(
+    file1: bytes = File(...),
+    form1: str = Form(...),
+    file2: bytes = File(...),
+    form2: str = Form(...),
+):
+    return {"file1": len(file1), "form1": form1, "file2": len(file2), "form2": form2}
+
+client = TestClient(app)
+
+def test_mixed_params():
+    files = {
+        "file1": ("test1.txt", b"hello", "text/plain"),
+        "file2": ("test2.txt", b"world", "text/plain"),
+    }
+    data = {
+        "form1": "value1",
+        "form2": "value2",
+    }
+    response = client.post("/test", files=files, data=data)
+    print(f"Mixed params response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"file1": 5, "form1": "value1", "file2": 5, "form2": "value2"}
+
+def test_order_variation():
+    # Try different orders of parameters in the endpoint
+    pass
+
+# We can't easily change the endpoint parameters in a running app,
+# but we can define multiple endpoints.
+
+@app.post("/test_order1")
+async def test_order1(file1: bytes = File(...), form1: str = Form(...)):
+    return {"file1": len(file1), "form1": form1}
+
+@app.post("/test_order2")
+async def test_order2(form1: str = Form(...), file1: bytes = File(...)):
+    return {"file1": len(file1), "form1": form1}
+
+def test_order1():
+    files = {"file1": ("test1.txt", b"hello", "text/plain")}
+    data = {"form1": "value1"}
+    response = client.post("/test_order1", files=files, data=data)
+    print(f"Order 1 response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"file1": 5, "form1": "value1"}
+
+def test_order2():
+    files = {"file1": ("test1.txt", b"hello", "text/plain")}
+    data = {"form1": "value1"}
+    response = client.post("/test_order2", files=files, data=data)
+    print(f"Order 2 response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"file1": 5, "form1": "value1"}
+
+if __name__ == "__main__":
+    test_mixed_params()
+    test_order1()
+    test_order2()
+    print("All tests passed!")

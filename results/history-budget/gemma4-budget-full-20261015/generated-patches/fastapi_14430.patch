@@ -0,0 +1,25 @@
+from typing import List, Union
+from fastapi._compat import v2
+from pydantic.fields import FieldInfo
+import sys
+
+def test_serialize_sequence_value_with_optional_list_py310():
+    print("Testing optional list with | syntax...")
+    try:
+        # Using Python 3.10 union syntax: list[str] | None
+        field_info = FieldInfo(annotation=list[str] | None)
+        field = v2.ModelField(name="items", field_info=field_info)
+        result = v2.serialize_sequence_value(field=field, value=["a", "b", "c"])
+        print(f"Result: {result}")
+        assert result == ["a", "b", "c"]
+        assert isinstance(result, list)
+        print("Success!")
+    except Exception as e:
+        print(f"Failed: {e}")
+        raise e
+
+if __name__ == "__main__":
+    if sys.version_info < (3, 10):
+        print("Skipping test: requires Python 3.10+")
+    else:
+        test_serialize_sequence_value_with_optional_list_py310()

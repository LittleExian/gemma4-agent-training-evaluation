+from rich.markdown import Markdown
+from rich.console import Console
+from io import StringIO
+
+def test_table_text_loss():
+    md_text = "| col1 | col2 |\n| --- | --- |\n| text1 text2 | text3 text4 |"
+    # Wait, the issue was about multiple text nodes in a cell.
+    # In markdown-it, a cell might have multiple text nodes if there are styles.
+    # For example, | **bold** and *italic* |
+    md_text = "| col1 | col2 |\n| --- | --- |\n| **bold** and *italic* | text |"
+    
+    md = Markdown(md_text)
+    console = Console(file=StringIO(), force_terminal=False, width=100)
+    console.print(md)
+    output = console.file.getvalue()
+    
+    print(f"Output: {output!r}")
+    
+    # Check if both "bold" and "italic" are present in the output
+    if "bold" in output and "italic" in output:
+        print("SUCCESS: Both bold and italic are present")
+    else:
+        print("FAILURE: Some text is missing")
+
+if __name__ == "__main__":
+    test_table_text_loss()

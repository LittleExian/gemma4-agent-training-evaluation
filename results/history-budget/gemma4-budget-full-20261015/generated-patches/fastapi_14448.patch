+def is_async_callable(func: Any) -> bool:
+    curr = func
+    while True:
+        if iscoroutinefunction(curr):
+            return True
+        if hasattr(curr, "__call__") and iscoroutinefunction(curr.__call__):
+            return True
+        if isinstance(curr, partial):
+            curr = curr.func
+            continue
+        if hasattr(curr, "__wrapped__"):
+            curr = curr.__wrapped__
+            continue
+        break
+    return False

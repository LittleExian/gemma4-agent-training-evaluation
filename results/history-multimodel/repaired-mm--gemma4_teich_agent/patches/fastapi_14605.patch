diff --git a/find_deprecation.py b/find_deprecation.py
new file mode 100644
index 00000000..6c6ec6eb
--- /dev/null
+++ b/find_deprecation.py
@@ -0,0 +1,10 @@
+import os
+
+for root, dirs, files in os.walk('fastapi'):
+    for file in files:
+        if file.endswith('.py'):
+            path = os.path.join(root, file)
+            with open(path, 'r') as f:
+                for i, line in enumerate(f):
+                    if 'DeprecationWarning' in line:
+                        print(f'{path}:{i+1}: {line.strip()}')

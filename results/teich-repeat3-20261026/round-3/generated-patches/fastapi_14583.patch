diff --git a/verify_warn_v1.py b/verify_warn_v1.py
new file mode 100644
index 00000000..ed737fb3
--- /dev/null
+++ b/verify_warn_v1.py
@@ -0,0 +1,56 @@
+import warnings
+from fastapi._compat.shared import warn_v1
+from pydantic import BaseModel as PydanticBaseModel
+from fastapi._compat.main import get_cached_model_fields
+
+def test_warn_v1_v2():
+    print("Testing warn_v1 with Pydantic v2 model...")
+    # Pydantic v2 model
+    class ModelV2(PydanticBaseModel):
+        x: int
+
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        get_cached_model_fields(ModelV2)
+        for warning in w:
+            if "Pydantic v1" in str(warning.message):
+                print(f"Unexpected warning: {warning.message}")
+                return False
+    print("No Pydantic v1 warning for Pydantic v2 model. OK.")
+    return True
+
+def test_warn_v1_v1():
+    print("Testing warn_v1 with Pydantic v1 model...")
+    # To simulate Pydantic v1 model, we need to use pydantic.v1.BaseModel if available
+    try:
+        from pydantic import v1 as pydantic_v1
+    except ImportError:
+        print("Pydantic v1 not available in this environment. Skipping test.")
+        return True
+
+    class ModelV1(pydantic_v1.BaseModel):
+        x: int
+
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        get_cached_model_fields(ModelV1)
+        found = False
+        for warning in w:
+            if "Pydantic v1" in str(warning.message):
+                print(f"Found expected warning: {warning.message}")
+                found = True
+                break
+        if not found:
+            print("Expected Pydantic v1 warning not found.")
+            return False
+    print("Pydantic v1 warning found for Pydantic v1 model. OK.")
+    return True
+
+if __name__ == "__main__":
+    v2_ok = test_warn_v1_v2()
+    v1_ok = test_warn_v1_v1()
+    if v2_ok and v1_ok:
+        print("All tests passed!")
+    else:
+        print("Some tests failed.")
+        exit(1)

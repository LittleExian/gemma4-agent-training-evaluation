@@ -0,0 +1,30 @@
+
+from requests._types import SupportsRead
+
+class FileWrapper:
+    def __init__(self, fileobj):
+        self.fileobj = fileobj
+    def __getattr__(self, name):
+        return getattr(self.fileobj, name)
+
+class MockFile:
+    def read(self, length=None):
+        return b"data"
+
+class NotAFile:
+    def __init__(self):
+        self.read = "not a function"
+
+mock_file = MockFile()
+wrapper = FileWrapper(mock_file)
+not_a_file = NotAFile()
+
+print(f"MockFile is SupportsRead: {isinstance(mock_file, SupportsRead)}")
+print(f"FileWrapper is SupportsRead: {isinstance(wrapper, SupportsRead)}")
+print(f"MockFile has read: {hasattr(mock_file, 'read')}")
+print(f"FileWrapper has read: {hasattr(wrapper, 'read')}")
+print(f"NotAFile has read: {hasattr(not_a_file, 'read')}")
+
+print(f"MockFile read is callable: {callable(getattr(mock_file, 'read', None))}")
+print(f"FileWrapper read is callable: {callable(getattr(wrapper, 'read', None))}")
+print(f"NotAFile read is callable: {callable(getattr(not_a_file, 'read', None))}")

@@ -0,0 +1,35 @@
+
+import io
+from rich.progress import Progress, _Reader
+from rich.file_proxy import FileProxy
+
+class MockFile:
+    def write(self, text):
+        pass
+    def flush(self):
+        pass
+
+def test_progress_isatty_proxy():
+    file = MockFile()
+    from rich.console import Console
+    console = Console(file=file)
+    
+    proxy = FileProxy(console, file)
+    
+    print(f"Proxy type: {type(proxy)}")
+    try:
+        print(f"Proxy isatty attribute: {getattr(proxy, 'isatty', 'Not Found')}")
+    except Exception as e:
+        print(f"Error getting isatty: {e}")
+
+    reader = _Reader(handle=proxy, progress=Progress(), task=1)
+    
+    try:
+        print(f"Reader isatty: {reader.isatty()}")
+    except AttributeError as e:
+        print(f"Caught AttributeError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == '__main__':
+    test_progress_isatty_proxy()

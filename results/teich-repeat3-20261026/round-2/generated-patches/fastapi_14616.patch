@@ -0,0 +1,41 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import Json
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(data: Json[List[str]] = Form(...)):
+    return {"data": data}
+
+@app.post("/test-list")
+async def test_list_endpoint(data: List[str] = Form(...)):
+    return {"data": data}
+
+client = TestClient(app)
+
+def test_json_list_form():
+    print("Testing Json[List[str]] Form field...")
+    response = client.post("/test", data={"data": '["a", "b"]'})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"data": ["a", "b"]}
+
+def test_list_form():
+    print("Testing List[str] Form field...")
+    response = client.post("/test-list", data={"data": ["a", "b"]})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"data": ["a", "b"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_list_form()
+        test_list_form()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

+from rich.pretty import _ipy_display_hook
+from rich.console import Console
+from rich.text import Text
+import io
+
+def test_preserve_newlines():
+    console = Console(file=io.StringIO(), force_jupyter=True)
+    # Text object with trailing newline
+    value = Text("hello\n")
+    result = _ipy_display_hook(value, console=console)
+    print(f"Result: {repr(result)}")
+    assert result == "\nhello\n"
+
+if __name__ == "__main__":
+    test_preserve_newlines()

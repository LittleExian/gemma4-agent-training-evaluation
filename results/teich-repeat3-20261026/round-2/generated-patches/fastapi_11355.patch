diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..891dd765
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,33 @@
+
+from __future__ import annotations
+from fastapi import FastAPI
+from fastapi.dependencies.utils import get_typed_return_annotation, get_typed_signature
+import inspect
+
+class MyClass:
+    pass
+
+def foo(a: MyClass) -> MyClass:
+    return a
+
+def test_return_annotation():
+    print(f"foo.__annotations__: {foo.__annotations__}")
+    print(f"Return annotation: {get_typed_return_annotation(foo)}")
+    assert get_typed_return_annotation(foo) is MyClass
+
+def test_signature():
+    sig = get_typed_signature(foo)
+    param_a = sig.parameters['a']
+    print(f"Param a annotation: {param_a.annotation}")
+    assert param_a.annotation is MyClass
+
+if __name__ == "__main__":
+    try:
+        test_return_annotation()
+        test_signature()
+        print("Success!")
+    except Exception as e:
+        print(f"Failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

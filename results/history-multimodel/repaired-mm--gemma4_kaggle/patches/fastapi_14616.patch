@@ -0,0 +1,12 @@
+from typing import List, Annotated, get_args
+from pydantic import Json
+
+def check(annotation):
+    args = get_args(annotation)
+    return any(arg is Json or isinstance(arg, Json) for arg in args[1:])
+
+t1 = Json[List[str]]
+print(f"Json[List[str]]: {check(t1)}")
+
+t2 = Annotated[List[str], Json]
+print(f"Annotated[List[str], Json]: {check(t2)}")

+from rich.live import Live
+from rich.console import Console
+
+def test_empty_live():
+    console = Console(record=False)
+    console.print("Hello")
+    with Live(renderable=None, console=console) as live:
+        pass
+    console.print("World")
+
+if __name__ == "__main__":
+    test_empty_live()

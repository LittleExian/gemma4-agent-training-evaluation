diff --git a/repro_nested.py b/repro_nested.py
new file mode 100644
index 00000000..ec399a90
--- /dev/null
+++ b/repro_nested.py
@@ -0,0 +1,61 @@
+
+from fastapi import FastAPI
+from pydantic import BaseModel
+from fastapi.openapi.utils import get_openapi
+import json
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    description: str
+
+class User(BaseModel):
+    username: str
+    item: Item
+
+@app.post("/user", response_model=User)
+async def create_user(user: User):
+    return user
+
+def test_separate_openapi_schemas_nested():
+    openapi_schema = get_openapi(
+        title="Test",
+        version="1.0.0",
+        routes=app.routes,
+        separate_input_output_schemas=True,
+    )
+    
+    # The schemas for User and Item should be separated into -Input and -Output
+    # because they are used as both input and output.
+    # User is used as input (request body) and output (response_model).
+    # Item is nested in User, so it should also be separated.
+    
+    components = openapi_schema.get("components", {}).get("schemas", {})
+    
+    # Check if User is separated
+    assert "User-Input" in components, "User-Input schema missing"
+    assert "User-Output" in components, "User-Output schema missing"
+    
+    # Check if Item is separated
+    assert "Item-Input" in components, "Item-Input schema missing"
+    assert "Item-Output" in components, "Item-Output schema missing"
+    
+    # Check if User-Input refers to Item-Input
+    user_input_properties = components["User-Input"].get("properties", {}).get("item", {})
+    assert user_input_properties.get("$ref") == "#/components/schemas/Item-Input", f"User-Input should refer to Item-Input, got {user_input_properties.get('$ref')}"
+    
+    # Check if User-Output refers to Item-Output
+    user_output_properties = components["User-Output"].get("properties", {}).get("item", {})
+    assert user_output_properties.get("$ref") == "#/components/schemas/Item-Output", f"User-Output should refer to Item-Output, got {user_output_properties.get('$ref')}"
+
+if __name__ == "__main__":
+    try:
+        test_separate_openapi_schemas_nested()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)

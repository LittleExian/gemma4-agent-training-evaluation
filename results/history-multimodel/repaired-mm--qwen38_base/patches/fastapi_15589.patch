+from typing import Optional
+
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+
+class CommonHeaders(BaseModel):
+    x_forced_header: str
+    strange_header: Optional[str] = None
+
+
+app = FastAPI()
+
+
+@app.get("/model-default")
+async def read_items(headers: CommonHeaders = Header()):
+    return headers
+
+
+@app.get("/model-no-convert")
+async def read_items2(headers: CommonHeaders = Header(convert_underscores=False)):
+    return headers
+
+
+@app.get("/single-default")
+async def read_single(strange_header: Optional[str] = Header()):
+    return {"strange_header": strange_header}
+
+
+@app.get("/single-no-convert")
+async def read_single2(strange_header: Optional[str] = Header(convert_underscores=False)):
+    return {"strange_header": strange_header}
+
+
+client = TestClient(app)
+
+print("== model, convert_underscores=True (default) ==")
+r = client.get("/model-default", headers={"x-forced-header": "x", "strange-header": "hyphen"})
+print("hyphen  :", r.status_code, r.json())
+r = client.get("/model-default", headers={"x-forced-header": "x", "strange_header": "underscore"})
+print("underscore:", r.status_code, r.json())
+
+print("== model, convert_underscores=False ==")
+r = client.get("/model-no-convert", headers={"x_forced_header": "x", "strange-header": "hyphen"})
+print("hyphen  :", r.status_code, r.json())
+r = client.get("/model-no-convert", headers={"x_forced_header": "x", "strange_header": "underscore"})
+print("underscore:", r.status_code, r.json())
+
+print("== single field, convert_underscores=True (default) ==")
+r = client.get("/single-default", headers={"strange-header": "hyphen"})
+print("hyphen  :", r.status_code, r.json())
+r = client.get("/single-default", headers={"strange_header": "underscore"})
+print("underscore:", r.status_code, r.json())
+
+print("== single field, convert_underscores=False ==")
+r = client.get("/single-no-convert", headers={"strange-header": "hyphen"})
+print("hyphen  :", r.status_code, r.json())
+r = client.get("/single-no-convert", headers={"strange_header": "underscore"})
+print("underscore:", r.status_code, r.json())

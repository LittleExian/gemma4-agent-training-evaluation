diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..8f1b3f9d
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,34 @@
+
+import sys
+import os
+sys.path.append(os.path.abspath("src"))
+
+from requests._types import is_supports_read, SupportsRead
+from typing import runtime_checkable, Protocol
+
+@runtime_checkable
+class SupportsReadProtocol(Protocol):
+    def read(self, length: int = ...): ...
+
+class Proxy:
+    def __init__(self, obj):
+        self._obj = obj
+    def __getattr__(self, name):
+        return getattr(self._obj, name)
+
+class Reader:
+    def read(self, length: int = 0):
+        return b"data"
+
+reader = Reader()
+proxy = Proxy(reader)
+
+print(f"hasattr(proxy, 'read'): {hasattr(proxy, 'read')}")
+print(f"isinstance(proxy, SupportsRead): {isinstance(proxy, SupportsRead)}")
+print(f"is_supports_read(proxy): {is_supports_read(proxy)}")
+
+# Also check for a normal reader
+print(f"is_supports_read(reader): {is_supports_read(reader)}")
+
+# Also check for something that doesn't support read
+print(f"is_supports_read(123): {is_supports_read(123)}")

+from rich.segment import Segment
+from rich.text import Text
+from rich.segment import cell_len
+
+def test_split_cells_bug():
+    text = "😀" * 100 + "a" * 100
+    cell_length = cell_len(text)
+    print(f"Text length: {len(text)}, Cell length: {cell_length}")
+    
+    cut = 201
+    segment = Segment(text, None, None)
+    s1, s2 = segment.split_cells(cut)
+    
+    print(f"Cut at {cut}: cell_len(s1) = {cell_len(s1.text)}, cell_len(s2) = {cell_len(s2.text)}")
+    assert cell_len(s1.text) == cut
+    assert cell_len(s2.text) == cell_length - cut
+
+if __name__ == "__main__":
+    test_split_cells_bug()

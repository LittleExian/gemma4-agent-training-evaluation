@@ -0,0 +1,45 @@
+from typing import Optional
+
+from fastapi import APIRouter, Depends, FastAPI, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.testclient import TestClient
+
+oauth2_scheme = OAuth2PasswordBearer(
+    tokenUrl="token", scopes={"read": "Read", "write": "Write"}
+)
+
+# Case 1: parent dependency with scopes
+app = FastAPI(dependencies=[Security(oauth2_scheme, scopes=["read"])])
+
+
+@app.get("/items")
+def read_items(token: Optional[str] = Security(oauth2_scheme, scopes=["write"])):
+    return {"token": token}
+
+
+# Case 2: sub-dependency security scheme without scopes
+def get_current_user(token: Optional[str] = Security(oauth2_scheme)):
+    return token
+
+
+@app.get("/users")
+def read_users(user: str = Depends(get_current_user)):
+    return {"user": user}
+
+
+# Case 3: same security scheme used as another sub-dependency without scopes
+# in a different path operation
+def get_current_user_scoped(token: Optional[str] = Security(oauth2_scheme, scopes=["read"])):
+    return token
+
+
+@app.get("/scoped")
+def read_scoped(user: str = Depends(get_current_user_scoped)):
+    return {"user": user}
+
+
+client = TestClient(app)
+import json
+
+schema = client.get("/openapi.json").json()
+print(json.dumps(schema["paths"], indent=2))

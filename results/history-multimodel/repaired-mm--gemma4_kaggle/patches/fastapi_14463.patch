+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+openapi_json = app.openapi()
+responses_route1 = openapi_json["paths"]["/route1"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]["anyOf"]
+print(f"Number of refs in route1: {len(responses_route1)}")
+for ref in responses_route1:
+    print(ref)
+
+# Expected: 2 refs (ModelA, ModelB)
+# Actual: 6 refs (ModelA, ModelB, ModelA, ModelB, ModelA, ModelB)

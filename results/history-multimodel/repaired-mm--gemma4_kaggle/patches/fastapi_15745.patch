+class RouterRoute(BaseRoute):
+    def __init__(
+        self,
+        router: "APIRouter",
+        prefix: str = "",
+        tags: list[str | Enum] | None = None,
+        dependencies: Sequence[params.Depends] | None = None,
+        responses: dict[int | str, dict[str, Any]] | None = None,
+        callbacks: list[BaseRoute] | None = None,
+        deprecated: bool | None = None,
+        include_in_schema: bool = True,
+    ):
+        self.router = router
+        self.prefix = prefix
+        self.tags = tags
+        self.dependencies = dependencies
+        self.responses = responses
+        self.callbacks = callbacks
+        self.deprecated = deprecated
+        self.include_in_schema = include_in_schema
+
+    def matches(self, scope: Scope) -> tuple[Match, Scope]:
+        if not scope["path"].startswith(self.prefix):
+            return Match.NONE, scope
+
+        # Strip prefix
+        new_path = scope["path"][len(self.prefix):]
+        if not new_path.startswith("/"):
+            new_path = "/" + new_path
+
+        child_scope = scope.copy()
+        child_scope["path"] = new_path
+
+        return self.router.matches(child_scope)
+
+    async def handle(self, scope: Scope, receive: Receive, send: Send) -> None:
+        # Solve dependencies applied during include_router
+        if self.dependencies:
+            astack = scope["fastapi_inner_astack"]
+            dependant = get_dependant(
+                path=self.prefix,
+                call=lambda: None,
+                scope="router_route",
+            )
+            dependant.dependencies = [
+                get_parameterless_sub_dependant(depends=d, path=self.prefix)
+                for d in self.dependencies
+            ]
+            await solve_dependencies(dependant, astack)
+
+        await self.router.handle(scope, receive, send)
+
+

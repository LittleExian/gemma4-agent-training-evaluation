@@ -0,0 +1,42 @@
+from rich.console import Console
+from rich.syntax import Syntax
+from rich.theme import Theme
+from rich.style import Style
+
+def test_syntax_padding_background():
+    # Create a theme with a specific default background
+    theme = Theme({
+        "syntax.background": Style(bgcolor="blue")
+    })
+    console = Console(theme=theme, force_terminal=True, width=40)
+
+    # Create a Syntax object with a background override and padding
+    # The padding should use the override (red), not the theme default (blue)
+    syntax = Syntax(
+        "print('hello world')",
+        "python",
+        background_color="red",
+        padding=1
+    )
+
+    # Capture the output
+    with console.capture() as capture:
+        console.print(syntax)
+    
+    output = capture.get()
+    
+    # The output should contain red background for the padding
+    # In rich, background colors are represented by ANSI escape codes
+    # Red background: \x1b[41m
+    # Blue background: \x1b[44m
+    
+    if "\x1b[41m" in output and "\x1b[44m" not in output:
+        print("SUCCESS: Padding uses the override background color (red).")
+    elif "\x1b[44m" in output:
+        print("FAILURE: Padding uses the theme default background color (blue).")
+    else:
+        print("FAILURE: Unexpected output.")
+        print(f"Output: {repr(output)}")
+
+if __name__ == "__main__":
+    test_syntax_padding_background()

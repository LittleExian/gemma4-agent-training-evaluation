+from rich.segment import Segment
+from rich.cells import cell_len
+
+def test_split_cells():
+    # A character with cell size 2
+    # Let's use an emoji.
+    text = "😀" # cell_len("😀") should be 2
+    segment = Segment(text)
+    print(f"Text: {text}, cell_length: {segment.cell_length}")
+    
+    for cut in [0, 1, 2]:
+        before, after = segment.split_cells(cut)
+        print(f"Split at {cut}: before='{before.text}', after='{after.text}'")
+        print(f"Before cell_len: {cell_len(before.text)}, After cell_len: {cell_len(after.text)}")
+
+if __name__ == "__main__":
+    test_split_cells()

+    @cached_property
+    def context(self) -> Optional[Dict[str, Any]]:
+        if self.call is None:
+            return None
+        unwrapped = _unwrapped_call(self.call)
+        try:
+            if hasattr(unwrapped, "__code__"):
+                code = unwrapped.__code__
+                filename = code.co_filename
+                lineno = code.co_firstlineno

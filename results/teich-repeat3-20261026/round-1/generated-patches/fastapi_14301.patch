diff --git a/repro_scope.py b/repro_scope.py
new file mode 100644
index 00000000..67d2a37c
--- /dev/null
+++ b/repro_scope.py
@@ -0,0 +1,45 @@
+import pytest
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+from fastapi.dependencies.utils import Dependant
+
+def test_scope_function_disables_cache():
+    app = FastAPI()
+    call_count = 0
+
+    def dependency():
+        nonlocal call_count
+        call_count += 1
+        return "value"
+
+    @app.get("/")
+    def root(dep1=Depends(dependency, scope="function"), dep2=Depends(dependency, scope="function")):
+        return {"dep1": dep1, "dep2": dep2}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert call_count == 2
+
+def test_scope_request_enables_cache():
+    app = FastAPI()
+    call_count = 0
+
+    def dependency():
+        nonlocal call_count
+        call_count += 1
+        return "value"
+
+    @app.get("/")
+    def root(dep1=Depends(dependency, scope="request"), dep2=Depends(dependency, scope="request")):
+        return {"dep1": dep1, "dep2": dep2}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert call_count == 1
+
+if __name__ == "__main__":
+    test_scope_function_disables_cache()
+    test_scope_request_enables_cache()
+    print("Tests passed!")

new file mode 100644
index 00000000..ca94e32f
--- /dev/null
+++ b/repro_style.py
@@ -0,0 +1,11 @@
+from rich.text import Text
+
+t = Text("hello", style="red")
+t.append(" world", style="blue")
+# t is "hello world" (red, blue)
+# t._spans = [Span(5, 11, "blue")]
+t.append(t)
+# t should be "hello worldhello world" (red, blue, red, blue)
+print(t)
+print(f"Length: {len(t)}")
+print(f"Spans: {t._spans}")

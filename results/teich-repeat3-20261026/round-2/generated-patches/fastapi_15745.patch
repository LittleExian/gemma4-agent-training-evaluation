+def flatten_routes(routes: Sequence[BaseRoute]) -> list[routing.APIRoute]:
+    flat_routes: list[routing.APIRoute] = []
+    for route in routes:
+        if isinstance(route, routing.APIRoute):
+            flat_routes.append(route)
+        elif isinstance(route, routing.RouterInclude):
+            flat_routes.extend(flatten_routes(route.router.routes))
+    return flat_routes
+

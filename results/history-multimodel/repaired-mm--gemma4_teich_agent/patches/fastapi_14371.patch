diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..1ae93ed6
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,45 @@
+from fastapi import FastAPI, Query
+from pydantic import AliasChoices, AliasPath
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.get("/choices")
+def read_choices(q: str = Query(..., validation_alias=AliasChoices("q1", "q2"))):
+    return {"q": q}
+
+@app.get("/path")
+def read_path(q: str = Query(..., validation_alias=AliasPath("q", "sub"))):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_choices():
+    # Test q1
+    response = client.get("/choices", params={"q1": "val1"})
+    print(f"q1: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"q": "val1"}
+    
+    # Test q2
+    response = client.get("/choices", params={"q2": "val2"})
+    print(f"q2: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"q": "val2"}
+    
+    # Test neither
+    response = client.get("/choices", params={})
+    print(f"neither: {response.status_code} {response.json()}")
+    assert response.status_code == 422
+
+def test_path():
+    # AliasPath is tricky for Query because values is a MultiDict, not a nested dict.
+    # But let's see if it handles it.
+    response = client.get("/path", params={"q": "val1"})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    test_choices()
+    test_path()
+    print("All tests passed!")

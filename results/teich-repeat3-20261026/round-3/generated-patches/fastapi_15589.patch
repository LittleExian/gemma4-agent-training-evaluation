@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Header, Depends
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class HeaderModel(BaseModel):
+    my_header: str = Header(convert_underscores=True)
+
+@app.get("/headers")
+def get_headers(headers: HeaderModel = Depends()):
+    return headers
+
+client = TestClient(app)
+
+def test_convert_underscores_true():
+    # Should accept hyphenated
+    resp = client.get("/headers", headers={"my-header": "value1"})
+    print(f"Response for my-header: {resp.status_code} {resp.json()}")
+    assert resp.status_code == 200
+    assert resp.json() == {"my_header": "value1"}
+
+    # Should reject underscore
+    resp = client.get("/headers", headers={"my_header": "value2"})
+    assert resp.status_code == 422
+
+app2 = FastAPI()
+class HeaderModelFalse(BaseModel):
+    my_header: str = Header(convert_underscores=False)
+
+@app2.get("/headers-false")
+def get_headers_false(headers: HeaderModelFalse = Depends()):
+    return headers
+
+client2 = TestClient(app2)
+
+def test_convert_underscores_false_case():
+    # Should accept underscore
+    resp = client2.get("/headers-false", headers={"my_header": "value1"})
+    assert resp.status_code == 200
+    assert resp.json() == {"my_header": "value1"}
+
+    # Should reject hyphenated
+    resp = client2.get("/headers-false", headers={"my-header": "value2"})
+    assert resp.status_code == 422
+
+if __name__ == "__main__":
+    test_convert_underscores_true()
+    print("test_convert_underscores_true passed")
+    test_convert_underscores_false_case()
+    print("test_convert_underscores_false_case passed")

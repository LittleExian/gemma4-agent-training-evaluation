@@ -0,0 +1,13 @@
+from rich.console import Console
+
+console = Console(record=True)
+
+with console.capture() as capture1:
+    console.print("A")
+    with console.capture() as capture2:
+        console.print("B")
+    console.print("C")
+
+print(f"Capture 1: {capture1.get()!r}")
+print(f"Capture 2: {capture2.get()!r}")
+print(f"Record: {console.export_text()!r}")
diff --git a/repro_nested_capture.py` b/repro_nested_capture.py`
new file mode 100644
index 00000000..eaea2c00
--- /dev/null
+++ b/repro_nested_capture.py`
@@ -0,0 +1,18 @@
+from rich.console import Console
+
+def test_nested_capture_record():
+    console = Console(record=True)
+    with console.capture() as capture1:
+        console.print("A")
+        with console.capture() as capture2:
+            console.print("B")
+        # capture2 should have "B"
+        # console.record should have "A", "B"
+    # capture1 should have "A", "B"
+    # console.record should have "A", "B"
+
+    print(f"Record: {console.export_text()}")
+    assert console.export_text() == "A\nB\n"
+
+if __name__ == "__main__":
+    test_nested_capture_record()

diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..ad793f39
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,24 @@
+from fastapi import FastAPI
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+
+async def s_shutdown():
+    print("ASYNC SHUTDOWN", flush=True)
+
+app = FastAPI(on_startup=[s_start], on_shutdown=[s_shutdown])
+
+@app.get("/health")
+async def health():
+    return {"ok": True}
+
+async def test_startup():
+    # We need to simulate the app startup
+    # In a real scenario, this is done by the ASGI server
+    # For testing, we can use the lifespan
+    async with app.lifespan_context(None, None):
+        pass
+
+if __name__ == "__main__":
+    asyncio.run(test_startup())

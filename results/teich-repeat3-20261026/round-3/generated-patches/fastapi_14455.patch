diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..19138a1f
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,44 @@
+from fastapi import FastAPI, Depends
+from fastapi.openapi.utils import get_openapi
+from fastapi.security import OAuth2PasswordBearer
+import json
+
+app = FastAPI()
+
+# Two different OAuth2PasswordBearer instances with the same scheme_name but different scopes
+oauth2_scheme1 = OAuth2PasswordBearer(
+    tokenUrl='token',
+    scopes={'scope1': 'Scope 1'},
+    scheme_name='oauth2_scheme'
+)
+oauth2_scheme2 = OAuth2PasswordBearer(
+    tokenUrl='token',
+    scopes={'scope2': 'Scope 2'},
+    scheme_name='oauth2_scheme'
+)
+
+@app.get('/test1', dependencies=[Depends(oauth2_scheme1)])
+def test1():
+    return {'msg': 'test1'}
+
+@app.get('/test2', dependencies=[Depends(oauth2_scheme2)])
+def test2():
+    return {'msg': 'test2'}
+
+openapi_schema = get_openapi(
+    title='Test',
+    version='1.0.0',
+    routes=app.routes,
+)
+
+security_schemes = openapi_schema['components']['securitySchemes']['oauth2_scheme']
+scopes = security_schemes['flows']['password']['scopes']
+
+print(json.dumps(scopes, indent=2))
+
+# Check if both scopes are present
+if 'scope1' in scopes and 'scope2' in scopes:
+    print('SUCCESS: Both scopes are present')
+else:
+    print('FAILURE: One or more scopes are missing')
+    exit(1)

+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
+        await ac.get("/")
+    
+    print(f"Dependency A executed {count_a} times")
+    if count_a == 1:
+        print("SUCCESS: Dependency A was cached")
+    else:
+        print(f"FAILURE: Dependency A was executed {count_a} times")

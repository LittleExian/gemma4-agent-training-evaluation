@@ -0,0 +1,53 @@
+from rich.cells import cell_len, set_cell_size, chop_cells, split_graphemes
+
+def test_graphemes():
+    # Family emoji: 👨‍👩‍👧‍👦
+    family = "👨‍👩‍👧‍👦"
+    print(f"Family emoji: {family}")
+    print(f"Codepoints length: {len(family)}")
+    print(f"Cell length: {cell_len(family)}")
+    
+    # Split graphemes
+    g = split_graphemes(family)
+    print(f"Split graphemes: {g}")
+    assert len(g) == 1, f"Expected 1 grapheme, got {len(g)}"
+
+    # Test set_cell_size
+    # The family emoji is usually 2 cells wide in many terminals, 
+    # but let's see what cell_len says.
+    width = cell_len(family)
+    print(f"Cell width: {width}")
+    
+    # Should not split the family emoji if we ask for its width
+    assert set_cell_size(family, width) == family
+    
+    # Should not split the family emoji if we ask for width-1 (should replace with space or crop)
+    # If width is 2, and we ask for 1, it should probably be " " or something that doesn't split the emoji.
+    res = set_cell_size(family, width - 1)
+    print(f"set_cell_size(family, {width-1}): {res}")
+    # It should NOT contain a partial family emoji.
+    # A partial family emoji would contain some of the codepoints.
+    assert family not in res # it's too long
+    # Check that it doesn't end with a ZWJ or start with one if it's a partial
+    # Actually, the simplest check is that it doesn't contain any part of the family emoji 
+    # that isn't a full grapheme.
+    
+    # Test chop_cells
+    # If width is less than family width, it should be on its own line (or chopped if width is very small)
+    # But chop_cells is used for folding.
+    chopped = chop_cells(family, width - 1)
+    print(f"chop_cells(family, {width-1}): {chopped}")
+    # It should not split the family emoji into multiple lines.
+    # If it doesn't fit, it should be on one line (even if it exceeds width) 
+    # OR it should be handled as a single unit.
+    # Looking at chop_cells implementation:
+    # if char_doesnt_fit:
+    #     append_new_line([grapheme])
+    #     total_width = cell_width
+    # So it will put the whole grapheme on a new line.
+    assert len(chopped) == 1
+    assert chopped[0] == family
+
+if __name__ == "__main__":
+    test_graphemes()
+    print("All tests passed!")

new file mode 100644
index 00000000..520a1ad7
--- /dev/null
+++ b/repro_fix.py
@@ -0,0 +1,10 @@
+from rich.console import Console
+from rich.padding import Padding
+
+console = Console(width=10)
+# Padding: left=6, right=6. Total padding = 12. Console width = 10.
+# expand=True means width = 10.
+# left + right = 12 > 10.
+padding = Padding("H", (0, 6, 0, 6), expand=True)
+
+console.print(padding)

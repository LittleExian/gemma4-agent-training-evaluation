diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..10f80978
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,61 @@
+
+from fastapi import FastAPI, Body, Request
+from fastapi.testclient import TestClient
+from fastapi.exceptions import RequestValidationError
+import pytest
+
+app = FastAPI()
+
+@app.post("/strict")
+async def strict_endpoint(data: dict = Body(..., strict_content_type=True)):
+    return data
+
+@app.post("/non-strict")
+async def non_strict_endpoint(data: dict = Body(..., strict_content_type=False)):
+    return data
+
+client = TestClient(app)
+
+def test_strict_content_type():
+    # Valid JSON and content-type
+    response = client.post("/strict", json={"foo": "bar"})
+    print(f"Test 1: status={response.status_code}, body={response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+    # Valid JSON but wrong content-type
+    response = client.post("/strict", content='{"foo": "bar"}', headers={"Content-Type": "text/plain"})
+    print(f"Test 2: status={response.status_code}, body={response.json()}")
+    assert response.status_code == 422
+    assert response.json()["detail"][0]["type"] == "content_type_invalid"
+
+    # Valid JSON but missing content-type
+    response = client.post("/strict", content='{"foo": "bar"}', headers={})
+    print(f"Test 3: status={response.status_code}, body={response.json()}")
+    assert response.status_code == 422
+    assert response.json()["detail"][0]["type"] == "content_type_missing"
+
+def test_non_strict_content_type():
+    # Valid JSON and content-type
+    response = client.post("/non-strict", json={"foo": "bar"})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+    # Valid JSON but wrong content-type
+    response = client.post("/non-strict", content='{"foo": "bar"}', headers={"Content-Type": "text/plain"})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+    # Valid JSON but missing content-type
+    response = client.post("/non-strict", content='{"foo": "bar"}', headers={})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+if __name__ == "__main__":
+    try:
+        test_strict_content_type()
+        test_non_strict_content_type()
+        print("All tests passed!")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()

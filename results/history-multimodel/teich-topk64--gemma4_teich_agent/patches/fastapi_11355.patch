--- /dev/null
+++ b/repro.py
@@ -0,0 +1,28 @@
+from __future__ import annotations
+from fastapi import FastAPI, Depends
+from typing import Annotated
+import inspect
+from fastapi.dependencies.utils import get_typed_signature
+from pydantic import BaseModel
+
+app = FastAPI()
+
+def get_my_model(value: str) -> MyModel:
+    return MyModel(value=value)
+
+class MyModel(BaseModel):
+    value: str
+
+@app.get("/")
+def read_root(model: Annotated[MyModel, Depends(get_my_model)]):
+    return {"value": model.value}
+
+if __name__ == "__main__":
+    sig = get_typed_signature(get_my_model)
+    print(f"Signature: {sig}")
+    for param in sig.parameters.values():
+        print(f"Param {param.name}: {param.annotation}")
+    
+    from fastapi.dependencies.utils import get_typed_return_annotation
+    ret_ann = get_typed_return_annotation(get_my_model)
+    print(f"Return annotation: {ret_ann}")

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..f5a01b5b
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,16 @@
+from rich.console import Console
+from rich.markdown import Markdown
+
+markdown_text = "```\nhello\n\n\n```"
+markdown = Markdown(markdown_text)
+console = Console(record=True, width=20)
+console.print(markdown)
+captured = console.export_text()
+print(f"Captured: {repr(captured)}")
+# The expected output should have more newlines if they are preserved.
+# "hello\n\n\n" should result in at least 3 newlines for the content itself,
+# plus potentially others for the Syntax padding.
+if captured.count('\n') < 4:
+    print("FAILED: Newlines were stripped")
+else:
+    print("PASSED: Newlines were preserved")
diff --git a/repro_inline.py b/repro_inline.py

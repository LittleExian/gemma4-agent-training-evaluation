diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..0a5b0be3
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,32 @@
+
+from fastapi import FastAPI
+import asyncio
+
+startup_called = False
+shutdown_called = False
+
+def startup_handler():
+    global startup_called
+    startup_called = True
+
+def shutdown_handler():
+    global shutdown_called
+    shutdown_called = True
+
+app = FastAPI(on_startup=[startup_handler], on_shutdown=[shutdown_handler])
+
+async def main():
+    # Simulate the app startup and shutdown
+    # In a real scenario, this would be handled by the ASGI server (e.g. uvicorn)
+    # We can manually trigger the lifespan context
+    async with app.router.lifespan_context(app):
+        pass
+
+    print(f"Startup called: {startup_called}")
+    print(f"Shutdown called: {shutdown_called}")
+
+    assert startup_called, "Startup handler was not called"
+    assert shutdown_called, "Shutdown handler was not called"
+
+if __name__ == "__main__":
+    asyncio.run(main())
diff --git a/repro_lifespan.py b/repro_lifespan.py
new file mode 100644
index 00000000..80413578
--- /dev/null
+++ b/repro_lifespan.py
@@ -0,0 +1,34 @@
+
+from fastapi import APIRouter, FastAPI
+import asyncio
+
+startup_called = False
+shutdown_called = False
+
+def startup_handler():
+    global startup_called
+    startup_called = True
+
+def shutdown_handler():
+    global shutdown_called
+    shutdown_called = True
+
+async def lifespan(app):
+    yield
+
+router = APIRouter(on_startup=[startup_handler], on_shutdown=[shutdown_handler], lifespan=lifespan)
+app = FastAPI()
+app.include_router(router)
+
+async def main():
+    async with app.router.lifespan_context(app):
+        pass
+
+    print(f"Startup called: {startup_called}")
+    print(f"Shutdown called: {shutdown_called}")
+
+    assert startup_called, "Startup handler was not called"
+    assert shutdown_called, "Shutdown handler was not called"
+
+if __name__ == "__main__":
+    asyncio.run(main())

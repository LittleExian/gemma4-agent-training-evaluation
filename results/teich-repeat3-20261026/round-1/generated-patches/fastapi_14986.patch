diff --git a/verify_escaping.py b/verify_escaping.py
new file mode 100644
index 00000000..1f6cfcfc
--- /dev/null
+++ b/verify_escaping.py
@@ -0,0 +1,59 @@
+from fastapi.openapi.docs import get_swagger_ui_html, get_redoc_html
+
+def test_swagger_ui_escaping():
+    payload = "'; alert('XSS'); //"
+    html_payload = "<script>alert('XSS')</script>"
+    
+    response = get_swagger_ui_html(
+        openapi_url=payload,
+        title=html_payload,
+        swagger_js_url=html_payload,
+        swagger_css_url=html_payload,
+        swagger_favicon_url=html_payload,
+        oauth2_redirect_url=payload
+    )
+    
+    content = response.body.decode()
+    
+    # Check JS escaping for openapi_url
+    # json.dumps(payload) -> '"\'; alert(\'XSS\'); //"'
+    # The output should be url: "'; alert('XSS'); //",
+    # Wait, json.dumps will include quotes.
+    # In the code: url: {json.dumps(openapi_url)},
+    # So it should be url: "'; alert('XSS'); //",
+    
+    assert payload not in content, "openapi_url not escaped in JS"
+    assert f'"{payload}"' in content, "openapi_url not correctly json.dumps'd"
+    
+    # Check HTML escaping for title, etc.
+    assert html_payload not in content, "HTML payload not escaped"
+    assert "&lt;script&gt;alert('XSS')&lt;/script&gt;" in content, "HTML payload not correctly escaped"
+    
+    # Check oauth2_redirect_url
+    # window.location.origin + {json.dumps(oauth2_redirect_url)},
+    assert f'"{payload}"' in content, "oauth2_redirect_url not correctly json.dumps'd"
+
+def test_redoc_escaping():
+    html_payload = "<script>alert('XSS')</script>"
+    
+    response = get_redoc_html(
+        openapi_url=html_payload,
+        title=html_payload,
+        redoc_js_url=html_payload,
+        redoc_favicon_url=html_payload
+    )
+    
+    content = response.body.decode()
+    
+    assert html_payload not in content, "HTML payload not escaped in ReDoc"
+    assert "&lt;script&gt;alert('XSS')&lt;/script&gt;" in content, "HTML payload not correctly escaped in ReDoc"
+
+if __name__ == "__main__":
+    try:
+        test_swagger_ui_escaping()
+        print("Swagger UI escaping test passed")
+        test_redoc_escaping()
+        print("ReDoc escaping test passed")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

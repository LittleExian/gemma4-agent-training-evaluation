diff --git a/reproduce_issue_3.py b/reproduce_issue_3.py
new file mode 100644
index 00000000..4fc3b08f
--- /dev/null
+++ b/reproduce_issue_3.py
@@ -0,0 +1,10 @@
+from rich.console import Console
+from rich.live import Live
+
+console = Console()
+print(f"is_terminal: {console.is_terminal}")
+print("Before live")
+live = Live("Hello", console=console, transient=False)
+live.start()
+live.stop()
+print("After live")

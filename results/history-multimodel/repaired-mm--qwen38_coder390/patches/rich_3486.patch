+def _get_line_no(frame_summary: Any) -> int:
+    """Get the line number of the last executed instruction.
+
+    Uses PEP 657 (Python 3.11+) for fine-grained error locations when
+    available, falling back to ``f_lineno`` otherwise.
+
+    Args:
+        frame_summary (Any): The frame summary.
+
+    Returns:
+        int: The line number of the last executed instruction.
+    """
+    try:
+        lasti = frame_summary.f_lasti
+    except AttributeError:
+        return frame_summary.f_lineno
+    code = frame_summary.f_code
+    try:
+        positions = code.co_positions()
+    except AttributeError:
+        return frame_summary.f_lineno
+    for position in positions:
+        if position.is_position_unknown:
+            continue
+        if position.offset <= lasti < position.end_offset:
+            return position.lineno
+    return frame_summary.f_lineno
+

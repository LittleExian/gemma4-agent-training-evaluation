@@ -0,0 +1,28 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer, APIKeyHeader
+import json
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+apikey_scheme = APIKeyHeader(name="X-API-Key")
+
+def dep2(token: str = Security(apikey_scheme)):
+    return token
+
+def dep1(d2 = Depends(dep2), token: str = Security(oauth2_scheme, scopes=["read"])):
+    return token
+
+def route_a(d1 = Depends(dep1), d2 = Depends(dep2)):
+    return "a"
+
+def route_b(d2 = Depends(dep2)):
+    return "b"
+
+# Route B first, then Route A
+app.add_api_route("/b", route_b)
+app.add_api_route("/a", route_a)
+
+openapi_schema = app.openapi()
+
+# Let's just print the security requirements for /a.
+print(json.dumps(openapi_schema["paths"]["/a"]["get"]["security"], indent=2))

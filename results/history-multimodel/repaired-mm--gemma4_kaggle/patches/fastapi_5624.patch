@@ -0,0 +1,49 @@
+import asyncio
+from fastapi import FastAPI, Depends, Security
+from fastapi.security.oauth2 import SecurityScopes
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+async def get_scopes(scopes: SecurityScopes):
+    return scopes.scopes
+
+async def dep1(scopes: SecurityScopes):
+    return scopes.scopes
+
+async def dep2(scopes: SecurityScopes):
+    return scopes.scopes
+
+async def dep_shared(scopes: SecurityScopes):
+    return scopes.scopes
+
+@app.get("/")
+async def root(
+    s1 = Security(dep1, scopes=["scope1"]),
+    s2 = Security(dep2, scopes=["scope2"]),
+    shared = Security(dep_shared),
+):
+    return {"s1": s1, "s2": s2, "shared": shared}
+
+client = TestClient(app)
+
+def test_scopes():
+    response = client.get("/")
+    assert response.status_code == 200
+    data = response.json()
+    print(f"Data: {data}")
+    # dep1 should see scope1
+    # dep2 should see scope2
+    # dep_shared should see both scope1 and scope2
+    assert set(data["s1"]) == {"scope1"}
+    assert set(data["s2"]) == {"scope2"}
+    assert set(data["shared"]) == {"scope1", "scope2"}
+
+if __name__ == "__main__":
+    try:
+        test_scopes()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

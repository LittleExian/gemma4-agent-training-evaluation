@@ -0,0 +1,43 @@
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+import json
+
+class Cat(BaseModel):
+    type: Literal["cat"]
+    meows: bool
+
+class Dog(BaseModel):
+    type: Literal["dog"]
+    barks: bool
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Pet, Body()]):
+    return pet
+
+def test_openapi():
+    schema = app.openapi()
+    # Check if the schema for /pet post request has the discriminator
+    # The schema for the request body should be a oneOf with a discriminator
+    paths = schema["paths"]["/pet"]["post"]
+    request_body = paths["requestBody"]["content"]["application/json"]["schema"]
+    
+    # In OpenAPI 3.0.x, discriminator is part of the schema
+    assert "discriminator" in request_body, f"Discriminator missing from schema: {json.dumps(request_body, indent=2)}"
+    assert request_body["discriminator"]["propertyName"] == "type"
+    print("OpenAPI schema test passed")
+
+if __name__ == "__main__":
+    try:
+        test_openapi()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

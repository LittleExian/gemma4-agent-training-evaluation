diff --git a/reproduce_circular.py b/reproduce_circular.py
new file mode 100644
index 00000000..813d8d53
--- /dev/null
+++ b/reproduce_circular.py
@@ -0,0 +1,24 @@
+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_circular_router_inclusion():
+    router_a = APIRouter()
+    router_b = APIRouter()
+    
+    router_a.include_router(router_b)
+    try:
+        router_b.include_router(router_a)
+    except FastAPIError as e:
+        print(f"Caught expected error: {e}")
+        return
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+        exit(1)
+    
+    print("Circular reference not caught!")
+    exit(1)
+
+if __name__ == "__main__":
+    test_circular_router_inclusion()
+    print("Test passed!")

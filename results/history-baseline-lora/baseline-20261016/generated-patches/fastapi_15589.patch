@@ -0,0 +1,30 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_header(my_header: str = Header(..., convert_underscores=False)):
+    return {"my_header": my_header}
+
+client = TestClient(app)
+
+def test_underscore_header_disabled():
+    # convert_underscores=False
+    # Should accept 'my_header'
+    response = client.get("/", headers={"my_header": "value1"})
+    print(f"Response with my_header: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["my_header"] == "value1"
+
+    # Should NOT accept 'my-header'
+    response = client.get("/", headers={"my-header": "value2"})
+    print(f"Response with my-header: {response.status_code} {response.json()}")
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header_disabled()
+        print("test_underscore_header_disabled passed")
+    except Exception as e:
+        print(f"test_underscore_header_disabled failed: {e}")

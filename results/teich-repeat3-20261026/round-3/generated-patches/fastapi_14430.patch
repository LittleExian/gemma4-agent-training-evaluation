+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from typing import Union
+
+app = FastAPI()
+
+@app.get("/optional_seq")
+def optional_seq(q: list[str] | None = Query(None)):
+    return {"q": q}
+
+@app.get("/mixed_union")
+def mixed_union(q: list[str] | int = Query(None)):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_optional_seq():
+    print("Testing optional_seq (list[str] | None):")
+    print(f"q=a&q=b: {client.get('/optional_seq?q=a&q=b').json()}")
+    print(f"q=a: {client.get('/optional_seq?q=a').json()}")
+    print(f"q=None: {client.get('/optional_seq').json()}")
+
+def test_mixed_union():
+    print("\nTesting mixed_union (list[str] | int):")
+    print(f"q=1: {client.get('/mixed_union?q=1').json()}")
+    print(f"q=a&q=b: {client.get('/mixed_union?q=a&q=b').json()}")
+
+if __name__ == "__main__":
+    test_optional_seq()
+    test_mixed_union()

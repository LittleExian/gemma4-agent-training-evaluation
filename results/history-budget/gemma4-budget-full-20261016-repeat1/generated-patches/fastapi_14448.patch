+def unwrap_callable_chain(func: Any) -> Any:
+    while True:
+        if hasattr(func, "__wrapped__"):
+            func = func.__wrapped__
+        elif isinstance(func, functools.partial):
+            func = func.func
+        else:
+            break
+    return func
+
+
+def is_async_callable_chain(func: Any) -> bool:
+    unwrapped = unwrap_callable_chain(func)
+    if inspect.iscoroutinefunction(unwrapped) or inspect.isasyncgenfunction(unwrapped):
+        return True
+    if hasattr(unwrapped, "__call__") and (
+        inspect.iscoroutinefunction(unwrapped.__call__) or inspect.isasyncgenfunction(unwrapped.__call__)
+    ):
+        return True
+    return False
+

@@ -0,0 +1,75 @@
+import asyncio
+import inspect
+from functools import wraps, partial
+from fastapi.dependencies.models import Dependant
+
+async def async_func():
+    return 1
+
+def sync_func():
+    return 1
+
+def async_wrapper(f):
+    @wraps(f)
+    async def wrapper(*args, **kwargs):
+        return await f(*args, **kwargs)
+    return wrapper
+
+def sync_wrapper(f):
+    @wraps(f)
+    def wrapper(*args, **kwargs):
+        return f(*args, **kwargs)
+    return wrapper
+
+def test_is_coroutine_callable():
+    # 1. Async function
+    dep = Dependant(call=async_func)
+    assert dep.is_coroutine_callable is True, "Async function should be coroutine callable"
+
+    # 2. Sync function
+    dep = Dependant(call=sync_func)
+    assert dep.is_coroutine_callable is False, "Sync function should not be coroutine callable"
+
+    # 3. Wrapped async function (sync wrapper)
+    dep = Dependant(call=sync_wrapper(async_func))
+    assert dep.is_coroutine_callable is True, "Wrapped async function should be coroutine callable"
+
+    # 4. Wrapped sync function (async wrapper)
+    dep = Dependant(call=async_wrapper(sync_func))
+    assert dep.is_coroutine_callable is True, "Async wrapper of sync function should be coroutine callable"
+
+    # 5. Partial of async function
+    dep = Dependant(call=partial(async_func))
+    assert dep.is_coroutine_callable is True, "Partial of async function should be coroutine callable"
+
+    # 6. Partial of wrapped async function
+    dep = Dependant(call=partial(sync_wrapper(async_func)))
+    assert dep.is_coroutine_callable is True, "Partial of wrapped async function should be coroutine callable"
+
+    # 7. Wrapped partial of async function
+    dep = Dependant(call=sync_wrapper(partial(async_func)))
+    assert dep.is_coroutine_callable is True, "Wrapped partial of async function should be coroutine callable"
+
+    # 8. Partial of async wrapper of sync function
+    dep = Dependant(call=partial(async_wrapper(sync_func)))
+    assert dep.is_coroutine_callable is True, "Partial of async wrapper of sync function should be coroutine callable"
+
+    # 9. Callable instance with async __call__
+    class AsyncCallable:
+        async def __call__(self):
+            return 1
+    dep = Dependant(call=AsyncCallable())
+    assert dep.is_coroutine_callable is True, "Callable instance with async __call__ should be coroutine callable"
+
+    # 10. Wrapped callable instance with async __call__
+    dep = Dependant(call=sync_wrapper(AsyncCallable()))
+    assert dep.is_coroutine_callable is True, "Wrapped callable instance with async __call__ should be coroutine callable"
+
+    # 11. Partial of callable instance with async __call__
+    dep = Dependant(call=partial(AsyncCallable()))
+    assert dep.is_coroutine_callable is True, "Partial of callable instance with async __call__ should be coroutine callable"
+
+    print("All is_coroutine_callable tests passed!")
+
+if __name__ == "__main__":
+    test_is_coroutine_callable()

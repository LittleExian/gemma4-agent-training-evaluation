diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..7daef1ec
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,16 @@
+from rich.markup import _parse
+
+def test_parse(markup):
+    print(f"Markup: {repr(markup)}")
+    for item in _parse(markup):
+        print(item)
+    print("-" * 20)
+
+test_parse("Hello")
+test_parse("Hello \\")
+test_parse("Hello \\\\")
+test_parse("Hello \\[")
+test_parse("Hello \\\\[")
+test_parse("Hello \\\\[")
+test_parse("Hello \\\\[tag]")
+test_parse("Hello \\\\[tag")
diff --git a/repro_escape.py b/repro_escape.py
new file mode 100644
index 00000000..e7663031
--- /dev/null
+++ b/repro_escape.py
@@ -0,0 +1,13 @@
+from rich.markup import escape, _parse
+
+def test_escape(markup):
+    escaped = escape(markup)
+    print(f"Original: {repr(markup)}")
+    print(f"Escaped:  {repr(escaped)}")
+    print(f"Parsed:   {list(_parse(escaped))}")
+    print("-" * 20)
+
+test_escape("Hello")
+test_escape("Hello [tag]")
+test_escape("Hello \\")
+test_escape("Hello \\\\")
diff --git a/repro_trailing.py b/repro_trailing.py
new file mode 100644
index 00000000..9a706cd3
--- /dev/null
+++ b/repro_trailing.py
@@ -0,0 +1,15 @@
+from rich.markup import escape, _parse
+
+def test_trailing_backslash():
+    markup = "Hello \\"
+    escaped = escape(markup)
+    print(f"Escaped: {repr(escaped)}")
+    
+    # Now append a tag
+    combined = escaped + "[tag]"
+    print(f"Combined: {repr(combined)}")
+    
+    parsed = list(_parse(combined))
+    print(f"Parsed: {parsed}")
+
+test_trailing_backslash()

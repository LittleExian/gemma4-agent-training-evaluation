+from fastapi import FastAPI, Query, Header
+from pydantic import BaseModel, Field
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    q_param: str = Field(..., alias="q-param")
+
+@app.get("/query")
+async def root_query(query: QueryModel = Query()):
+    return {"query": query}
+
+class HeaderModel(BaseModel):
+    h_param: str = Field(..., alias="h-param")
+
+@app.get("/header")
+async def root_header(header: HeaderModel = Header()):
+    return {"header": header}
+
+client = TestClient(app)
+
+def test_query_model_alias():
+    # Test 1: Value extracted by alias, should work
+    response = client.get("/query?q-param=hello")
+    print(f"Query response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"query": {"q_param": "hello"}}
+
+
+def test_query_model_alias_extra():
+    # Test 2: Value passed by name, should be a validation error
+    # and the name should be treated as an extra parameter if it's not the alias.
+    response = client.get("/query?q_param=hello")
+    assert response.status_code == 422
+    detail = response.json()["detail"]
+    # Should have a missing field error for 'q-param'
+    assert any(err["loc"] == ["query", "q-param"] for err in detail)
+    # The 'q_param' should be in the input of the error if it's an extra parameter
+    # But wait, FastAPI's default error response doesn't always show 'input' in the way I expect.
+    # Let's see what it actually returns.
+    print(f"Error detail: {detail}")
+
+def test_header_model_alias():
+    # Test 1: Value extracted by alias, should work
+    response = client.get("/header", headers={"h-param": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"header": {"h_param": "hello"}}
+
+def test_header_model_alias_extra():
+    # Test 2: Value passed by name, should be a validation error
+    response = client.get("/header", headers={"h_param": "hello"})
+    assert response.status_code == 422
+    detail = response.json()["detail"]
+    assert any(err["loc"] == ["header", "h-param"] for err in detail)
+    print(f"Error detail: {detail}")
+
+if __name__ == "__main__":
+    try:
+        test_query_model_alias()
+        print("test_query_model_alias passed")
+        test_query_model_alias_extra()
+        print("test_query_model_alias_extra passed")
+        test_header_model_alias()
+        print("test_header_model_alias passed")
+        test_header_model_alias_extra()
+        print("test_header_model_alias_extra passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e

@@ -0,0 +1,57 @@
+"""Automate release preparation."""
+
+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+
+def bump_version(current_version: str, bump_type: str) -> str:
+    major, minor, patch = map(int, current_version.split("."))
+    if bump_type == "major":
+        major += 1
+        minor = 0
+        patch = 0
+    elif bump_type == "minor":
+        minor += 1
+        patch = 0
+    elif bump_type == "patch":
+        patch += 1
+    else:
+        raise ValueError(f"Invalid bump type: {bump_type}")
+    return f"{major}.{minor}.{patch}"
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("bump_type", choices=["major", "minor", "patch"], help="Type of version bump")
+    parser.add_argument("--version", help="Explicitly set the new version")
+    args = parser.parse_args()
+
+    with open(VERSION_FILE) as f:
+        content = f.read()
+
+    match = re.search(r"__version__ = \"([^\"]+)\"", content)
+    if not match:
+        print("Could not find __version__ in fastapi/__init__.py")
+        sys.exit(1)
+
+    current_version = match.group(1)
+    if args.version:
+        new_version = args.version
+    else:
+        new_version = bump_version(current_version, args.bump_type)
+
+    print(f"Bumping version: {current_version} -> {new_version}")
+    new_content = content.replace(f"__version__ = \"{current_version}\"", f"__version__ = \"{new_version}\"")
+    with open(VERSION_FILE, "w") as f:
+        f.write(new_content)
+
+    print("Updating release notes date...")
+    subprocess.run(["python3", "scripts/add_latest_release_date.py"], check=True)
+
+    print(f"Release preparation complete. New version: {new_version}")
+
+if __name__ == "__main__":
+    main()

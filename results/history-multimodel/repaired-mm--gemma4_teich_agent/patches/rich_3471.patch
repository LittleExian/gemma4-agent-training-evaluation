+from rich.text import Text
+
+def tokens_gen():
+    yield "hello", None
+    raise RuntimeError("Oops!")
+    yield "world", None
+
+t = Text()
+try:
+    t.append_tokens(tokens_gen())
+except RuntimeError:
+    pass
+
+print(f"Text: {t.plain}")
+print(f"Length: {len(t)}")
+print(f"Actual length: {len(t.plain)}")

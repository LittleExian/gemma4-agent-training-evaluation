--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,26 @@
+from fastapi import FastAPI, Form
+from typing import Optional
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(q: Optional[str] = Form(None)):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_empty_form_value():
+    # When q is missing, it should be None
+    response = client.post("/test", data={})
+    assert response.json() == {"q": None}
+
+    # When q is "", it should also be None because of _get_multidict_value's logic for Form
+    response = client.post("/test", data={"q": ""})
+    print(f"Response for q='': {response.json()}")
+    assert response.json() == {"q": None}
+
+if __name__ == "__main__":
+    test_empty_form_value()
+    print("Test passed!")

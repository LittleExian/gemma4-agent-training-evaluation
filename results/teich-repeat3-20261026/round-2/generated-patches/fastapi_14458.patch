@@ -0,0 +1,31 @@
+import asyncio
+import inspect
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+from fastapi.dependencies.models import Dependant, _impartial, _unwrapped_call
+
+class MyCallable:
+    async def __call__(self):
+        return "hello"
+
+app = FastAPI()
+
+@app.get("/")
+async def root(dep = Depends(MyCallable)):
+    return {"dep": dep}
+
+client = TestClient(app)
+
+def test_repro():
+    # Use the actual Dependant class
+    dep = Dependant(call=MyCallable)
+    print(f"is_coroutine_callable: {dep.is_coroutine_callable}")
+    print(f"is_async_gen_callable: {dep.is_async_gen_callable}")
+    print(f"is_gen_callable: {dep.is_gen_callable}")
+
+    assert dep.is_coroutine_callable is False, "MyCallable (class) should not be treated as coroutine callable"
+    assert dep.is_async_gen_callable is False, "MyCallable (class) should not be treated as async gen callable"
+    assert dep.is_gen_callable is False, "MyCallable (class) should not be treated as gen callable"
+
+if __name__ == "__main__":
+    test_repro()

--- /dev/null
+++ b/repro.py
@@ -0,0 +1,31 @@
+
+from fastapi import FastAPI
+from typing import TYPE_CHECKING, ForwardRef
+from pydantic import BaseModel
+import inspect
+
+if TYPE_CHECKING:
+    class MyModel(BaseModel):
+        name: str
+
+app = FastAPI()
+
+@app.get("/")
+def read_root(item: "MyModel"):
+    return {"hello": "world"}
+
+def test_annotation():
+    from fastapi.dependencies.utils import get_typed_signature
+    
+    sig = get_typed_signature(read_root)
+    param = sig.parameters["item"]
+    print(f"Annotation: {param.annotation}")
+    print(f"Type: {type(param.annotation)}")
+    
+    if isinstance(param.annotation, (str, ForwardRef)):
+        print("FAILED: Annotation not evaluated")
+    else:
+        print("SUCCESS: Annotation evaluated")
+
+if __name__ == "__main__":
+    test_annotation()

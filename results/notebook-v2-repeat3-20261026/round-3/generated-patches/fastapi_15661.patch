+++ b/scripts/release.py
@@ -0,0 +1,31 @@
+import sys
+import re
+from pathlib import Path
+from scripts.add_latest_release_date import add_latest_release_date
+
+def main():
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+    
+    new_version = sys.argv[1]
+    init_file = Path("fastapi/__init__.py")
+    
+    content = init_file.read_text()
+    # Use a regex that matches the version assignment
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    
+    if content == new_content:
+        print(f"Version is already {new_version} or __version__ not found in {init_file}")
+    else:
+        init_file.write_text(new_content)
+        print(f"Updated version to {new_version} in {init_file}")
+    
+    if add_latest_release_date():
+        print("Updated release date in release-notes.md")
+    else:
+        print("Failed to update release date in release-notes.md")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()

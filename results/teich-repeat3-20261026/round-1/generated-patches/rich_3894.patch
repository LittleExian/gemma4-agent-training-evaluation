diff --git a/reproduce_bug.py b/reproduce_bug.py
new file mode 100644
index 00000000..fc7104c2
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,45 @@
+
+from rich import inspect
+from rich.console import Console
+from unittest.mock import MagicMock
+
+def test_inspect_class():
+    print("Testing inspect class with non-string __qualname__ and __name__")
+    console = Console(force_terminal=False)
+    
+    # Create a mock that looks like a class
+    MockClass = MagicMock()
+    MockClass.__qualname__ = 123
+    MockClass.__name__ = 456
+    
+    inspect(MockClass, console=console)
+    print("Success!")
+
+class MockObj:
+    pass
+
+def test_inspect_obj():
+    print("Testing inspect object with non-string __qualname__ and __name__")
+    console = Console(force_terminal=False)
+    
+    obj = MockObj()
+    obj.__qualname__ = 123
+    obj.__name__ = 456
+    
+    inspect(obj, console=console)
+    print("Success!")
+
+if __name__ == "__main__":
+    try:
+        test_inspect_class()
+    except Exception as e:
+        print(f"Error in test_inspect_class: {e}")
+        import traceback
+        traceback.print_exc()
+
+    try:
+        test_inspect_obj()
+    except Exception as e:
+        print(f"Error in test_inspect_obj: {e}")
+        import traceback
+        traceback.print_exc()

+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    q_alias: str = Field(..., alias="q")
+
+@app.get("/")
+async def root(q_model: QueryModel = Query(...)):
+    return q_model
+
+client = TestClient(app)
+
+def test_extra_params():
+    # Pass both alias 'q' and field name 'q_alias'
+    # 'q' should be used for validation, 'q_alias' should be an extra param
+    response = client.get("/?q=value&q_alias=extra")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    # The model should only have 'value'
+    assert response.json() == {"q": "value"} # based on previous run, it uses alias in response
+
+if __name__ == "__main__":
+    test_extra_params()

+def split_graphemes(text: str) -> list[str]:
+    """Split text into grapheme clusters.
+
+    Args:
+        text: The text to split.
+
+    Returns:
+        A list of grapheme clusters.
+    """
+    graphemes = []
+    if not text:
+        return graphemes
+
+    start = 0
+    for i in range(1, len(text)):
+        char = text[i]
+        prev_char = text[i - 1]
+
+        if unicodedata.combining(char) or prev_char == "\u200D" or char == "\u200D":
+            continue
+
+        graphemes.append(text[start:i])
+        start = i
+
+    graphemes.append(text[start:])
+    return graphemes
 
 

+
+from pydantic import Field, Json
+from pydantic.fields import FieldInfo
+from typing import List, Annotated
+import pprint
+
+# In Pydantic v2, Json[T] is often an Annotated[T, Json]
+# Let's see what happens when we create a model with Json[List[str]]
+from pydantic import BaseModel
+
+class MyModel(BaseModel):
+    tags: Json[List[str]]
+
+field = MyModel.model_fields['tags']
+print("Field Info:")
+pprint.pprint(field)
+print("\nMetadata:")
+pprint.pprint(field.metadata)

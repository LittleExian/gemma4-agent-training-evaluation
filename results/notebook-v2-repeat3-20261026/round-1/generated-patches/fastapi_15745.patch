+class RouterRoute(routing.Route):
+    def __init__(
+        self,
+        router: "APIRouter",
+        prefix: str,
+        tags: list[str | Enum] | None = None,
+        dependencies: Sequence[params.Depends] | None = None,
+        responses: dict[int | str, dict[str, Any]] | None = None,
+        default_response_class: type[Response] | None = None,
+        callbacks: list[BaseRoute] | None = None,
+        deprecated: bool | None = None,
+        include_in_schema: bool = True,
+        generate_unique_id_function: Callable[[APIRoute], str] | None = None,
+    ) -> None:
+        super().__init__(path=prefix, methods=None)
+        self.router = router
+        self.prefix = prefix
+        self.tags = tags
+        self.dependencies = dependencies
+        self.responses = responses
+        self.default_response_class = default_response_class
+        self.callbacks = callbacks
+        self.deprecated = deprecated
+        self.include_in_schema = include_in_schema
+        self.generate_unique_id_function = generate_unique_id_function
+
+    async def matches(self, scope: Scope, *args: Any, **kwargs: Any) -> bool:
+        path = scope.get("path", "")
+        if path.startswith(self.prefix):
+            scope = dict(scope)
+            scope["path"] = path[len(self.prefix):]
+            if not scope["path"].startswith("/"):
+                scope["path"] = "/" + scope["path"]
+            return await self.router.matches(scope, *args, **kwargs)
+        return False
+
+    async def handle(self, scope: Scope, receive: Receive, send: Send) -> None:
+        path = scope.get("path", "")
+        scope = dict(scope)
+        scope["path"] = path[len(self.prefix):]
+        if not scope["path"].startswith("/"):
+            scope["path"] = "/" + scope["path"]
+        await self.router.handle(scope, receive, send)
+

+from rich.console import Console
+from rich.live import Live
+from rich.segment import Segment
+from rich.control import Control, ControlType
+import sys
+
+# Force interactive and terminal
+console = Console(force_terminal=True, force_interactive=True)
+
+# Print something without a newline
+console.print("Hello World", end="")
+sys.stdout.flush()
+
+# Create an empty Live object
+with Live("", console=console, auto_refresh=False) as live:
+    # The first refresh might not do much if _shape is None
+    live.refresh()
+    # The second refresh should trigger position_cursor with (0, 0)
+    live.refresh()
+
+# Check if "Hello World" is still there or if it was erased
+# In a real terminal, \r\x1b[2K would erase "Hello World"
+# We can check what was printed to stdout.

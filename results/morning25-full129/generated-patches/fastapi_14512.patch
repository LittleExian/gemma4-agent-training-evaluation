+from typing import Union, Annotated, Literal
+from pydantic import BaseModel, Field
+from fastapi import FastAPI, Body
+from fastapi.dependencies.utils import get_dependant
+from fastapi.params import Body as BodyParam
+from fastapi._compat.v2 import copy_field_info
+import pytest
+
+class Cat(BaseModel):
+    type: Literal["cat"] = "cat"
+    meow: str
+
+class Dog(BaseModel):
+    type: Literal["dog"] = "dog"
+    bark: str
+
+def test_discriminator_preserved():
+    annotation = Annotated[Union[Cat, Dog], Body(discriminator="type")]
+    # Simulate what happens in fastapi/dependencies/utils.py
+    fastapi_annotation = Body(discriminator="type")
+    # This is a simplification of how fastapi_annotation is extracted
+    # In reality, it's extracted from the Annotated
+    
+    # Let's use the actual logic from fastapi/dependencies/utils.py
+    # (simplified)
+    field_info = copy_field_info(field_info=fastapi_annotation, annotation=annotation)
+    
+    print(f"Field info discriminator: {field_info.discriminator}")
+    assert field_info.discriminator == "type"
+
+if __name__ == "__main__":
+    test_discriminator_preserved()

+from rich.console import Console
+from rich.text import Text
+
+console = Console(force_terminal=True)
+
+print("Printing list of strings:")
+console.print(["a", "b", "c"])
+
+print("\nPrinting list of mixed types:")
+console.print(["a", 1, "c"])
+
+print("\nPrinting list of Text objects:")
+console.print([Text("a"), Text("b"), Text("c")])
+
+print("\nPrinting list of mixed types with Text:")
+console.print([Text("a"), 1, Text("c")])
+
+print("\nPrinting empty list:")
+console.print([])

new file mode 100644
index 00000000..30be30e9
--- /dev/null
+++ b/repro_test_param.py
@@ -0,0 +1,25 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+counter = 0
+def my_dep():
+    global counter
+    counter += 1
+    return True
+
+@app.get("/")
+def root(dep1=Depends(my_dep, scope="function"), dep2=Depends(my_dep, scope="function")):
+    return {"counter": counter}
+
+client = TestClient(app)
+def test_parameter_scope_function():
+    global counter
+    counter = 0
+    response = client.get("/")
+    print(f"Counter: {response.json()['counter']}")
+    assert response.json()["counter"] == 2
+
+if __name__ == "__main__":
+    test_parameter_scope_function()

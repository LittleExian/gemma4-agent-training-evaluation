@@ -0,0 +1,41 @@
+
+from __future__ import annotations
+from typing import TYPE_CHECKING, ForwardRef
+from fastapi import FastAPI, Depends
+from fastapi.dependencies.utils import get_typed_annotation, get_typed_signature
+import inspect
+from pydantic import BaseModel
+
+class UserProvider:
+    class User(BaseModel):
+        name: str
+    def get_user(self) -> User:
+        return "user"
+
+def test_repro():
+    provider = UserProvider()
+    call = provider.get_user
+    
+    # This is what get_typed_signature does
+    unwrapped = inspect.unwrap(call)
+    globalns = getattr(unwrapped, "__globals__", {})
+    print(f"Is 'User' in globalns? {'User' in globalns}")
+    
+    # Test get_typed_signature
+    sig_raw = inspect.signature(call)
+    print(f"inspect.signature(call).return_annotation: {sig_raw.return_annotation!r}")
+    sig = get_typed_signature(call)
+    param_annotation = sig.return_annotation
+    print(f"get_typed_signature return_annotation: {param_annotation!r}")
+    
+    # Get the annotation from the function
+    # For Python 3.10+, we can use inspect.signature(call, eval_str=True)
+    # But let's just use the annotation directly
+    annotation = call.__annotations__.get("return")
+    print(f"Annotation: {annotation!r}")
+    
+    typed_annotation = get_typed_annotation(annotation, globalns)
+    print(f"Typed Annotation: {typed_annotation!r}")
+
+if __name__ == "__main__":
+    test_repro()

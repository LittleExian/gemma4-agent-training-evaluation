@@ -0,0 +1,14 @@
+from rich.traceback import Traceback
+import sys
+
+def make_deep_group(depth):
+    eg = ExceptionGroup("level 0", [RuntimeError("base")])
+    for i in range(1, depth):
+        eg = ExceptionGroup(f"level {i}", [eg])
+    return eg
+
+eg = make_deep_group(1000)
+try:
+    raise eg
+except ExceptionGroup as e:
+    Traceback.extract(type(e), e, e.__traceback__)

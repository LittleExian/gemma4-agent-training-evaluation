--- /dev/null
+++ b/repro.py
@@ -0,0 +1,47 @@
+from fastapi import FastAPI, Depends, Query, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, ConfigDict
+from typing import List, Optional
+
+app = FastAPI()
+
+class ExtraModel(BaseModel):
+    model_config = ConfigDict(extra="allow")
+    name: str
+
+def get_extra(extra: ExtraModel = Depends()):
+    return extra
+
+@app.get("/test")
+def test_endpoint(extra: ExtraModel = Depends(get_extra)):
+    return extra.model_dump()
+
+client = TestClient(app)
+
+def test_query_extra_list():
+    # Multiple values for 'extra_param'
+    response = client.get("/test?name=test&extra_param=1&extra_param=2")
+    data = response.json()
+    print(f"Response data: {data}")
+    assert data["extra_param"] == ["1", "2"], f"Expected ['1', '2'], got {data.get('extra_param')}"
+    print("test_query_extra_list passed")
+
+def test_header_extra_list():
+    # Multiple values for 'extra_header'
+    response = client.get("/test?name=test", headers={"extra_header": ["1", "2"]})
+    # Wait, TestClient headers might not support lists like this.
+    # Let's use a more reliable way to send multiple headers.
+    # Actually, TestClient uses httpx, and httpx supports multiple headers.
+    # But let's check.
+    data = response.json()
+    assert data["extra_header"] == ["1", "2"], f"Expected ['1', '2'], got {data.get('extra_header')}"
+    print("test_header_extra_list passed")
+
+if __name__ == "__main__":
+    try:
+        test_query_extra_list()
+        test_header_extra_list()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)

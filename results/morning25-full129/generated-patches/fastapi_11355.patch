diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..ed69f205
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,23 @@
+
+from __future__ import annotations
+from fastapi import FastAPI
+from pydantic import BaseModel
+from typing import List, get_type_hints
+import inspect
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    tags: List[str]
+
+@app.get("/items/")
+def read_items(item: Item) -> Item:
+    return item
+
+if __name__ == "__main__":
+    print(f"get_type_hints(read_items): {get_type_hints(read_items)}")
+    
+    sig = inspect.signature(read_items)
+    for name, param in sig.parameters.items():
+        print(f"Param {name}: {param.annotation}, type: {type(param.annotation)}")
diff --git a/repro_fix.py b/repro_fix.py
new file mode 100644
index 00000000..b556cef7
--- /dev/null
+++ b/repro_fix.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+from typing import List, get_type_hints
+import inspect
+from fastapi.dependencies.utils import get_typed_return_annotation, get_typed_signature
+
+def test_func() -> List[int]:
+    return [1, 2, 3]
+
+def test_repro():
+    ret_ann = get_typed_return_annotation(test_func)
+    print(f"Return annotation: {ret_ann} (type: {type(ret_ann)})")
+    
+    sig = get_typed_signature(test_func)
+    print(f"Signature: {sig}")
+    
+    # In Python 3.10+ with from __future__ import annotations, 
+    # ret_ann should be typing.List[int], not 'List[int]'
+    if isinstance(ret_ann, str):
+        print("FAILED: Return annotation is still a string")
+        exit(1)
+    else:
+        print("PASSED: Return annotation is resolved")
+
+if __name__ == "__main__":
+    test_repro()

+        return True
+    def write(self, text):
+        pass
+    def flush(self):
+        pass
+
+def test_isatty_bug():
+    file = FileWithIsatty()
+    from rich.console import Console
+    console = Console()
+    proxy = FileProxy(console, file)
+    

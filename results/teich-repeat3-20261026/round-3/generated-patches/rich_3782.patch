+from rich.console import Console
+from rich.syntax import Syntax
+from rich.padding import Padding
+from rich.style import Style
+from rich.segment import Segment
+
+console = Console(width=100)
+
+def get_all_segments(renderable, console, options):
+    all_segments = []
+    for result in renderable.__rich_console__(console, options):
+        if hasattr(result, "__rich_console__"):
+            # It's another renderable (like Padding)
+            for seg in result.__rich_console__(console, options):
+                if isinstance(seg, list):
+                    all_segments.extend(seg)
+                elif isinstance(seg, Segment):
+                    all_segments.append(seg)
+                else:
+                    # Handle other cases if any
+                    pass
+        elif isinstance(result, list):
+            all_segments.extend(result)
+        elif isinstance(result, Segment):
+            all_segments.append(result)
+        else:
+            # Handle other cases
+            pass
+    return all_segments
+
+def print_segments_info(test_name, segs):
+    print(f"{test_name}: {len(segs)} segments")
+    total_width = 0
+    for i, seg in enumerate(segs):
+        width = len(seg.text)
+        total_width += width
+        print(f"  {i}: width={width}, style={seg.style}, text={repr(seg.text)}")
+    print(f"  Total width: {total_width}")
+
+# Test 1: No padding
+syntax1 = Syntax("print('hello')", "python", background_color="blue")
+segs1 = get_all_segments(syntax1, console, console.options)
+print_segments_info("Test 1", segs1)
+
+# Test 2: Padding as int
+syntax2 = Syntax("print('hello')", "python", padding=1, background_color="blue")
+segs2 = get_all_segments(syntax2, console, console.options)
+print_segments_info("Test 2", segs2)
+
+# Test 3: Padding as tuple
+syntax3 = Syntax("print('hello')", "python", padding=(1, 2, 3, 4), background_color="blue")
+segs3 = get_all_segments(syntax3, console, console.options)
+print_segments_info("Test 3", segs3)
+
+# Test 4: Padding with line numbers
+syntax4 = Syntax("print('hello')", "python", line_numbers=True, padding=1, background_color="blue")
+segs4 = get_all_segments(syntax4, console, console.options)
+print_segments_info("Test 4", segs4)
+
+# Test 5: Padding with line numbers and tuple
+syntax5 = Syntax("print('hello')", "python", line_numbers=True, padding=(1, 2, 3, 4), background_color="blue")
+segs5 = get_all_segments(syntax5, console, console.options)
+print_segments_info("Test 5", segs5)
+
+# Test 6: Padding with code_width
+syntax6 = Syntax("print('hello')", "python", code_width=10, padding=1, background_color="blue")
+segs6 = get_all_segments(syntax6, console, console.options)
+print_segments_info("Test 6", segs6)
+
+# Test 7: Padding with code_width and line numbers
+syntax7 = Syntax("print('hello')", "python", code_width=10, line_numbers=True, padding=1, background_color="blue")
+segs7 = get_all_segments(syntax7, console, console.options)
+print_segments_info("Test 7", segs7)

+from fastapi import FastAPI
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+
+async def s_shutdown():
+    print("ASYNC SHUTDOWN", flush=True)
+
+app = FastAPI(on_startup=[s_start], on_shutdown=[s_shutdown])
+
+@app.get("/health")
+async def health():
+    return {"ok": True}
+
+async def test_startup_shutdown():
+    # We need to simulate the lifespan of the app
+    # In a real scenario, this is handled by the ASGI server
+    async with app.lifespan(None):
+        print("Inside lifespan")
+
+if __name__ == "__main__":
+    asyncio.run(test_startup_shutdown())

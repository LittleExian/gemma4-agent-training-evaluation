+def split_graphemes(text: str) -> list[str]:
+    \"\"\"Split text into grapheme clusters.\"\"\"
+    if not text:
+        return []
+    graphemes = []
+    i = 0
+    while i < len(text):
+        char = text[i]
+        grapheme = char
+        i += 1
+        while i < len(text):
+            next_char = text[i]
+            if next_char == \"\\u200d\":  # ZWJ
+                grapheme += next_char
+                i += 1
+                if i < len(text):
+                    grapheme += text[i]
+                    i += 1
+                continue
+            if (
+                \"\\u0300\" <= next_char <= \"\\u036f\"
+                or \"\\u1ab0\" <= next_char <= \"\\u1aff\"
+                or \"\\u1dc0\" <= next_char <= \"\\u1dff\"
+                or \"\\u20d0\" <= next_char <= \"\\u20ff\"
+                or \"\\ufe20\" <= next_char <= \"\\ufe2f\"
+                or \"\\ufe00\" <= next_char <= \"\\ufe0f\"
+            ):
+                grapheme += next_char
+                i += 1
+                continue
+            if \"\\U0001f1e6\" <= char <= \"\\U0001f1ff\" and \"\\U0001f1e6\" <= next_char <= \"\\U0001f1ff\":
+                grapheme += next_char
+                i += 1
+                char = next_char
+                continue
+            break
+        graphemes.append(grapheme)
+    return graphemes
+

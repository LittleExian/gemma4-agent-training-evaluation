+from fastapi import FastAPI, Body, Query
+from typing import List, Optional, Union
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/test")
+def test_endpoint(q: List[str] = None):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_optional_sequence():
+    # Test with no q query parameter
+    response = client.get("/test")
+    print(f"No q: {response.json()}")
+    assert response.json() == {"q": None}
+
+    # Test with q query parameter
+    response = client.get("/test", params={"q": "a"})
+    print(f"q=a: {response.json()}")
+    assert response.json() == {"q": ["a"]}
+
+    # Test with multiple q query parameters
+    response = client.get("/test", params={"q": ["a", "b"]})
+    print(f"q=a&q=b: {response.json()}")
+    assert response.json() == {"q": ["a", "b"]}
+
+if __name__ == "__main__":
+    test_optional_sequence()

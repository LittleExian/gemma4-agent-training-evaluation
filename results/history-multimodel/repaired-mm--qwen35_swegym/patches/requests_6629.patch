@@ -41,6 +41,14 @@ class JSONDecodeError(InvalidJSONError, CompatJSONDecodeError):
         CompatJSONDecodeError.__init__(self, *args)
         InvalidJSONError.__init__(self, *self.args, **kwargs)
 
+    def __reduce__(self):
+        """
+        Ensure that the JSONDecodeError can be properly pickled and unpickled.
+        This is necessary because the MRO of the class causes the __reduce__

+from typing import List, Optional
+from fastapi import FastAPI
+from pydantic import BaseModel, Field, computed_field
+
+
+def show(app, label):
+    schema = app.openapi()
+    names = sorted(schema.get("components", {}).get("schemas", {}).keys())
+    print(f"--- {label} ---")
+    print(names)
+    return schema
+
+
+# Scenario 1: nested model used in both input and output (simple)
+class SubItem(BaseModel):
+    name: str
+
+
+class Item(BaseModel):
+    id: int
+    sub: SubItem
+
+
+app = FastAPI()
+
+
+@app.post("/items/")
+def create_item(item: Item):
+    return item
+
+
+@app.get("/items/")
+def get_items() -> List[Item]:
+    return []
+
+
+show(app, "S1: nested in both in/out")
+
+# Scenario 2: nested model only in output
+app2 = FastAPI()
+
+
+@app2.post("/items/")
+def create_item2(item: Item):
+    return {"ok": True}
+
+
+@app2.get("/items/")
+def get_items2() -> List[SubItem]:
+    return []
+
+
+show(app2, "S2: nested only in output")
+
+# Scenario 3: nested model with serialization difference (computed field)
+class SubItem3(BaseModel):
+    name: str
+
+    @computed_field
+    @property
+    def name_upper(self) -> str:
+        return self.name.upper()
+
+
+class Item3(BaseModel):
+    id: int
+    sub: SubItem3
+
+
+app3 = FastAPI()
+
+
+@app3.post("/items/")
+def create_item3(item: Item3):
+    return item
+
+
+@app3.get("/items/")
+def get_items3() -> List[Item3]:
+    return []
+
+
+show(app3, "S3: nested with computed field")
+
+# Scenario 4: nested model with exclude in serialization
+class SubItem4(BaseModel):
+    name: str
+    secret: str = Field(exclude=True)
+
+
+class Item4(BaseModel):
+    id: int
+    sub: SubItem4
+
+
+app4 = FastAPI()
+
+
+@app4.post("/items/")
+def create_item4(item: Item4):
+    return item
+
+
+@app4.get("/items/")
+def get_items4() -> List[Item4]:
+    return []
+
+
+show(app4, "S4: nested with exclude=True")
+
+# Scenario 5: nested model with different default in serialization
+class SubItem5(BaseModel):
+    name: str
+    extra: Optional[str] = None
+
+
+class Item5(BaseModel):
+    id: int
+    sub: SubItem5
+
+
+app5 = FastAPI()
+
+
+@app5.post("/items/")
+def create_item5(item: Item5):
+    return item
+
+
+@app5.get("/items/")
+def get_items5() -> List[Item5]:
+    return []
+
+
+show(app5, "S5: nested with optional default")
+
+# Scenario 6: nested model used in output only, nested inside output model
+class SubItem6(BaseModel):
+    name: str
+
+
+class Item6(BaseModel):
+    id: int
+    sub: SubItem6
+
+
+app6 = FastAPI()
+
+
+@app6.post("/items/")
+def create_item6(item: Item6):
+    return {"ok": True}
+
+
+@app6.get("/items/")
+def get_items6() -> List[Item6]:
+    return []
+
+
+show(app6, "S6: nested only in output (inside Item)")

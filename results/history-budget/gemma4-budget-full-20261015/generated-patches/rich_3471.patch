@@ -0,0 +1,13 @@
+from rich.text import Text
+
+def test_append_tokens_none():
+    text = Text("Hello")
+    try:
+        text.append_tokens(None)
+        print("Success: append_tokens(None) did not raise an exception")
+    except Exception as e:
+        print(f"Failure: append_tokens(None) raised {type(e).__name__}: {e}")
+        raise e
+
+if __name__ == "__main__":
+    test_append_tokens_none()

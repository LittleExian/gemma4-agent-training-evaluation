diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..726a4cd5
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,37 @@
+
+import requests
+from requests.models import Request
+
+class FileWrapper:
+    def __init__(self, fileobj):
+        self._fileobj = fileobj
+
+    def __getattr__(self, name):
+        return getattr(self._fileobj, name)
+
+def test_getattr_wrapper():
+    import io
+    content = b"hello world"
+    f = io.BytesIO(content)
+    wrapper = FileWrapper(f)
+
+    # This should be detected as a file and read
+    files = {'file': wrapper}
+    
+    # We want to see if _encode_files handles this correctly.
+    # _encode_files is a method of Request (or rather, it's called during preparation)
+    # Let's use a Request object to trigger it.
+    req = Request('POST', 'http://httpbin.org/post', files=files)
+    prepared = req.prepare()
+    
+    # The body should contain the content of the file
+    assert b"hello world" in prepared.body
+    print("Success!")
+
+if __name__ == "__main__":
+    try:
+        test_getattr_wrapper()
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        exit(1)

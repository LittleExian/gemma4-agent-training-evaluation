diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..c453175e
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,58 @@
+from fastapi import FastAPI, Body, HTTPException
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/strict")
+async def strict_endpoint(data: dict = Body(..., strict_content_type=True)):
+    return data
+
+@app.post("/lenient")
+async def lenient_endpoint(data: dict = Body(..., strict_content_type=False)):
+    return data
+
+client = TestClient(app)
+
+def test_strict_no_content_type():
+    import json
+    response = client.post("/strict", content=json.dumps({"foo": "bar"}), headers={})
+    print(f"Status: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 415
+    assert response.json()["detail"] == "Unsupported Media Type. Expected application/json"
+
+def test_strict_wrong_content_type():
+    import json
+    response = client.post("/strict", content=json.dumps({"foo": "bar"}), headers={"content-type": "application/ld+json"})
+    assert response.status_code == 415
+    assert response.json()["detail"] == "Unsupported Media Type. Expected application/json"
+
+def test_strict_correct_content_type():
+    import json
+    response = client.post("/strict", content=json.dumps({"foo": "bar"}), headers={"content-type": "application/json"})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+def test_lenient_no_content_type():
+    import json
+    response = client.post("/lenient", content=json.dumps({"foo": "bar"}), headers={})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+def test_lenient_wrong_content_type():
+    import json
+    response = client.post("/lenient", content=json.dumps({"foo": "bar"}), headers={"content-type": "application/ld+json"})
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+if __name__ == "__main__":
+    try:
+        test_strict_no_content_type()
+        test_strict_wrong_content_type()
+        test_strict_correct_content_type()
+        test_lenient_no_content_type()
+        test_lenient_wrong_content_type()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e

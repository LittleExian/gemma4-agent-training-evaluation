@@ -0,0 +1,97 @@
+
+from fastapi import FastAPI, Query, Header, Cookie
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    q: str = Field(..., alias="query-param")
+
+@app.get("/query")
+async def read_query(params: QueryModel = Query()):
+    return params
+
+class HeaderModel(BaseModel):
+    h: str = Field(..., alias="header-param")
+
+@app.get("/header")
+async def read_header(params: HeaderModel = Header()):
+    return params
+
+class CookieModel(BaseModel):
+    c: str = Field(..., alias="cookie-param")
+
+@app.get("/cookie")
+async def read_cookie(params: CookieModel = Cookie()):
+    return params
+
+client = TestClient(app)
+
+def test_query_alias():
+    # Test 1: Value extracted by alias, should be put into values with alias
+    response = client.get("/query", params={"query-param": "value"})
+    if response.status_code != 200:
+        print(f"Query alias Test 1 failed: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    print(f"Query alias Test 1 response: {response.json()}")
+    assert response.json() == {"q": "value"}
+
+    # Test 2: Value passed by name, should be validation error and input should contain extra parameter
+    response = client.get("/query", params={"q": "value"})
+    assert response.status_code == 422
+    errors = response.json()["detail"]
+    print(f"Query alias Test 2 error: {errors}")
+
+def test_header_alias():
+    # Test 1: Value extracted by alias
+    response = client.get("/header", headers={"header-param": "value"})
+    if response.status_code != 200:
+        print(f"Header alias Test 1 failed: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    print(f"Header alias Test 1 response: {response.json()}")
+    assert response.json() == {"h": "value"}
+
+    # Test 2: Value passed by name
+    response = client.get("/header", headers={"h": "value"})
+    assert response.status_code == 422
+    print(f"Header alias Test 2 error: {response.json()['detail']}")
+
+def test_cookie_alias():
+    # Test 1: Value extracted by alias
+    response = client.get("/cookie", cookies={"cookie-param": "value"})
+    if response.status_code != 200:
+        print(f"Cookie alias Test 1 failed: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+    print(f"Cookie alias Test 1 response: {response.json()}")
+    assert response.json() == {"c": "value"}
+
+    # Test 2: Value passed by name
+    response = client.get("/cookie", cookies={"c": "value"})
+    assert response.status_code == 422
+    print(f"Cookie alias Test 2 error: {response.json()['detail']}")
+
+if __name__ == "__main__":
+    try:
+        test_query_alias()
+        print("Query alias OK")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        print(f"Query alias failed: {e}")
+    
+    try:
+        test_header_alias()
+        print("Header alias OK")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        print(f"Header alias failed: {e}")
+
+    try:
+        test_cookie_alias()
+        print("Cookie alias OK")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        print(f"Cookie alias failed: {e}")

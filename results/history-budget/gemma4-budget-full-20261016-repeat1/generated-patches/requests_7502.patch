diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..3767ba6c
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,31 @@
+
+import requests
+from requests.models import Request
+
+class FileWrapper:
+    def __getattr__(self, name):
+        if name == 'read':
+            return lambda length=None: b'file content'
+        raise AttributeError(name)
+
+def test_getattr_wrapper():
+    files = {'file': FileWrapper()}
+    # We can use requests.post or just Request.prepare
+    # But _encode_files is called during preparation of a Request with files.
+    # Let's use requests.post with a mock server or just check the prepared request.
+    
+    # Using a simple Request object and preparing it.
+    req = requests.Request('POST', 'http://httpbin.org/post', files=files)
+    prepared = req.prepare()
+    
+    print(f"Body: {prepared.body}")
+    assert b'file content' in prepared.body
+
+if __name__ == "__main__":
+    try:
+        test_getattr_wrapper()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()

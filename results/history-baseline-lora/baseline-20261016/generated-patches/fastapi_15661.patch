+"""Automate release preparation."""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+VERSION_FILE = "fastapi/__init__.py"
+RELEASE_NOTES_FILE = "docs/en/docs/release-notes.md"
+
+def update_version(new_version: str):
+    print(f"Updating version to {new_version} in {VERSION_FILE}...")
+    with open(VERSION_FILE, "r") as f:
+        content = f.read()
+    
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    
+    with open(VERSION_FILE, "w") as f:
+        f.write(new_content)
+
+def add_release_header(new_version: str):
+    print(f"Adding release header for {new_version} to {RELEASE_NOTES_FILE}...")
+    with open(RELEASE_NOTES_FILE, "r") as f:
+        lines = f.readlines()
+    
+    # Find the first occurrence of a version header ## X.Y.Z
+    version_pattern = re.compile(r"^## \d+\.\d+\.\d+")
+    insert_index = -1
+    for i, line in enumerate(lines):
+        if version_pattern.match(line):
+            insert_index = i
+            break
+    
+    if insert_index == -1:
+        # If no version header found, put it after "## Latest Changes" or at the end
+        for i, line in enumerate(lines):
+            if line.strip() == "## Latest Changes":
+                insert_index = i + 1
+                break
+        if insert_index == -1:
+            insert_index = len(lines)
+    
+    lines.insert(insert_index, f"## {new_version}\n\n")
+    
+    with open(RELEASE_NOTES_FILE, "w") as f:
+        f.writelines(lines)
+
+def run_script(script_path: str):
+    print(f"Running {script_path}...")
+    if script_path.endswith(".py"):
+        cmd = ["python3", script_path]
+    else:
+        cmd = ["/bin/bash", script_path]
+    
+    result = subprocess.run(cmd, capture_output=True, text=True)
+    if result.returncode != 0:
+        print(f"Error running {script_path}: {result.stderr}")
+        sys.exit(1)
+    print(result.stdout)
+
+def main():
+    parser = argparse.ArgumentParser(description="Automate release preparation")
+    parser.add_argument("version", help="The new version to set (e.g. 0.136.4)")
+    args = parser.parse_args()
+    
+    update_version(args.version)
+    add_release_header(args.version)
+    run_script("scripts/add_latest_release_date.py")
+    run_script("scripts/format.sh")
+    run_script("scripts/lint.sh")
+    run_script("scripts/test.sh")
+    
+    print("Release preparation complete!")
+
+if __name__ == "__main__":
+    main()

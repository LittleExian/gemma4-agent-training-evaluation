+from rich.console import Console
+
+def test_record_capture():
+    console = Console(record=True, width=40)
+    with console.capture() as capture:
+        console.print("Hello")
+        console.print("World")
+    
+    # The captured output should be "Hello\nWorld\n"
+    captured = capture.get()
+    print(f"Captured: {repr(captured)}")
+    
+    # The recorded output should also be "Hello\nWorld\n"
+    recorded = console.export_text()
+    print(f"Recorded: {repr(recorded)}")
+    
+    assert captured.strip() == recorded.strip()
+
+if __name__ == "__main__":
+    test_record_capture()

@@ -0,0 +1,55 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi_security_definitions
+from fastapi.dependencies.models import Dependant, SecurityRequirement
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def dep_with_scopes():
+    pass
+
+def dep_without_scopes():
+    pass
+
+# We need to simulate how FastAPI creates Dependants
+# This is a bit complex to do manually, so let's use the actual FastAPI machinery if possible
+# or just mock the Dependant objects.
+
+# Case: Parent dependency with scopes, sub-dependency security scheme without scopes
+# Parent: Security(oauth2_scheme, scopes=["read"])
+# Sub: Depends(dep_without_scopes) where dep_without_scopes uses Security(oauth2_scheme)
+
+# Let's try to build the Dependant tree manually to see what happens in get_flat_dependant
+
+# Security scheme
+scheme = oauth2_scheme
+
+# Sub-dependency: Security(oauth2_scheme) -> no scopes
+sub_dep = Dependant(
+    security_requirements=[SecurityRequirement(security_scheme=scheme, scopes=None)],
+    call=dep_without_scopes,
+)
+
+# Parent dependency: Security(oauth2_scheme, scopes=["read"]) -> scopes=["read"]
+# and it depends on sub_dep
+parent_dep = Dependant(
+    security_requirements=[SecurityRequirement(security_scheme=scheme, scopes=["read"])],
+    dependencies=[sub_dep],
+    call=dep_with_scopes,
+)
+
+from fastapi.dependencies.utils import get_flat_dependant
+
+flat_parent = get_flat_dependant(parent_dep)
+print(f"Flat parent security requirements: {flat_parent.security_requirements}")
+
+# Now let's see what get_openapi_security_definitions does
+security_definitions, operation_security = get_openapi_security_definitions(flat_parent)
+print(f"Operation security: {operation_security}")
+
+# Now let's see what happens if we have another path operation that uses sub_dep directly
+flat_sub = get_flat_dependant(sub_dep)
+security_definitions_sub, operation_security_sub = get_openapi_security_definitions(flat_sub)
+print(f"Sub operation security: {operation_security_sub}")

diff --git a/verify_tty_interactive.py b/verify_tty_interactive.py
new file mode 100644
index 00000000..dfcebb35
--- /dev/null
+++ b/verify_tty_interactive.py
@@ -0,0 +1,31 @@
+
+import os
+from rich.console import Console
+from rich.progress import Progress
+from rich.status import Status
+
+def test_progress_disabled():
+    os.environ["TTY_INTERACTIVE"] = "0"
+    console = Console()
+    with Progress(console=console) as progress:
+        # If disabled, progress.disable should be True
+        print(f"Progress disabled: {progress.disable}")
+        assert progress.disable is True
+
+def test_status_disabled():
+    os.environ["TTY_INTERACTIVE"] = "0"
+    console = Console()
+    with Status("Working...", console=console) as status:
+        # If disabled, status.disable should be True
+        print(f"Status disabled: {status.disable}")
+        assert status.disable is True
+
+if __name__ == "__main__":
+    try:
+        test_progress_disabled()
+        print("Progress test passed")
+        test_status_disabled()
+        print("Status test passed")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)

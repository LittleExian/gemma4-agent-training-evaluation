diff --git a/verify_prompt.py b/verify_prompt.py
new file mode 100644
index 00000000..d525251d
--- /dev/null
+++ b/verify_prompt.py
@@ -0,0 +1,66 @@
+from rich.prompt import Prompt
+from unittest.mock import MagicMock
+from rich.console import Console
+
+def test_prompt_case_sensitive():
+    console = Console()
+    # Mock console.input to return "paul"
+    console.input = MagicMock(return_value="paul")
+    
+    # Case sensitive (default) - should fail and loop
+    # Since it loops, we need to mock it to return "Paul" eventually
+    console.input.side_effect = ["paul", "Paul"]
+    
+    # We can't easily test the loop without mocking more or using a stream
+    # Let's use a stream instead.
+    pass
+
+def test_prompt_case_insensitive():
+    from io import StringIO
+    
+    # Case insensitive: "paul" should be accepted for ["Paul", "Jessica", "Duncan"]
+    # We use a StringIO stream to simulate input
+    input_stream = StringIO("paul\n")
+    
+    # We need to mock the console to use the stream
+    console = Console()
+    
+    # Prompt.ask returns the result of _prompt(default=default, stream=stream)
+    # _prompt is an instance of Prompt (which is PromptBase[str])
+    # __call__ uses get_input which calls console.input(prompt, password, stream=stream)
+    
+    # Let's just test the Prompt instance directly
+    prompt = Prompt("Enter name", choices=["Paul", "Jessica", "Duncan"], case_sensitive=False)
+    result = prompt(default="Paul", stream=input_stream)
+    
+    print(f"Result: {result}")
+    assert result == "paul"
+
+def test_prompt_case_sensitive_fail():
+    from io import StringIO
+    
+    # Case sensitive: "paul" should NOT be accepted for ["Paul", "Jessica", "Duncan"]
+    # It should loop. To avoid infinite loop, we provide a valid one after.
+    input_stream = StringIO("paul\nPaul\n")
+    
+    console = Console()
+    prompt = Prompt("Enter name", choices=["Paul", "Jessica", "Duncan"], case_sensitive=True)
+    
+    # We need to capture the output to see the error message, but for now just check result
+    result = prompt(default="Paul", stream=input_stream)
+    
+    print(f"Result: {result}")
+    assert result == "Paul"
+
+if __name__ == "__main__":
+    try:
+        test_prompt_case_insensitive()
+        print("test_prompt_case_insensitive passed")
+        test_prompt_case_sensitive_fail()
+        print("test_prompt_case_sensitive_fail passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)

+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.dependencies.utils import get_dependant
+from fastapi.dependencies.models import Dependant
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def parent_with_scopes(token: str = Security(oauth2_scheme, scopes=["scope1"])):
+    return token
+
+app = FastAPI()
+
+# Simulate /reversed
+# root_reversed(token: str = Depends(oauth2_scheme), parent: str = Depends(parent_with_scopes))
+
+# We need to simulate how FastAPI creates Dependants.
+# For simplicity, let's just use get_dependant.
+
+dep_a = get_dependant(
+    path="/reversed",
+    call=oauth2_scheme,
+    name="token",
+    own_oauth_scopes=[],
+    parent_oauth_scopes=[],
+)
+
+dep_parent = get_dependant(
+    path="/reversed",
+    call=parent_with_scopes,
+    name="parent",
+    own_oauth_scopes=[],
+    parent_oauth_scopes=[],
+)
+
+# Now dep_parent will have dep_c as a dependency
+dep_c = dep_parent.dependencies[0]
+
+print(f"dep_a cache_key: {dep_a.cache_key}")
+print(f"dep_c cache_key: {dep_c.cache_key}")
+print(f"dep_a._uses_scopes: {dep_a._uses_scopes}")
+print(f"dep_c._uses_scopes: {dep_c._uses_scopes}")
+print(f"dep_a.oauth_scopes: {dep_a.oauth_scopes}")
+print(f"dep_c.oauth_scopes: {dep_c.oauth_scopes}")

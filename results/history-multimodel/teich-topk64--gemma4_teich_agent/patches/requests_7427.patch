+++ b/verify_no_proxy.py
@@ -0,0 +1,27 @@
+from requests.utils import should_bypass_proxies
+
+test_cases = [
+    # (url, no_proxy, expected)
+    ("http://example.com/", "example.com", True),
+    ("http://foo.example.com/", "example.com", True),
+    ("http://fooexample.com/", "example.com", False),
+    ("http://example.com/", ".example.com", True),
+    ("http://foo.example.com/", ".example.com", True),
+    ("http://fooexample.com/", ".example.com", False),
+    ("http://example.com:80/", "example.com", True),
+    ("http://foo.example.com:80/", "example.com", True),
+    ("http://fooexample.com:80/", "example.com", False),
+    ("http://example.com:80/", "example.com:80", True),
+    ("http://foo.example.com:80/", "example.com:80", False),
+    ("http://example.com:81/", "example.com:80", False),
+    ("http://example.com:80/", "example.com:81", False),
+    ("http://example.com:80/", ".example.com:80", False), # Ported behavior: port entries are exact
+    ("http://foo.example.com:80/", ".example.com:80", False),
+]
+
+for url, no_proxy, expected in test_cases:
+    result = should_bypass_proxies(url, no_proxy=no_proxy)
+    print(f"url={url}, no_proxy={no_proxy}, expected={expected}, result={result}")
+    assert result == expected
+
+print("All tests passed!")

diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..feb2d7ed
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,31 @@
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Extra
+
+class MyModel(BaseModel):
+    param: str
+    class Config:
+        extra = Extra.allow
+
+app = FastAPI()
+
+@app.get("/")
+async def read_root(params: MyModel = Query()):
+    return params
+
+client = TestClient(app)
+
+def test_extra_params_multiple_values():
+    # param is defined, param2 is extra
+    # param2 has multiple values: 456 and 789
+    response = client.get("/?param=123&param2=456&param2=789")
+    print(f"Response: {response.json()}")
+    assert response.json() == {"param": "123", "param2": ["456", "789"]}
+
+if __name__ == "__main__":
+    try:
+        test_extra_params_multiple_values()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed!")
+        raise e

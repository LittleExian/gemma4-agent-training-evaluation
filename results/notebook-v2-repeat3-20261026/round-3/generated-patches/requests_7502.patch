index 00000000..75ab77c5
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+
+import requests
+from io import BytesIO
+
+class Wrapper:
+    def __init__(self, target):
+        self.target = target
+    def __getattr__(self, name):
+        return getattr(self.target, name)
+
+def test_wrapper():
+    content = b"hello world"
+    bio = BytesIO(content)
+    wrapper = Wrapper(bio)
+    
+    files = {'file': ('test.txt', wrapper)}
+    
+    try:
+        # We use a mock adapter or just a real request to a non-existent server to see if it fails during preparation
+        # But we can just check if it can be prepared.
+        req = requests.Request('POST', 'http://httpbin.org/post', files=files)
+        prepared = req.prepare()
+        print("Prepared successfully")
+        print("Body length:", len(prepared.body))
+    except Exception as e:
+        print("Failed:", e)
+
+if __name__ == "__main__":
+    test_wrapper()

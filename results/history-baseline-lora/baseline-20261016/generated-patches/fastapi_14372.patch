@@ -0,0 +1,23 @@
+from fastapi.params import Depends, Security
+
+def test_depends_hashable():
+    d1 = Depends(dependency=lambda: 1)
+    d2 = Depends(dependency=lambda: 1)
+    # Note: lambda functions are not equal and have different hashes
+    # So we should use a named function
+    def foo(): pass
+    d1 = Depends(dependency=foo)
+    d2 = Depends(dependency=foo)
+    print(f"Depends hashable: {hash(d1) == hash(d2)}")
+    print(f"Depends equal: {d1 == d2}")
+
+def test_security_hashable():
+    def foo(): pass
+    s1 = Security(dependency=foo, scopes=["admin"])
+    s2 = Security(dependency=foo, scopes=["admin"])
+    print(f"Security hashable: {hash(s1) == hash(s2)}")
+    print(f"Security equal: {s1 == s2}")
+
+if __name__ == "__main__":
+    test_depends_hashable()
+    test_security_hashable()

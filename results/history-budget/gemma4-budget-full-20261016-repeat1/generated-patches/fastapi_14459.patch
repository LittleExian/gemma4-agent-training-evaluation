diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..580a8885
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,38 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.dependencies.utils import get_flat_dependant
+from fastapi.routing import APIRoute
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+app = FastAPI()
+
+# dep_c is a dependency that depends on a security scheme
+def dep_c(token = Security(oauth2_scheme)):
+    return token
+
+# dep_a depends on dep_c
+def dep_a(c = Depends(dep_c)):
+    return "a"
+
+# dep_b depends on dep_c
+def dep_b(c = Depends(dep_c)):
+    return "b"
+
+# We use Security() to give dep_a scopes
+@app.get("/test", dependencies=[Security(dep_a, scopes=["read"]), Security(dep_b)])
+def test_route():
+    return {"message": "hello"}
+
+route = next(r for r in app.routes if isinstance(r, APIRoute))
+flat_dependant = get_flat_dependant(route.dependant, skip_repeats=True)
+
+print(f"Security requirements: {flat_dependant.security_requirements}")
+all_scopes = []
+for req in flat_dependant.security_requirements:
+    if req.scopes:
+        all_scopes.extend(req.scopes)
+
+print(f"All scopes: {all_scopes}")
+assert "read" in all_scopes, f"Expected 'read' scope to be present, but got {all_scopes}"

new file mode 100644
index 00000000..88230043
--- /dev/null
+++ b/repro_too_small.py
@@ -0,0 +1,23 @@
+from rich.console import Console
+from rich.padding import Padding
+
+def test_padding_too_small():
+    # Console width is 3, but padding is 2+2=4
+    console = Console(width=3)
+    renderable = "Hello"
+    padding = Padding(renderable, (0, 2, 0, 2), expand=True)
+    
+    with console.capture() as capture:
+        console.print(padding)
+    
+    output = capture.get()
+    print(f"Output:\n{output!r}")
+    
+    lines = output.splitlines()
+    for i, line in enumerate(lines):
+        print(f"Line {i}: length {len(line)}")
+        if len(line) > 3:
+            print(f"FAILED: Line {i} length {len(line)} exceeds console width 3")
+
+if __name__ == "__main__":
+    test_padding_too_small()

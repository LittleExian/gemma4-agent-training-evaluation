@@ -0,0 +1,28 @@
+from rich.console import Console
+from rich._wrap import divide_line
+
+def test_wrap():
+    text = "你好世界"
+    width = 2
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+    
+    # Expected: divides = [1, 2, 3]
+    # Result: [1, 2, 3]
+    
+    text = "你好世界"
+    width = 4
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+    # Expected: divides = [2]
+    # Result: []
+    
+    text = "你好世界"
+    width = 1
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+    # Expected: divides = [1, 2, 3]
+    # Result: [1, 2, 3]
+
+if __name__ == "__main__":
+    test_wrap()

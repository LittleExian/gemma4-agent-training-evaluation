diff --git a/reproduce_fastapi.py b/reproduce_fastapi.py
new file mode 100644
index 00000000..95d5a657
--- /dev/null
+++ b/reproduce_fastapi.py
@@ -0,0 +1,32 @@
+from fastapi import FastAPI, Form, UploadFile
+from pydantic import Json
+from typing import Annotated, List
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    file: UploadFile,
+    tags: Annotated[Json[List[str]], Form()]
+):
+    return {"file": file.filename, "tags": tags}
+
+client = TestClient(app)
+
+def test_upload():
+    # Client sends
+    # data = {"items": '["abc", "def"]'}  # JSON string
+    # But the field name is 'tags'
+    files = {"file": ("test.txt", b"content")}
+    data = {"tags": '["abc", "def"]'}
+    response = client.post("/upload", files=files, data=data)
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_upload()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")

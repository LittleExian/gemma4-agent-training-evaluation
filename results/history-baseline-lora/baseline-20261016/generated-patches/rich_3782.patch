+from rich.console import Console
+from rich.syntax import Syntax
+from rich.segment import Segment
+
+def test_padding_consistency():
+    console = Console(width=80, force_terminal=True)
+    
+    # Case 1: padding=0
+    syntax_0 = Syntax("print('hello')", padding=0)
+    res_0 = list(console.render_lines(syntax_0))
+    flattened_0 = [seg for line in res_0 for seg in line]
+    
+    # Case 2: padding=(0, 0, 0, 0)
+    syntax_tuple = Syntax("print('hello')", padding=(0, 0, 0, 0))
+    res_tuple = list(console.render_lines(syntax_tuple))
+    flattened_tuple = [seg for line in res_tuple for seg in line]
+    
+    print(f"Result 0 length: {len(flattened_0)}")
+    print(f"Result tuple length: {len(flattened_tuple)}")
+    
+    if flattened_0 == flattened_tuple:
+        print("SUCCESS: Results are the same")
+    else:
+        print("FAILURE: Results are different")
+        print(f"Res 0: {flattened_0}")
+        print(f"Res tuple: {flattened_tuple}")
+
+if __name__ == "__main__":
+    test_padding_consistency()

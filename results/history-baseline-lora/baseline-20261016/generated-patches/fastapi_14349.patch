--- /dev/null
+++ b/repro.py
@@ -0,0 +1,31 @@
+from fastapi._compat.v2 import _replace_refs
+from fastapi.openapi.constants import REF_TEMPLATE
+
+old_name_to_new_name_map = {"OldModel": "NewModel"}
+
+schema = {
+    "type": "object",
+    "properties": {
+        "$ref": {"type": "string"},
+        "foo": {"$ref": "#/components/schemas/OldModel"}
+    }
+}
+
+result = _replace_refs(
+    schema=schema,
+    old_name_to_new_name_map=old_name_to_new_name_map,
+)
+
+print(f"Result: {result}")
+
+expected_ref = REF_TEMPLATE.format(model="NewModel")
+expected = {
+    "type": "object",
+    "properties": {
+        "$ref": {"type": "string"},
+        "foo": {"$ref": expected_ref}
+    }
+}
+
+assert result == expected, f"Expected {expected}, but got {result}"
+print("Test passed!")

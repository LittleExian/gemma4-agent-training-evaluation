@@ -0,0 +1,11 @@
+from markdown_it import MarkdownIt
+
+md_text = """
+| Left | Center | Right |
+| :--- | :---: | ---: |
+| L1 | C1 | R1 |
+"""
+
+md = MarkdownIt().parse(md_text)
+for token in md:
+    print(f"Token: {token.type}, attrs: {token.attrs}")

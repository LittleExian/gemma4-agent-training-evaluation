+++ b/repro.py
@@ -0,0 +1,14 @@
+from rich.console import Console
+from rich.markdown import Markdown
+
+md_text = """
+| Left | Center | Right |
+| :--- | :---: | ---: |
+| L1111 | C1 | R1111 |
+| L1 | C1111 | R1 |
+"""
+
+console = Console(record=True)
+console.print(Markdown(md_text))
+output = console.export_text()
+print(output)

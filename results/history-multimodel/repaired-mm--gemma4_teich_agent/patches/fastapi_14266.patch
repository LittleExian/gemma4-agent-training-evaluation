+
+app = FastAPI(dependencies=[Depends(HTTPBearer())])
+
+@app.get("/")
+def read_root():
+    return {"Hello": "World"}
+
+openapi_schema = get_openapi(
+    title="test",
+    version="0.1.0",
+    routes=app.routes,
+    dependencies=app.dependencies,
+)
+
+import json
+print(json.dumps(openapi_schema, indent=2))

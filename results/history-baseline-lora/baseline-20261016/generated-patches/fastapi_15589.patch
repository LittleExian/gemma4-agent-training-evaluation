diff --git a/repro.py b/repro.py
new file mode 100644
index 000000000..a7e33aaa2
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,45 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_header(my_header: str = Header(None)):
+    return {"my_header": my_header}
+
+client = TestClient(app)
+
+def test_underscore_header():
+    # Default convert_underscores=True
+    # Should only accept 'my-header'
+    response = client.get("/", headers={"my_header": "value1"})
+    print(f"Response with my_header: {response.json()}")
+    assert response.json()["my_header"] is None
+
+    response = client.get("/", headers={"my-header": "value2"})
+    print(f"Response with my-header: {response.json()}")
+    assert response.json()["my_header"] == "value2"
+
+def test_underscore_header_disabled():
+    # Explicitly set convert_underscores=False
+    # Should accept 'my_header'
+    @app.get("/disabled")
+    async def read_header_disabled(my_header: str = Header(None, convert_underscores=False)):
+        return {"my_header": my_header}
+    
+    response = client.get("/disabled", headers={"my_header": "value3"})
+    print(f"Response with my_header (disabled): {response.json()}")
+    assert response.json()["my_header"] == "value3"
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header()
+        print("test_underscore_header passed")
+    except Exception as e:
+        print(f"test_underscore_header failed: {e}")
+
+    try:
+        test_underscore_header_disabled()
+        print("test_underscore_header_disabled passed")
+    except Exception as e:
+        print(f"test_underscore_header_disabled failed: {e}")

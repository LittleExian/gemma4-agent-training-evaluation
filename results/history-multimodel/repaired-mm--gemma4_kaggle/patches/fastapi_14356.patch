+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Extra
+
+class MyModel(BaseModel):
+    param: str
+    class Config:
+        extra = Extra.allow
+
+app = FastAPI()
+
+@app.get("/")
+async def read_root(params: MyModel = Header()):
+    return params
+
+client = TestClient(app)
+
+def test_extra_headers_multiple_values():
+    # param is defined, param2 is extra
+    # param2 has multiple values: 456 and 789
+    response = client.get("/", headers={"param": "123", "param2": ["456", "789"]})
+    print(f"Response: {response.json()}")
+    assert response.json() == {"param": "123", "param2": ["456", "789"]}
+
+if __name__ == "__main__":
+    try:
+        test_extra_headers_multiple_values()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed!")
+        raise e

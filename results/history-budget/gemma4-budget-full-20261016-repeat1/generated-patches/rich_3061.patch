@@ -0,0 +1,59 @@
+from rich.text import Text
+from rich.console import Console
+from rich.segment import Segment
+
+def test_expand_tabs_styles():
+    console = Console(force_terminal=True, width=20)
+    
+    # Case 1: Tab with base style
+    text = Text("A\tB", style="red")
+    text.expand_tabs(tab_size=8)
+    # "A" (1) + "       " (7) + "B" (1) = 9 chars
+    # All should be red
+    assert text.plain == "A       B"
+    # Check if the spaces are red. 
+    # The base style is red, so they should be.
+    
+    # Case 2: Tab within a span
+    text = Text("A\tB")
+    text.append("red", style="red") # This is not how append works, append(text, style)
+    
+    # Let's use a better way to create spans
+    text = Text("A\tB")
+    text.stylize("red", 0, 2) # "A\t" is red
+    # Index 0: A, Index 1: \t
+    
+    text.expand_tabs(tab_size=8)
+    # "A" (0) + "       " (1-7) + "B" (8)
+    # The tab was at index 1. It should be red.
+    # The expanded spaces should also be red.
+    
+    # We can check the spans of the resulting text.
+    # Original spans: Span(0, 2, 'red')
+    # After expand_tabs:
+    # "A" is at 0.
+    # Tab was at 1, replaced by " ".
+    # Additional 7 spaces added.
+    # So indices 0 to 7 should be red.
+    
+    # Let's print the spans to see.
+    print(f"Spans: {text._spans}")
+    
+    # Expected: Span(0, 8, 'red')
+    # Wait, the tab was at index 1. The span was (0, 2).
+    # The space that replaced the tab is at index 1.
+    # The additional spaces are at 2, 3, 4, 5, 6, 7.
+    # So the span should be (0, 8).
+    
+    for span in text._spans:
+        if span.style == "red":
+            assert span.start == 0
+            assert span.end == 8
+            print("Case 2 passed!")
+            return
+
+    print("Case 2 failed!")
+    exit(1)
+
+if __name__ == "__main__":
+    test_expand_tabs_styles()
